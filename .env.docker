# Docker BuildKit 优化配置
# 提升 Docker 构建性能

# 启用 BuildKit（在环境变量中设置）
export DOCKER_BUILDKIT=1
export COMPOSE_DOCKER_CLI_BUILD=1

# BuildKit 配置文件
# ~/.docker/buildx/build-config.toml

[registry."docker.io"]
  mirrors = ["https://registry.docker-cn.com"]

[worker.oci]
  max-parallelism = 4
  
[worker.containerd]
  max-parallelism = 4

# Go 代理配置
export GOPROXY=https://goproxy.cn,https://goproxy.io,direct
export GOSUMDB=sum.golang.google.cn
export GONOPROXY=
export GONOSUMDB=
export GOPRIVATE=
