package models

import (
	"time"
)

// DocumentRegistry 文档注册表模型 - 基于文件系统的轻量级文档管理
type DocumentRegistry struct {
	ID           int        `json:"id" db:"id"`
	FilePath     string     `json:"file_path" db:"file_path" validate:"required"`
	Filename     string     `json:"filename" db:"filename" validate:"required"`
	Category     string     `json:"category" db:"category" validate:"required"`
	Title        *string    `json:"title" db:"title"`
	Description  *string    `json:"description" db:"description"`
	FileSize     int        `json:"file_size" db:"file_size"`
	ContentHash  string     `json:"content_hash" db:"content_hash"`
	LastModified time.Time  `json:"last_modified" db:"last_modified"`
	IsActive     bool       `json:"is_active" db:"is_active"`
	QualityScore int        `json:"quality_score" db:"quality_score"`
	Technologies []string   `json:"technologies" db:"technologies"`
	Keywords     []string   `json:"keywords" db:"keywords"`
	CreatedBy    int        `json:"created_by" db:"created_by"`
	CreatedAt    time.Time  `json:"created_at" db:"created_at"`
	UpdatedAt    time.Time  `json:"updated_at" db:"updated_at"`
}

// CreateDocumentRegistryRequest 创建文档注册请求
type CreateDocumentRegistryRequest struct {
	FilePath     string    `json:"file_path" validate:"required"`
	Filename     string    `json:"filename" validate:"required"`
	Category     string    `json:"category" validate:"required"`
	Title        string    `json:"title"`
	Description  string    `json:"description"`
	FileSize     int       `json:"file_size"`
	ContentHash  string    `json:"content_hash"`
	LastModified time.Time `json:"last_modified"`
	CreatedBy    int       `json:"created_by"`
}

// UpdateDocumentRegistryRequest 更新文档注册请求
type UpdateDocumentRegistryRequest struct {
	Title        *string    `json:"title"`
	Description  *string    `json:"description"`
	FileSize     int        `json:"file_size"`
	ContentHash  string     `json:"content_hash"`
	LastModified time.Time  `json:"last_modified"`
	IsActive     *bool      `json:"is_active"`
}

// DocumentContent 文档内容模型
type DocumentContent struct {
	ID           int       `json:"id"`
	FilePath     string    `json:"file_path"`
	Filename     string    `json:"filename"`
	Title        *string   `json:"title"`
	Category     string    `json:"category"`
	Content      string    `json:"content"`
	FileSize     int       `json:"file_size"`
	LastModified time.Time `json:"last_modified"`
	CreatedAt    time.Time `json:"created_at"`
	UpdatedAt    time.Time `json:"updated_at"`
}

// DocumentTaskAssociation 文档-任务关联模型
type DocumentTaskAssociation struct {
	ID              int     `json:"id" db:"id"`
	DocumentID      int     `json:"document_id" db:"document_id"`
	TaskID          int     `json:"task_id" db:"task_id"`
	AssociationType string  `json:"association_type" db:"association_type"`
	ConfidenceScore float64 `json:"confidence_score" db:"confidence_score"`
	Notes           *string `json:"notes" db:"notes"`
	CreatedBy       int     `json:"created_by" db:"created_by"`
	CreatedAt       time.Time `json:"created_at" db:"created_at"`
}

// CreateDocumentTaskAssociationRequest 创建文档-任务关联请求
type CreateDocumentTaskAssociationRequest struct {
	DocumentID      int     `json:"document_id" validate:"required"`
	TaskID          int     `json:"task_id" validate:"required"`
	AssociationType string  `json:"association_type" validate:"required"`
	ConfidenceScore float64 `json:"confidence_score"`
	Notes           string  `json:"notes"`
	CreatedBy       int     `json:"created_by"`
}

// DocumentInfo 文档信息（用于列表和搜索）
type DocumentInfo struct {
	ID              int       `json:"id"`
	FilePath        string    `json:"file_path"`
	Filename        string    `json:"filename"`
	Title           *string   `json:"title"`
	Category        string    `json:"category"`
	Description     *string   `json:"description"`
	FileSize        int       `json:"file_size"`
	LastModified    time.Time `json:"last_modified"`
	QualityScore    int       `json:"quality_score"`
	Technologies    []string  `json:"technologies"`
	Keywords        []string  `json:"keywords"`
	IsActive        bool      `json:"is_active"`
	CreatedAt       time.Time `json:"created_at"`
	
	// 关联信息
	AssociationType *string  `json:"association_type,omitempty"`
	ConfidenceScore *float64 `json:"confidence_score,omitempty"`
}

// DocumentFilters 文档搜索过滤器
type DocumentFilters struct {
	Category    *string `json:"category"`
	IsActive    *bool   `json:"is_active"`
	CreatedBy   *int    `json:"created_by"`
	Page        int     `json:"page"`
	Limit       int     `json:"limit"`
}

// DocumentScanResult 文档扫描结果
type DocumentScanResult struct {
	TotalScanned     int             `json:"total_scanned"`
	NewDocuments     int             `json:"new_documents"`
	UpdatedDocuments int             `json:"updated_documents"`
	Errors           []DocumentError `json:"errors"`
}

// DocumentError 文档处理错误
type DocumentError struct {
	FilePath string `json:"file_path"`
	Error    string `json:"error"`
}

// DocumentStatistics 文档统计信息
type DocumentStatistics struct {
	TotalDocuments       int                    `json:"total_documents"`
	ActiveDocuments      int                    `json:"active_documents"`
	InactiveDocuments    int                    `json:"inactive_documents"`
	DocumentsByCategory  map[string]int         `json:"documents_by_category"`
	TasksWithDocuments   int                    `json:"tasks_with_documents"`
	DocumentAssociations int                    `json:"document_associations"`
	AverageQualityScore  float64                `json:"average_quality_score"`
}

// DocumentCategory 文档分类模型
type DocumentCategory struct {
	ID           int       `json:"id" db:"id"`
	Name         string    `json:"name" db:"name"`
	DisplayName  string    `json:"display_name" db:"display_name"`
	Description  *string   `json:"description" db:"description"`
	DirectoryPath *string  `json:"directory_path" db:"directory_path"`
	Color        *string   `json:"color" db:"color"`
	Icon         *string   `json:"icon" db:"icon"`
	SortOrder    int       `json:"sort_order" db:"sort_order"`
	IsActive     bool      `json:"is_active" db:"is_active"`
	CreatedAt    time.Time `json:"created_at" db:"created_at"`
}

// TaskDocumentInfo 任务文档信息（用于任务详情页显示）
type TaskDocumentInfo struct {
	DocumentInfo
	AssociationType string  `json:"association_type"`
	ConfidenceScore float64 `json:"confidence_score"`
	Notes           *string `json:"notes"`
}

// AssociateDocumentRequest 关联文档请求
type AssociateDocumentRequest struct {
	FilePath        string  `json:"file_path" validate:"required"`
	TaskID          int     `json:"task_id" validate:"required"`
	AssociationType string  `json:"association_type"`
	ConfidenceScore float64 `json:"confidence_score"`
	Notes           string  `json:"notes"`
}

// BatchAssociateDocumentsRequest 批量关联文档请求
type BatchAssociateDocumentsRequest struct {
	TaskID       int                        `json:"task_id" validate:"required"`
	Associations []AssociateDocumentRequest `json:"associations" validate:"required"`
}

// DocumentSearchResult 文档搜索结果
type DocumentSearchResult struct {
	Documents   []DocumentInfo `json:"documents"`
	TotalCount  int            `json:"total_count"`
	Page        int            `json:"page"`
	Limit       int            `json:"limit"`
	HasNextPage bool           `json:"has_next_page"`
	HasPrevPage bool           `json:"has_prev_page"`
}

// 关联类型常量
const (
	AssociationTypePrimary    = "primary"    // 主要文档
	AssociationTypeReference  = "reference"  // 参考文档
	AssociationTypeOutput     = "output"     // 输出文档
	AssociationTypeDependency = "dependency" // 依赖文档
	AssociationTypeRelated    = "related"    // 相关文档
)

// 文档分类常量
const (
	CategoryTasks          = "tasks"
	CategoryDesigns        = "designs"
	CategoryGuides         = "guides"
	CategoryApis           = "apis"
	CategoryDevelopment    = "development"
	CategoryConfigurations = "configurations"
	CategoryTemplates      = "templates"
	CategoryArchived       = "archived"
)

// 验证方法

// IsValidAssociationType 验证关联类型
func IsValidAssociationType(associationType string) bool {
	validTypes := []string{
		AssociationTypePrimary,
		AssociationTypeReference,
		AssociationTypeOutput,
		AssociationTypeDependency,
		AssociationTypeRelated,
	}
	
	for _, validType := range validTypes {
		if associationType == validType {
			return true
		}
	}
	return false
}

// IsValidCategory 验证文档分类
func IsValidCategory(category string) bool {
	validCategories := []string{
		CategoryTasks,
		CategoryDesigns,
		CategoryGuides,
		CategoryApis,
		CategoryDevelopment,
		CategoryConfigurations,
		CategoryTemplates,
		CategoryArchived,
	}
	
	for _, validCategory := range validCategories {
		if category == validCategory {
			return true
		}
	}
	return false
}

// ToTaskDocumentInfo 转换为任务文档信息
func (di *DocumentInfo) ToTaskDocumentInfo() TaskDocumentInfo {
	return TaskDocumentInfo{
		DocumentInfo:    *di,
		AssociationType: *di.AssociationType,
		ConfidenceScore: *di.ConfidenceScore,
	}
}