package application

import (
	"ai-project-backend/middleware"
	"ai-project-backend/security"
	"context"
	"log"
	"time"

	"github.com/go-redis/redis/v8"
)

// initializePermissionFramework 初始化权限验证框架
func (app *Application) initializePermissionFramework() error {
	log.Printf("[APPLICATION] Initializing permission framework...")
	
	// 获取必要的仓库
	permissionRepo := app.handlers.GetPermissionRepo()
	auditRepo := app.handlers.GetAuditRepo()
	
	if permissionRepo == nil {
		log.Printf("[APPLICATION] Warning: Permission repository not available")
		return nil // 不阻止应用启动，但权限框架不可用
	}
	
	// 初始化Redis客户端（用于缓存）
	var redisClient *redis.Client
	if app.config.Redis != nil && app.config.Redis.Enabled {
		redisClient = redis.NewClient(&redis.Options{
			Addr:     app.config.Redis.Address,
			Password: app.config.Redis.Password,
			DB:       app.config.Redis.Database,
		})
		
		// 测试Redis连接
		ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
		defer cancel()
		
		if err := redisClient.Ping(ctx).Err(); err != nil {
			log.Printf("[APPLICATION] Warning: Redis connection failed: %v", err)
			redisClient = nil // 继续运行但不使用缓存
		} else {
			log.Printf("[APPLICATION] Redis connected successfully")
		}
	}
	
	// 初始化速率限制器
	rateLimiter := security.NewRateLimiter()
	
	// 初始化权限框架
	err := middleware.InitializePermissionFramework(
		permissionRepo,
		redisClient,
		auditRepo,
		rateLimiter,
	)
	
	if err != nil {
		log.Printf("[APPLICATION] Warning: Failed to initialize permission framework: %v", err)
		log.Printf("[APPLICATION] Application will continue with basic permission middleware")
		return nil // 不阻止应用启动
	}
	
	log.Printf("[APPLICATION] Permission framework initialized successfully")
	
	// 记录框架状态
	middleware.LogPermissionFrameworkStatus()
	
	return nil
}

// closePermissionFramework 关闭权限验证框架
func (app *Application) closePermissionFramework() error {
	if middleware.IsFrameworkInitialized() {
		log.Printf("[APPLICATION] Closing permission framework...")
		return middleware.ClosePermissionFramework()
	}
	return nil
}

