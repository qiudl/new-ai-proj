# 种子数据配置文件
# 文件: seed_config.env
# 描述: 种子数据执行器的配置参数
# 作者: Claude AI (任务#365)
# 更新时间: 2025-08-27

# =============================================================================
# 数据库连接配置
# =============================================================================

# 数据库主机地址
DB_HOST=localhost

# 数据库端口 (Docker映射端口)
DB_PORT=5433

# 数据库名称
DB_NAME=ai_project_db

# 数据库用户
DB_USER=dev_user

# 数据库密码
DB_PASSWORD=dev_password_2024

# =============================================================================
# 应用环境配置
# =============================================================================

# 应用环境 (development|staging|production)
APP_ENV=development

# 调试模式
DEBUG=true

# 强制执行模式（跳过确认）
FORCE=false

# 清理模式
CLEANUP=false

# 清理后重建基础数据
RECREATE=false

# =============================================================================
# 脚本执行配置  
# =============================================================================

# 种子脚本目录
SEED_DIR=./seed

# 超时设置(秒)
SCRIPT_TIMEOUT=300

# 日志级别 (debug|info|warn|error)
LOG_LEVEL=info

# 是否记录执行历史
LOG_EXECUTION=true

# =============================================================================
# 环境特定配置
# =============================================================================

# 开发环境特定设置
DEV_SAMPLE_DATA=true
DEV_TEST_USERS=true
DEV_DEMO_PROJECTS=true

# 生产环境特定设置
PROD_CONFIRM_REQUIRED=true
PROD_BACKUP_BEFORE_SEED=true

# 暂存环境特定设置
STAGING_LIMITED_DATA=true

# =============================================================================
# 高级选项
# =============================================================================

# 并行执行（实验性功能）
PARALLEL_EXECUTION=false

# 最大重试次数
MAX_RETRIES=3

# 重试间隔(秒)
RETRY_DELAY=5

# 事务模式 (single|per_script|manual)
TRANSACTION_MODE=per_script

# 错误处理策略 (stop|continue|skip)
ERROR_STRATEGY=stop

# 验证模式（执行前验证脚本语法）
VALIDATE_SCRIPTS=true

# =============================================================================
# 监控和报告
# =============================================================================

# 生成执行报告
GENERATE_REPORT=true

# 报告格式 (json|yaml|txt)
REPORT_FORMAT=json

# 报告输出目录
REPORT_DIR=./logs

# 发送执行通知
SEND_NOTIFICATIONS=false

# 通知接收邮箱
NOTIFICATION_EMAIL=

# Slack通知Webhook
SLACK_WEBHOOK_URL=

# =============================================================================
# 性能优化
# =============================================================================

# 连接池大小
DB_POOL_SIZE=10

# 连接超时(秒)
DB_CONNECT_TIMEOUT=30

# 查询超时(秒)  
DB_QUERY_TIMEOUT=60

# 批处理大小
BATCH_SIZE=1000

# 启用查询缓存
ENABLE_QUERY_CACHE=false