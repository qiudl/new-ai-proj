# 种子数据配置文件
# 文件: seed_config.env
# 描述: 种子数据执行器配置参数
# 作者: Claude AI (任务#621)
# 创建时间: 2025-08-27

# =============================================================================
# 数据库连接配置
# =============================================================================

# 数据库主机地址
DB_HOST=localhost

# 数据库端口
DB_PORT=5433

# 数据库名称
DB_NAME=ai_project_db

# 数据库用户名
DB_USER=dev_user

# 数据库密码（建议通过环境变量传入，避免在文件中明文存储）
# DB_PASSWORD=dev_password_2024

# =============================================================================
# 应用环境配置
# =============================================================================

# 应用环境 (development|staging|production)
APP_ENV=development

# 调试模式
DEBUG=false

# 强制执行（跳过确认提示）
FORCE=false

# =============================================================================
# 种子数据脚本配置
# =============================================================================

# 脚本执行顺序配置
# 生产环境脚本
PRODUCTION_SCRIPTS="001_basic_seed_data.sql"

# 预发布环境脚本
STAGING_SCRIPTS="001_basic_seed_data.sql,003_demo_data.sql"

# 开发环境脚本
DEVELOPMENT_SCRIPTS="001_basic_seed_data.sql,002_dev_test_data.sql,003_demo_data.sql"

# =============================================================================
# 清理配置
# =============================================================================

# 清理确认（需要显式设置为true才能执行清理）
CLEANUP_CONFIRM=false

# 清理后重建基础数据
RECREATE_BASIC=false

# =============================================================================
# 执行策略配置
# =============================================================================

# 脚本超时时间（秒）
SCRIPT_TIMEOUT=300

# 出错时是否停止
STOP_ON_ERROR=true

# 是否记录详细日志
VERBOSE_LOGGING=false

# =============================================================================
# 环境特定配置
# =============================================================================

# 开发环境特定配置
DEV_CREATE_DEMO_USERS=true
DEV_CREATE_TEST_PROJECTS=true
DEV_CREATE_SAMPLE_TASKS=true
DEV_CREATE_TIME_LOGS=true

# 生产环境特定配置
PROD_CREATE_ADMIN_ONLY=true
PROD_SKIP_DEMO_DATA=true

# 演示环境特定配置
DEMO_FULL_DATASET=true
DEMO_REALISTIC_DATA=true

# =============================================================================
# 安全配置
# =============================================================================

# 生产环境确认短语（必须输入才能在生产环境执行）
PROD_CONFIRM_PHRASE="CONFIRM-PRODUCTION"

# 允许的环境列表
ALLOWED_ENVIRONMENTS="development,staging,production"

# 禁止的操作（在某些环境中）
PROD_FORBIDDEN_OPERATIONS="cleanup,dev_test_data"

# =============================================================================
# 日志配置
# =============================================================================

# 日志输出目录
LOG_DIR="./logs"

# 日志文件名格式
LOG_FILE_FORMAT="seed_execution_%Y%m%d_%H%M%S.log"

# 是否启用日志文件
ENABLE_LOG_FILE=true

# 日志保留天数
LOG_RETENTION_DAYS=30

# =============================================================================
# 通知配置（可选）
# =============================================================================

# 是否启用执行通知
ENABLE_NOTIFICATIONS=false

# 通知方式 (email|slack|webhook)
NOTIFICATION_METHOD=email

# 通知邮箱（用于执行结果通知）
NOTIFICATION_EMAIL=""

# Slack Webhook URL（可选）
SLACK_WEBHOOK_URL=""

# =============================================================================
# 性能配置
# =============================================================================

# 批量操作大小
BATCH_SIZE=1000

# 并行执行数
PARALLEL_JOBS=1

# 内存限制（MB）
MEMORY_LIMIT=512

# =============================================================================
# 验证配置
# =============================================================================

# 执行前验证数据库连接
PRE_VALIDATE_CONNECTION=true

# 执行后验证数据完整性
POST_VALIDATE_DATA=true

# 验证超时时间（秒）
VALIDATION_TIMEOUT=60

# =============================================================================
# 备份配置
# =============================================================================

# 执行前是否创建备份
CREATE_BACKUP_BEFORE=false

# 备份存储目录
BACKUP_DIR="./backups"

# 备份文件名格式
BACKUP_FILE_FORMAT="seed_backup_%Y%m%d_%H%M%S.sql"

# 备份保留天数
BACKUP_RETENTION_DAYS=7

# =============================================================================
# 使用说明
# =============================================================================

# 此配置文件可以通过以下方式使用：
# 1. 直接在脚本中source该文件: source seed_config.env
# 2. 通过环境变量覆盖配置: export DB_PASSWORD=your_password
# 3. 在命令行中指定参数: ./seed_runner.sh --env development --force
# 
# 优先级：命令行参数 > 环境变量 > 配置文件
# 
# 安全提示：
# - 不要在此文件中存储敏感信息（如密码）
# - 敏感配置应通过环境变量传入
# - 生产环境配置应单独管理
