package handlers

import (
	"context"
	"net/http"
	"strconv"

	"ai-project-backend/database"
	"ai-project-backend/models"
	"github.com/gin-gonic/gin"
)

// DatabaseDocumentFolderHandler 连接数据库的文档文件夹处理器
type DatabaseDocumentFolderHandler struct {
	db database.DB
}

// NewDatabaseDocumentFolderHandler 创建新的数据库文档文件夹处理器
func NewDatabaseDocumentFolderHandler(db database.DB) *DatabaseDocumentFolderHandler {
	return &DatabaseDocumentFolderHandler{
		db: db,
	}
}

// GetFolderTree 获取文件夹树
func (h *DatabaseDocumentFolderHandler) GetFolderTree(c *gin.Context) {
	ctx := context.Background()
	
	// 获取用户ID
	userID, exists := c.Get("user_id")
	if !exists {
		c.JSON(http.StatusUnauthorized, gin.H{
			"success": false,
			"message": "Unauthorized",
		})
		return
	}

	// 获取可见性参数，默认为所有
	visibility := c.DefaultQuery("visibility", "")

	response, err := h.db.DocumentFolders().GetTree(ctx, userID.(int), visibility)
	if err != nil {
		c.JSON(http.StatusInternalServerError, gin.H{
			"success": false,
			"message": "Failed to get folder tree",
			"error":   err.Error(),
		})
		return
	}

	c.JSON(http.StatusOK, gin.H{
		"success": true,
		"message": "Folder tree retrieved successfully",
		"data":    response.Tree,
	})
}

// ListFolders 获取文件夹列表
func (h *DatabaseDocumentFolderHandler) ListFolders(c *gin.Context) {
	ctx := context.Background()
	
	// 获取用户ID
	userID, exists := c.Get("user_id")
	if !exists {
		c.JSON(http.StatusUnauthorized, gin.H{
			"success": false,
			"message": "Unauthorized",
		})
		return
	}

	// 构建请求参数
	req := &models.ListFoldersRequest{
		Page:       1,
		Limit:      100,
		Visibility: c.Query("visibility"),
		Search:     c.Query("search"),
	}

	if pageStr := c.Query("page"); pageStr != "" {
		if page, err := strconv.Atoi(pageStr); err == nil && page > 0 {
			req.Page = page
		}
	}

	if limitStr := c.Query("limit"); limitStr != "" {
		if limit, err := strconv.Atoi(limitStr); err == nil && limit > 0 && limit <= 200 {
			req.Limit = limit
		}
	}

	response, err := h.db.DocumentFolders().List(ctx, req, userID.(int))
	if err != nil {
		c.JSON(http.StatusInternalServerError, gin.H{
			"success": false,
			"message": "Failed to get folders",
			"error":   err.Error(),
		})
		return
	}

	c.JSON(http.StatusOK, gin.H{
		"success": true,
		"message": "Folders retrieved successfully",
		"data":    response.Folders,
		"total":   response.Total,
		"page":    response.Page,
		"limit":   response.Limit,
	})
}

// CreateFolder 创建文件夹
func (h *DatabaseDocumentFolderHandler) CreateFolder(c *gin.Context) {
	ctx := context.Background()
	
	var req models.CreateDocumentFolderRequest
	if err := c.ShouldBindJSON(&req); err != nil {
		c.JSON(http.StatusBadRequest, gin.H{
			"success": false,
			"message": "Invalid request format",
			"error":   err.Error(),
		})
		return
	}

	// 获取用户ID
	userID, exists := c.Get("user_id")
	if !exists {
		c.JSON(http.StatusUnauthorized, gin.H{
			"success": false,
			"message": "Unauthorized",
		})
		return
	}

	// 设置默认值
	if req.Visibility == "" {
		req.Visibility = models.VisibilityTeam
	}
	if req.Color == nil {
		defaultColor := "#1890ff"
		req.Color = &defaultColor
	}
	if req.Icon == nil {
		defaultIcon := "folder"
		req.Icon = &defaultIcon
	}

	createdFolder, err := h.db.DocumentFolders().Create(ctx, &req, userID.(int))
	if err != nil {
		c.JSON(http.StatusInternalServerError, gin.H{
			"success": false,
			"message": "Failed to create folder",
			"error":   err.Error(),
		})
		return
	}

	c.JSON(http.StatusCreated, gin.H{
		"success": true,
		"message": "Folder created successfully",
		"data":    createdFolder,
	})
}

// GetFolder 获取单个文件夹
func (h *DatabaseDocumentFolderHandler) GetFolder(c *gin.Context) {
	ctx := context.Background()
	
	idStr := c.Param("id")
	id, err := strconv.Atoi(idStr)
	if err != nil {
		c.JSON(http.StatusBadRequest, gin.H{
			"success": false,
			"message": "Invalid folder ID",
		})
		return
	}

	folder, err := h.db.DocumentFolders().GetByID(ctx, id)
	if err != nil {
		c.JSON(http.StatusNotFound, gin.H{
			"success": false,
			"message": "Folder not found",
		})
		return
	}

	c.JSON(http.StatusOK, gin.H{
		"success": true,
		"message": "Folder retrieved successfully",
		"data":    folder,
	})
}

// UpdateFolder 更新文件夹
func (h *DatabaseDocumentFolderHandler) UpdateFolder(c *gin.Context) {
	ctx := context.Background()
	
	idStr := c.Param("id")
	id, err := strconv.Atoi(idStr)
	if err != nil {
		c.JSON(http.StatusBadRequest, gin.H{
			"success": false,
			"message": "Invalid folder ID",
		})
		return
	}

	var req models.UpdateDocumentFolderRequest
	if err := c.ShouldBindJSON(&req); err != nil {
		c.JSON(http.StatusBadRequest, gin.H{
			"success": false,
			"message": "Invalid request format",
			"error":   err.Error(),
		})
		return
	}

	// 获取用户ID
	userID, exists := c.Get("user_id")
	if !exists {
		c.JSON(http.StatusUnauthorized, gin.H{
			"success": false,
			"message": "Unauthorized",
		})
		return
	}

	updatedFolder, err := h.db.DocumentFolders().Update(ctx, id, &req, userID.(int))
	if err != nil {
		c.JSON(http.StatusInternalServerError, gin.H{
			"success": false,
			"message": "Failed to update folder",
			"error":   err.Error(),
		})
		return
	}

	c.JSON(http.StatusOK, gin.H{
		"success": true,
		"message": "Folder updated successfully",
		"data":    updatedFolder,
	})
}

// DeleteFolder 删除文件夹
func (h *DatabaseDocumentFolderHandler) DeleteFolder(c *gin.Context) {
	ctx := context.Background()
	
	idStr := c.Param("id")
	id, err := strconv.Atoi(idStr)
	if err != nil {
		c.JSON(http.StatusBadRequest, gin.H{
			"success": false,
			"message": "Invalid folder ID",
		})
		return
	}

	// 获取用户ID
	userID, exists := c.Get("user_id")
	if !exists {
		c.JSON(http.StatusUnauthorized, gin.H{
			"success": false,
			"message": "Unauthorized",
		})
		return
	}

	err = h.db.DocumentFolders().Delete(ctx, id, userID.(int))
	if err != nil {
		c.JSON(http.StatusInternalServerError, gin.H{
			"success": false,
			"message": "Failed to delete folder",
			"error":   err.Error(),
		})
		return
	}

	c.JSON(http.StatusOK, gin.H{
		"success": true,
		"message": "Folder deleted successfully",
	})
}

