// BatchUpdateFolders 批量更新文件夹
func (h *DatabaseDocumentFolderHandler) BatchUpdateFolders(c *gin.Context) {
	ctx := context.Background()
	
	var req models.BatchUpdateFoldersRequest
	if err := c.ShouldBindJSON(&req); err != nil {
		c.JSON(http.StatusBadRequest, gin.H{
			"success": false,
			"message": "Invalid request format",
			"error":   err.Error(),
		})
		return
	}

	// 获取用户ID
	userID, exists := c.Get("user_id")
	if !exists {
		c.JSON(http.StatusUnauthorized, gin.H{
			"success": false,
			"message": "Unauthorized",
		})
		return
	}

	// 批量更新文件夹 (简化实现)
	for _, folderUpdate := range req.Folders {
		updateReq := &models.UpdateDocumentFolderRequest{
			SortOrder: &folderUpdate.SortOrder,
		}
		if folderUpdate.ParentFolderID != nil {
			updateReq.ParentFolderID = folderUpdate.ParentFolderID
		}
		
		_, err := h.db.DocumentFolders().Update(ctx, folderUpdate.ID, updateReq, userID.(int))
		if err != nil {
			c.JSON(http.StatusInternalServerError, gin.H{
				"success": false,
				"message": "Failed to batch update folders",
				"error":   err.Error(),
			})
			return
		}
	}

	c.JSON(http.StatusOK, gin.H{
		"success": true,
		"message": "Folders updated successfully",
	})
}