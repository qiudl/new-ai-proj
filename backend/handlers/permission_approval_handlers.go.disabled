// GetUserDelegations retrieves delegations for a user
func (h *PermissionApprovalHandler) GetUserDelegations(w http.ResponseWriter, r *http.Request) {
	userID, ok := getUserIDFromContext(r)
	if !ok {
		http.Error(w, "User not authenticated", http.StatusUnauthorized)
		return
	}

	limit := parseIntQueryWithDefault(r, "limit", 20)
	offset := parseIntQueryWithDefault(r, "offset", 0)
	includeExpired := r.URL.Query().Get("include_expired") == "true"

	response, err := h.approvalService.GetUserDelegations(r.Context(), userID, includeExpired, limit, offset)
	if err != nil {
		h.logger.Printf("Error getting user delegations: %v", err)
		http.Error(w, fmt.Sprintf("Failed to get user delegations: %v", err), http.StatusInternalServerError)
		return
	}

	w.Header().Set("Content-Type", "application/json")
	json.NewEncoder(w).Encode(response)
}

// UpdateDelegation updates a delegation
func (h *PermissionApprovalHandler) UpdateDelegation(w http.ResponseWriter, r *http.Request) {
	vars := mux.Vars(r)
	delegationIDStr := vars["id"]
	if delegationIDStr == "" {
		http.Error(w, "Delegation ID is required", http.StatusBadRequest)
		return
	}

	delegationID, err := strconv.Atoi(delegationIDStr)
	if err != nil {
		http.Error(w, "Invalid delegation ID", http.StatusBadRequest)
		return
	}

	var req models.UpdateDelegationRequest
	if err := json.NewDecoder(r.Body).Decode(&req); err != nil {
		h.logger.Printf("Error decoding request body: %v", err)
		http.Error(w, "Invalid request body", http.StatusBadRequest)
		return
	}

	userID, ok := getUserIDFromContext(r)
	if !ok {
		http.Error(w, "User not authenticated", http.StatusUnauthorized)
		return
	}

	response, err := h.approvalService.UpdateDelegation(r.Context(), delegationID, &req, userID)
	if err != nil {
		if err.Error() == "delegation not found" {
			http.Error(w, "Delegation not found", http.StatusNotFound)
			return
		}
		if err.Error() == "user not authorized to update this delegation" {
			http.Error(w, "Not authorized to update this delegation", http.StatusForbidden)
			return
		}
		h.logger.Printf("Error updating delegation: %v", err)
		http.Error(w, fmt.Sprintf("Failed to update delegation: %v", err), http.StatusInternalServerError)
		return
	}

	w.Header().Set("Content-Type", "application/json")
	json.NewEncoder(w).Encode(response)
}

// GetApprovalStats retrieves approval statistics
func (h *PermissionApprovalHandler) GetApprovalStats(w http.ResponseWriter, r *http.Request) {
	userID, ok := getUserIDFromContext(r)
	if !ok {
		http.Error(w, "User not authenticated", http.StatusUnauthorized)
		return
	}

	// Parse query parameters for stats filter
	filter := &models.ApprovalStatsFilter{
		UserID:    &userID,
		StartDate: r.URL.Query().Get("start_date"),
		EndDate:   r.URL.Query().Get("end_date"),
		GroupBy:   r.URL.Query().Get("group_by"), // "status", "priority", "permission", etc.
	}

	if requesterID := parseIntQuery(r, "requester_id"); requesterID != nil {
		filter.RequesterID = requesterID
	}
	if approverID := parseIntQuery(r, "approver_id"); approverID != nil {
		filter.ApproverID = approverID
	}

	response, err := h.approvalService.GetApprovalStats(r.Context(), filter, userID)
	if err != nil {
		h.logger.Printf("Error getting approval stats: %v", err)
		http.Error(w, fmt.Sprintf("Failed to get approval stats: %v", err), http.StatusInternalServerError)
		return
	}

	w.Header().Set("Content-Type", "application/json")
	json.NewEncoder(w).Encode(response)
}

// Utility functions

func getUserIDFromContext(r *http.Request) (int, bool) {
	// This would typically be set by authentication middleware
	// For now, return a placeholder implementation
	userIDValue := r.Context().Value("user_id")
	if userIDValue == nil {
		return 0, false
	}

	userID, ok := userIDValue.(int)
	return userID, ok
}

func parseIntQuery(r *http.Request, param string) *int {
	value := r.URL.Query().Get(param)
	if value == "" {
		return nil
	}
	if intValue, err := strconv.Atoi(value); err == nil {
		return &intValue
	}
	return nil
}

func parseIntQueryWithDefault(r *http.Request, param string, defaultValue int) int {
	value := r.URL.Query().Get(param)
	if value == "" {
		return defaultValue
	}
	if intValue, err := strconv.Atoi(value); err == nil {
		return intValue
	}
	return defaultValue
}