package handlers

import (
	"ai-project-backend/models"
	"ai-project-backend/services"
	"encoding/json"
	"fmt"
	"log"
	"net/http"
	"strconv"

	"github.com/gin-gonic/gin"
)

// PermissionApprovalHandler handles permission approval HTTP requests
type PermissionApprovalHandler struct {
	approvalService *services.PermissionApprovalService
	logger          *log.Logger
}

// NewPermissionApprovalHandler creates a new permission approval handler
func NewPermissionApprovalHandler(approvalService *services.PermissionApprovalService, logger *log.Logger) *PermissionApprovalHandler {
	return &PermissionApprovalHandler{
		approvalService: approvalService,
		logger:          logger,
	}
}

// CreateApprovalRequest creates a new permission approval request
func (h *PermissionApprovalHandler) CreateApprovalRequest(w http.ResponseWriter, r *http.Request) {
	var req models.CreateApprovalRequestRequest
	if err := json.NewDecoder(r.Body).Decode(&req); err != nil {
		h.logger.Printf("Error decoding request body: %v", err)
		http.Error(w, "Invalid request body", http.StatusBadRequest)
		return
	}

	// Get user ID from context (assumed to be set by middleware)
	userID, ok := getUserIDFromContext(r)
	if !ok {
		http.Error(w, "User not authenticated", http.StatusUnauthorized)
		return
	}

	response, err := h.approvalService.CreateApprovalRequest(r.Context(), &req, userID)
	if err != nil {
		h.logger.Printf("Error creating approval request: %v", err)
		http.Error(w, fmt.Sprintf("Failed to create approval request: %v", err), http.StatusInternalServerError)
		return
	}

	w.Header().Set("Content-Type", "application/json")
	w.WriteHeader(http.StatusCreated)
	json.NewEncoder(w).Encode(response)
}

// GetApprovalRequest retrieves a specific approval request
func (h *PermissionApprovalHandler) GetApprovalRequest(w http.ResponseWriter, r *http.Request) {
	vars := mux.Vars(r)
	requestID := vars["id"]
	if requestID == "" {
		http.Error(w, "Request ID is required", http.StatusBadRequest)
		return
	}

	userID, ok := getUserIDFromContext(r)
	if !ok {
		http.Error(w, "User not authenticated", http.StatusUnauthorized)
		return
	}

	response, err := h.approvalService.GetApprovalRequest(r.Context(), requestID, userID)
	if err != nil {
		if err.Error() == "approval request not found" {
			http.Error(w, "Approval request not found", http.StatusNotFound)
			return
		}
		h.logger.Printf("Error getting approval request: %v", err)
		http.Error(w, fmt.Sprintf("Failed to get approval request: %v", err), http.StatusInternalServerError)
		return
	}

	w.Header().Set("Content-Type", "application/json")
	json.NewEncoder(w).Encode(response)
}

// ListApprovalRequests retrieves approval requests with filtering
func (h *PermissionApprovalHandler) ListApprovalRequests(w http.ResponseWriter, r *http.Request) {
	userID, ok := getUserIDFromContext(r)
	if !ok {
		http.Error(w, "User not authenticated", http.StatusUnauthorized)
		return
	}

	// Parse query parameters
	filter := &models.ApprovalRequestFilter{
		RequesterID: parseIntQuery(r, "requester_id"),
		ApproverID:  parseIntQuery(r, "approver_id"),
		Status:      r.URL.Query().Get("status"),
		Priority:    r.URL.Query().Get("priority"),
		Limit:       parseIntQueryWithDefault(r, "limit", 20),
		Offset:      parseIntQueryWithDefault(r, "offset", 0),
	}

	if permissionCode := r.URL.Query().Get("permission_code"); permissionCode != "" {
		filter.PermissionCode = &permissionCode
	}
	if resourceType := r.URL.Query().Get("resource_type"); resourceType != "" {
		filter.ResourceType = &resourceType
	}

	response, err := h.approvalService.ListApprovalRequests(r.Context(), filter, userID)
	if err != nil {
		h.logger.Printf("Error listing approval requests: %v", err)
		http.Error(w, fmt.Sprintf("Failed to list approval requests: %v", err), http.StatusInternalServerError)
		return
	}

	w.Header().Set("Content-Type", "application/json")
	json.NewEncoder(w).Encode(response)
}

// ProcessApprovalDecision processes an approval decision (approve/reject/delegate)
func (h *PermissionApprovalHandler) ProcessApprovalDecision(w http.ResponseWriter, r *http.Request) {
	vars := mux.Vars(r)
	requestID := vars["id"]
	if requestID == "" {
		http.Error(w, "Request ID is required", http.StatusBadRequest)
		return
	}

	var req models.ProcessApprovalDecisionRequest
	if err := json.NewDecoder(r.Body).Decode(&req); err != nil {
		h.logger.Printf("Error decoding request body: %v", err)
		http.Error(w, "Invalid request body", http.StatusBadRequest)
		return
	}

	userID, ok := getUserIDFromContext(r)
	if !ok {
		http.Error(w, "User not authenticated", http.StatusUnauthorized)
		return
	}

	response, err := h.approvalService.ProcessApprovalDecision(r.Context(), requestID, &req, userID)
	if err != nil {
		if err.Error() == "approval request not found" {
			http.Error(w, "Approval request not found", http.StatusNotFound)
			return
		}
		if err.Error() == "user not authorized to approve this request" {
			http.Error(w, "Not authorized to approve this request", http.StatusForbidden)
			return
		}
		h.logger.Printf("Error processing approval decision: %v", err)
		http.Error(w, fmt.Sprintf("Failed to process approval decision: %v", err), http.StatusInternalServerError)
		return
	}

	w.Header().Set("Content-Type", "application/json")
	json.NewEncoder(w).Encode(response)
}

// GetApprovalHistory retrieves the approval history for a request
func (h *PermissionApprovalHandler) GetApprovalHistory(w http.ResponseWriter, r *http.Request) {
	vars := mux.Vars(r)
	requestID := vars["id"]
	if requestID == "" {
		http.Error(w, "Request ID is required", http.StatusBadRequest)
		return
	}

	userID, ok := getUserIDFromContext(r)
	if !ok {
		http.Error(w, "User not authenticated", http.StatusUnauthorized)
		return
	}

	limit := parseIntQueryWithDefault(r, "limit", 50)
	offset := parseIntQueryWithDefault(r, "offset", 0)

	response, err := h.approvalService.GetApprovalHistory(r.Context(), requestID, userID, limit, offset)
	if err != nil {
		if err.Error() == "approval request not found" {
			http.Error(w, "Approval request not found", http.StatusNotFound)
			return
		}
		h.logger.Printf("Error getting approval history: %v", err)
		http.Error(w, fmt.Sprintf("Failed to get approval history: %v", err), http.StatusInternalServerError)
		return
	}

	w.Header().Set("Content-Type", "application/json")
	json.NewEncoder(w).Encode(response)
}

// GetPendingApprovals retrieves pending approvals for the current user
func (h *PermissionApprovalHandler) GetPendingApprovals(w http.ResponseWriter, r *http.Request) {
	userID, ok := getUserIDFromContext(r)
	if !ok {
		http.Error(w, "User not authenticated", http.StatusUnauthorized)
		return
	}

	limit := parseIntQueryWithDefault(r, "limit", 20)
	offset := parseIntQueryWithDefault(r, "offset", 0)
	priority := r.URL.Query().Get("priority")

	response, err := h.approvalService.GetPendingApprovals(r.Context(), userID, priority, limit, offset)
	if err != nil {
		h.logger.Printf("Error getting pending approvals: %v", err)
		http.Error(w, fmt.Sprintf("Failed to get pending approvals: %v", err), http.StatusInternalServerError)
		return
	}

	w.Header().Set("Content-Type", "application/json")
	json.NewEncoder(w).Encode(response)
}

// CreateDelegation creates a delegation for approval authority
