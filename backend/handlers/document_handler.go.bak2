
// CreateWorkNote 创建工作笔记
func (h *DocumentHandler) CreateWorkNote(c *gin.Context) {
	var request models.CreateWorkNoteRequest
	if err := c.ShouldBindJSON(&request); err != nil {
		c.JSON(http.StatusBadRequest, gin.H{
			"success": false,
			"error":   "Invalid request body: " + err.Error(),
		})
		return
	}

	// 获取用户信息
	userID := c.GetInt("user_id")
	if userID == 0 {
		c.JSON(http.StatusUnauthorized, gin.H{
			"success": false,
			"error":   "User not authenticated",
		})
		return
	}

	// 构建文档创建请求
	docRequest := models.CreateDocumentRequest{
		Title:       request.Title,
		Content:     request.Content,
		Description: request.Description,
		Type:        models.DocumentTypeWorkNote,
		Status:      models.DocumentStatusDraft,
		Visibility:  request.Visibility,
		Tags:        request.Tags,
		IsTemplate:  false,
		FolderID:    request.WorkNoteFolderID,
		Metadata: models.DocumentMetadata{
			"work_note_type": request.WorkNoteType,
			"priority":       request.Priority,
			"is_pinned":      request.IsPinned,
			"is_bookmarked":  request.IsBookmarked,
			"related_tasks":  request.RelatedTasks,
			"related_notes":  request.RelatedNotes,
			"custom_fields":  request.CustomFields,
		},
	}

	// 创建文档
	document, err := h.docRepo.Create(c.Request.Context(), &docRequest, userID)
	if err != nil {
		c.JSON(http.StatusInternalServerError, gin.H{
			"success": false,
			"error":   "Failed to create work note: " + err.Error(),
		})
		return
	}

	c.JSON(http.StatusCreated, gin.H{
		"success": true,
		"data":    document,
		"message": "Work note created successfully",
	})
}

// GetWorkNote 获取单个工作笔记
func (h *DocumentHandler) GetWorkNote(c *gin.Context) {
	noteID, err := strconv.Atoi(c.Param("id"))
	if err != nil {
		c.JSON(http.StatusBadRequest, gin.H{
			"success": false,
			"error":   "Invalid note ID",
		})
		return
	}

	userID := c.GetInt("user_id")
	if userID == 0 {
		c.JSON(http.StatusUnauthorized, gin.H{
			"success": false,
			"error":   "User not authenticated",
		})
		return
	}

	// 获取文档
	document, err := h.docRepo.GetByID(c.Request.Context(), noteID)
	if err != nil {
		if err == sql.ErrNoRows {
			c.JSON(http.StatusNotFound, gin.H{
				"success": false,
				"error":   "Work note not found",
			})
		} else {
			c.JSON(http.StatusInternalServerError, gin.H{
				"success": false,
				"error":   "Failed to get work note: " + err.Error(),
			})
		}
		return
	}

	// 检查权限和类型
	if document.Type != models.DocumentTypeWorkNote || document.UserID != userID {
		c.JSON(http.StatusForbidden, gin.H{
			"success": false,
			"error":   "Access denied",
		})
		return
	}

	c.JSON(http.StatusOK, gin.H{
		"success": true,
		"data":    document,
	})
}

// UpdateWorkNote 更新工作笔记
func (h *DocumentHandler) UpdateWorkNote(c *gin.Context) {
	noteID, err := strconv.Atoi(c.Param("id"))
	if err != nil {
		c.JSON(http.StatusBadRequest, gin.H{
			"success": false,
			"error":   "Invalid note ID",
		})
		return
	}

	var request models.UpdateWorkNoteRequest
	if err := c.ShouldBindJSON(&request); err != nil {
		c.JSON(http.StatusBadRequest, gin.H{
			"success": false,
			"error":   "Invalid request body: " + err.Error(),
		})
		return
	}

	userID := c.GetInt("user_id")
	if userID == 0 {
		c.JSON(http.StatusUnauthorized, gin.H{
			"success": false,
			"error":   "User not authenticated",
		})
		return
	}

	// 验证权限
	if err := h.validateNoteOwnership(nil, noteID, userID); err != nil {
		c.JSON(http.StatusForbidden, gin.H{
			"success": false,
			"error":   err.Error(),
		})
		return
	}

	// 构建更新请求
	updateRequest := models.UpdateDocumentRequest{
		Title:       request.Title,
		Content:     request.Content,
		Description: request.Description,
		FolderID:    request.WorkNoteFolderID,
		Tags:        request.Tags,
	}

	// 更新元数据
	metadata := make(models.DocumentMetadata)
	if request.WorkNoteType != nil {
		metadata["work_note_type"] = *request.WorkNoteType
	}
	if request.Priority != nil {
		metadata["priority"] = *request.Priority
	}
	if request.IsPinned != nil {
		metadata["is_pinned"] = *request.IsPinned
	}
	if request.IsBookmarked != nil {
		metadata["is_bookmarked"] = *request.IsBookmarked
	}
	if request.RelatedTasks != nil {
		metadata["related_tasks"] = request.RelatedTasks
	}
	if request.RelatedNotes != nil {
		metadata["related_notes"] = request.RelatedNotes
	}
	if request.CustomFields != nil {
		metadata["custom_fields"] = request.CustomFields
	}
	
	if len(metadata) > 0 {
		updateRequest.Metadata = metadata
	}

	// 执行更新
	document, err := h.docRepo.Update(c.Request.Context(), noteID, &updateRequest, userID)
	if err != nil {
		c.JSON(http.StatusInternalServerError, gin.H{
			"success": false,
			"error":   "Failed to update work note: " + err.Error(),
		})
		return
	}

	c.JSON(http.StatusOK, gin.H{
		"success": true,
		"data":    document,
		"message": "Work note updated successfully",
	})
}

// DeleteWorkNote 删除工作笔记
func (h *DocumentHandler) DeleteWorkNote(c *gin.Context) {
	noteID, err := strconv.Atoi(c.Param("id"))
	if err != nil {
		c.JSON(http.StatusBadRequest, gin.H{
			"success": false,
			"error":   "Invalid note ID",
		})
		return
	}

	userID := c.GetInt("user_id")
	if userID == 0 {
		c.JSON(http.StatusUnauthorized, gin.H{
			"success": false,
			"error":   "User not authenticated",
		})
		return
	}

	// 验证权限
	if err := h.validateNoteOwnership(nil, noteID, userID); err != nil {
		c.JSON(http.StatusForbidden, gin.H{
			"success": false,
			"error":   err.Error(),
		})
		return
	}

	// 删除文档
	if err := h.docRepo.Delete(c.Request.Context(), noteID, userID); err != nil {
		c.JSON(http.StatusInternalServerError, gin.H{
			"success": false,
			"error":   "Failed to delete work note: " + err.Error(),
		})
		return
	}

	c.JSON(http.StatusOK, gin.H{
		"success": true,
		"message": "Work note deleted successfully",
	})
}

// SearchWorkNotes 搜索工作笔记
func (h *DocumentHandler) SearchWorkNotes(c *gin.Context) {
	query := c.Query("query")
	if query == "" {
		c.JSON(http.StatusBadRequest, gin.H{
			"success": false,
			"error":   "Search query is required",
		})
		return
	}

	userID := c.GetInt("user_id")
	if userID == 0 {
		c.JSON(http.StatusUnauthorized, gin.H{
			"success": false,
			"error":   "User not authenticated",
		})
		return
	}

	// 解析分页参数
	page, _ := strconv.Atoi(c.DefaultQuery("page", "1"))
	limit, _ := strconv.Atoi(c.DefaultQuery("limit", "10"))
	if page < 1 {
		page = 1
	}
	if limit < 1 || limit > 100 {
		limit = 10
	}

	// 构建搜索过滤器
	filter := &models.DocumentFilter{
		Page:        page,
		Limit:       limit,
		UserID:      &userID,
		Type:        &models.DocumentTypeWorkNote,
		SearchQuery: &query,
	}

	// 执行搜索
	documentsWithRelations, total, err := h.docRepo.GetAllDocumentsWithRelations(c.Request.Context(), filter)
	if err != nil {
		c.JSON(http.StatusInternalServerError, gin.H{
			"success": false,
			"error":   "Failed to search work notes: " + err.Error(),
		})
		return
	}

	// 提取文档数据
	var documents []models.Document
	if len(documentsWithRelations) > 0 && documentsWithRelations[0] != nil {
		documents = documentsWithRelations[0].Documents
	}

	c.JSON(http.StatusOK, gin.H{
		"success": true,
		"data": gin.H{
			"documents": documents,
			"total":     total,
			"page":      page,
			"page_size": limit,
		},
	})
}

// CopyWorkNote 复制工作笔记
func (h *DocumentHandler) CopyWorkNote(c *gin.Context) {
	noteID, err := strconv.Atoi(c.Param("id"))
	if err != nil {
		c.JSON(http.StatusBadRequest, gin.H{
			"success": false,
			"error":   "Invalid note ID",
		})
		return
	}

	userID := c.GetInt("user_id")
	if userID == 0 {
		c.JSON(http.StatusUnauthorized, gin.H{
			"success": false,
			"error":   "User not authenticated",
		})
		return
	}

	// 获取原笔记
	original, err := h.docRepo.GetByID(c.Request.Context(), noteID)
	if err != nil {
		c.JSON(http.StatusNotFound, gin.H{
			"success": false,
			"error":   "Work note not found",
		})
		return
	}

	// 检查权限和类型
	if original.Type != models.DocumentTypeWorkNote || original.UserID != userID {
		c.JSON(http.StatusForbidden, gin.H{
			"success": false,
			"error":   "Access denied",
		})
		return
	}

	// 创建副本
	copyRequest := models.CreateDocumentRequest{
		Title:       original.Title + " (Copy)",
		Content:     original.Content,
		Description: original.Description,
		Type:        original.Type,
		Status:      models.DocumentStatusDraft,
		Visibility:  original.Visibility,
		Tags:        original.Tags,
		IsTemplate:  original.IsTemplate,
		FolderID:    original.FolderID,
		Metadata:    original.Metadata,
	}

	copy, err := h.docRepo.Create(c.Request.Context(), &copyRequest, userID)
	if err != nil {
		c.JSON(http.StatusInternalServerError, gin.H{
			"success": false,
			"error":   "Failed to copy work note: " + err.Error(),
		})
		return
	}

	c.JSON(http.StatusCreated, gin.H{
		"success": true,
		"data":    copy,
		"message": "Work note copied successfully",
	})
}

// ToggleWorkNoteTemplate 切换工作笔记模板状态
func (h *DocumentHandler) ToggleWorkNoteTemplate(c *gin.Context) {
	noteID, err := strconv.Atoi(c.Param("id"))
	if err != nil {
		c.JSON(http.StatusBadRequest, gin.H{
			"success": false,
			"error":   "Invalid note ID",
		})
		return
	}

	userID := c.GetInt("user_id")
	if userID == 0 {
		c.JSON(http.StatusUnauthorized, gin.H{
			"success": false,
			"error":   "User not authenticated",
		})
		return
	}

	// 验证权限
	if err := h.validateNoteOwnership(nil, noteID, userID); err != nil {
		c.JSON(http.StatusForbidden, gin.H{
			"success": false,
			"error":   err.Error(),
		})
		return
	}

	// 获取当前状态
	document, err := h.docRepo.GetByID(c.Request.Context(), noteID)
	if err != nil {
		c.JSON(http.StatusInternalServerError, gin.H{
			"success": false,
			"error":   "Failed to get work note: " + err.Error(),
		})
		return
	}

	// 切换模板状态
	newTemplateStatus := !document.IsTemplate
	updateRequest := models.UpdateDocumentRequest{
		IsTemplate: &newTemplateStatus,
	}

	updatedDocument, err := h.docRepo.Update(c.Request.Context(), noteID, &updateRequest, userID)
	if err != nil {
		c.JSON(http.StatusInternalServerError, gin.H{
			"success": false,
			"error":   "Failed to toggle template status: " + err.Error(),
		})
		return
	}

	c.JSON(http.StatusOK, gin.H{
		"success": true,
		"data":    updatedDocument,
		"message": fmt.Sprintf("Template status changed to: %t", newTemplateStatus),
	})
}
