// BatchAssociateDocuments 批量关联文档
// @Summary 批量关联文档
// @Description 批量创建文档与任务的关联关系
// @Tags document-registry
// @Accept json
// @Produce json
// @Param batch_request body models.BatchAssociateDocumentsRequest true "批量关联请求"
// @Success 200 {object} utils.SuccessResponse{data=models.DocumentScanResult}
// @Failure 400 {object} utils.ErrorResponse
// @Failure 500 {object} utils.ErrorResponse
// @Router /api/v1/document-registry/batch-associate [post]
func (h *DocumentRegistryHandler) BatchAssociateDocuments(c *gin.Context) {
	var req models.BatchAssociateDocumentsRequest
	if err := c.ShouldBindJSON(&req); err != nil {
		c.JSON(http.StatusBadRequest, utils.ErrorResponse{
			Error:   "invalid request body",
			Message: err.Error(),
		})
		return
	}

	// 获取用户ID
	userID := utils.GetUserIDFromContext(c)

	// 批量关联文档
	result, err := h.documentService.BatchAssociateDocuments(c.Request.Context(), &req, userID)
	if err != nil {
		c.JSON(http.StatusInternalServerError, utils.ErrorResponse{
			Error:   "failed to batch associate documents",
			Message: err.Error(),
		})
		return
	}

	c.JSON(http.StatusOK, utils.SuccessResponse{
		Success: true,
		Message: "Batch association completed",
		Data:    result,
	})
}

// AutoAssociateTaskDocuments 自动关联任务文档
// @Summary 自动关联任务文档
// @Description 自动查找并关联与指定任务相关的文档
// @Tags document-registry
// @Produce json
// @Param task_id path int true "任务ID"
// @Success 200 {object} utils.SuccessResponse{data=[]models.DocumentInfo}
// @Failure 400 {object} utils.ErrorResponse
// @Failure 500 {object} utils.ErrorResponse
// @Router /api/v1/document-registry/tasks/{task_id}/auto-associate [post]
func (h *DocumentRegistryHandler) AutoAssociateTaskDocuments(c *gin.Context) {
	taskIDStr := c.Param("task_id")
	taskID, err := strconv.Atoi(taskIDStr)
	if err != nil {
		c.JSON(http.StatusBadRequest, utils.ErrorResponse{
			Error:   "invalid task id",
			Message: "Task ID must be a number",
		})
		return
	}

	// 获取用户ID
	userID := utils.GetUserIDFromContext(c)

	// 自动关联文档
	documents, err := h.documentService.AutoAssociateTaskDocuments(c.Request.Context(), taskID, userID)
	if err != nil {
		c.JSON(http.StatusInternalServerError, utils.ErrorResponse{
			Error:   "failed to auto associate documents",
			Message: err.Error(),
		})
		return
	}

	c.JSON(http.StatusOK, utils.SuccessResponse{
		Success: true,
		Message: "Auto association completed",
		Data:    documents,
	})
}

// SuggestDocumentAssociations 建议文档关联
// @Summary 建议文档关联
// @Description 为指定文档建议可能相关的任务
// @Tags document-registry
// @Produce json
// @Param document_id path int true "文档ID"
// @Success 200 {object} utils.SuccessResponse{data=[]models.TaskDocumentInfo}
// @Failure 400 {object} utils.ErrorResponse
// @Failure 500 {object} utils.ErrorResponse
// @Router /api/v1/document-registry/{document_id}/suggest-associations [get]
func (h *DocumentRegistryHandler) SuggestDocumentAssociations(c *gin.Context) {
	documentIDStr := c.Param("document_id")
	documentID, err := strconv.Atoi(documentIDStr)
	if err != nil {
		c.JSON(http.StatusBadRequest, utils.ErrorResponse{
			Error:   "invalid document id",
			Message: "Document ID must be a number",
		})
		return
	}

	// 建议关联
	suggestions, err := h.documentService.SuggestDocumentAssociations(c.Request.Context(), documentID)
	if err != nil {
		c.JSON(http.StatusInternalServerError, utils.ErrorResponse{
			Error:   "failed to get document association suggestions",
			Message: err.Error(),
		})
		return
	}

	c.JSON(http.StatusOK, utils.SuccessResponse{
		Success: true,
		Data:    suggestions,
	})
}