// ScanDocumentsDirectory 扫描文档目录
// @Summary 扫描文档目录
// @Description 扫描指定目录的Markdown文档并注册到系统
// @Tags document-registry
// @Accept json
// @Produce json
// @Param scan_request body map[string]string true "扫描请求" example({"root_path": "docs"})
// @Success 200 {object} utils.SuccessResponse{data=models.DocumentScanResult}
// @Failure 400 {object} utils.ErrorResponse
// @Failure 500 {object} utils.ErrorResponse
// @Router /api/v1/document-registry/scan [post]
func (h *DocumentRegistryHandler) ScanDocumentsDirectory(c *gin.Context) {
	var reqBody map[string]string
	if err := c.ShouldBindJSON(&reqBody); err != nil {
		c.JSON(http.StatusBadRequest, utils.ErrorResponse{
			Error:   "invalid request body",
			Message: err.Error(),
		})
		return
	}

	rootPath, exists := reqBody["root_path"]
	if !exists || rootPath == "" {
		c.JSON(http.StatusBadRequest, utils.ErrorResponse{
			Error:   "missing root path",
			Message: "Root path is required",
		})
		return
	}

	// 获取用户ID
	userID := utils.GetUserIDFromContext(c)

	// 扫描目录
	result, err := h.documentService.ScanDocumentsDirectory(c.Request.Context(), rootPath, userID)
	if err != nil {
		c.JSON(http.StatusInternalServerError, utils.ErrorResponse{
			Error:   "failed to scan directory",
			Message: err.Error(),
		})
		return
	}

	c.JSON(http.StatusOK, utils.SuccessResponse{
		Success: true,
		Message: "Directory scan completed",
		Data:    result,
	})
}

