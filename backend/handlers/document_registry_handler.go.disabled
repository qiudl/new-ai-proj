package handlers

import (
	"context"
	"encoding/json"
	"net/http"
	"strconv"
	"time"

	"github.com/gin-gonic/gin"
	"new-ai-proj/models"
	"new-ai-proj/services"
	"new-ai-proj/utils"
)

// DocumentRegistryHandler 文档注册表处理器
type DocumentRegistryHandler struct {
	documentService services.DocumentRegistryService
}

// NewDocumentRegistryHandler 创建文档注册表处理器
func NewDocumentRegistryHandler(documentService services.DocumentRegistryService) *DocumentRegistryHandler {
	return &DocumentRegistryHandler{
		documentService: documentService,
	}
}

// CreateDocument 创建文档注册表项
// @Summary 创建文档注册表项
// @Description 在文档注册表中创建新的文档条目
// @Tags document-registry
// @Accept json
// @Produce json
// @Param document body models.CreateDocumentRequest true "文档信息"
// @Success 200 {object} models.DocumentRegistry
// @Failure 400 {object} utils.ErrorResponse
// @Failure 500 {object} utils.ErrorResponse
// @Router /api/v1/document-registry [post]
func (h *DocumentRegistryHandler) CreateDocument(c *gin.Context) {
	var req models.CreateDocumentRequest
	if err := c.ShouldBindJSON(&req); err != nil {
		c.JSON(http.StatusBadRequest, utils.ErrorResponse{
			Error:   "invalid request body",
			Message: err.Error(),
		})
		return
	}

	// 获取用户ID
	userID := utils.GetUserIDFromContext(c)
	req.CreatedBy = userID

	// 创建文档
	doc, err := h.documentService.CreateDocument(c.Request.Context(), &req)
	if err != nil {
		c.JSON(http.StatusInternalServerError, utils.ErrorResponse{
			Error:   "failed to create document",
			Message: err.Error(),
		})
		return
	}

	c.JSON(http.StatusCreated, utils.SuccessResponse{
		Success: true,
		Message: "Document created successfully",
		Data:    doc,
	})
}

// GetDocument 获取文档信息
// @Summary 获取文档信息
// @Description 根据ID获取文档注册表信息
// @Tags document-registry
// @Produce json
// @Param id path int true "文档ID"
// @Success 200 {object} models.DocumentRegistry
// @Failure 400 {object} utils.ErrorResponse
// @Failure 404 {object} utils.ErrorResponse
// @Router /api/v1/document-registry/{id} [get]
func (h *DocumentRegistryHandler) GetDocument(c *gin.Context) {
	idStr := c.Param("id")
	id, err := strconv.Atoi(idStr)
	if err != nil {
		c.JSON(http.StatusBadRequest, utils.ErrorResponse{
			Error:   "invalid document id",
			Message: "Document ID must be a number",
		})
		return
	}

	doc, err := h.documentService.GetDocumentByID(c.Request.Context(), id)
	if err != nil {
		c.JSON(http.StatusNotFound, utils.ErrorResponse{
			Error:   "document not found",
			Message: err.Error(),
		})
		return
	}

	c.JSON(http.StatusOK, utils.SuccessResponse{
		Success: true,
		Data:    doc,
	})
}

// GetDocumentByPath 根据路径获取文档
// @Summary 根据路径获取文档
// @Description 根据文件路径获取文档注册表信息
// @Tags document-registry
// @Produce json
// @Param path query string true "文件路径"
// @Success 200 {object} models.DocumentRegistry
// @Failure 400 {object} utils.ErrorResponse
// @Failure 404 {object} utils.ErrorResponse
// @Router /api/v1/document-registry/by-path [get]
func (h *DocumentRegistryHandler) GetDocumentByPath(c *gin.Context) {
	filePath := c.Query("path")
	if filePath == "" {
		c.JSON(http.StatusBadRequest, utils.ErrorResponse{
			Error:   "missing file path",
			Message: "File path is required",
		})
		return
	}

	doc, err := h.documentService.GetDocumentByPath(c.Request.Context(), filePath)
	if err != nil {
		c.JSON(http.StatusNotFound, utils.ErrorResponse{
			Error:   "document not found",
			Message: err.Error(),
		})
		return
	}

	c.JSON(http.StatusOK, utils.SuccessResponse{
		Success: true,
		Data:    doc,
	})
}

// UpdateDocument 更新文档信息
// @Summary 更新文档信息
// @Description 更新文档注册表信息
// @Tags document-registry
// @Accept json
// @Produce json
// @Param id path int true "文档ID"
// @Param document body models.UpdateDocumentRequest true "更新信息"
// @Success 200 {object} utils.SuccessResponse
// @Failure 400 {object} utils.ErrorResponse
// @Failure 404 {object} utils.ErrorResponse
// @Router /api/v1/document-registry/{id} [put]
func (h *DocumentRegistryHandler) UpdateDocument(c *gin.Context) {
	idStr := c.Param("id")
	id, err := strconv.Atoi(idStr)
	if err != nil {
		c.JSON(http.StatusBadRequest, utils.ErrorResponse{
			Error:   "invalid document id",
			Message: "Document ID must be a number",
		})
		return
	}

	var req models.UpdateDocumentRequest
	if err := c.ShouldBindJSON(&req); err != nil {
		c.JSON(http.StatusBadRequest, utils.ErrorResponse{
			Error:   "invalid request body",
			Message: err.Error(),
		})
		return
	}

	err = h.documentService.UpdateDocument(c.Request.Context(), id, &req)
	if err != nil {
		c.JSON(http.StatusInternalServerError, utils.ErrorResponse{
			Error:   "failed to update document",
			Message: err.Error(),
		})
		return
	}

	c.JSON(http.StatusOK, utils.SuccessResponse{
		Success: true,
		Message: "Document updated successfully",
	})
}

