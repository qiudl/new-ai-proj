// SearchDocuments 搜索文档
// @Summary 搜索文档
// @Description 根据关键词和过滤条件搜索文档
// @Tags document-registry
// @Produce json
// @Param query query string false "搜索关键词"
// @Param category query string false "文档分类"
// @Param created_by query int false "创建者ID"
// @Param page query int false "页码" default(1)
// @Param limit query int false "每页数量" default(20)
// @Success 200 {object} utils.SuccessResponse{data=[]models.DocumentInfo}
// @Failure 400 {object} utils.ErrorResponse
// @Router /api/v1/document-registry/search [get]
func (h *DocumentRegistryHandler) SearchDocuments(c *gin.Context) {
	query := c.Query("query")
	
	// 解析过滤条件
	filters := &models.DocumentFilters{}
	
	if category := c.Query("category"); category != "" {
		filters.Category = &category
	}
	
	if createdByStr := c.Query("created_by"); createdByStr != "" {
		if createdBy, err := strconv.Atoi(createdByStr); err == nil {
			filters.CreatedBy = &createdBy
		}
	}
	
	// 解析分页参数
	page, _ := strconv.Atoi(c.DefaultQuery("page", "1"))
	limit, _ := strconv.Atoi(c.DefaultQuery("limit", "20"))
	
	if page < 1 {
		page = 1
	}
	if limit < 1 || limit > 100 {
		limit = 20
	}
	
	filters.Page = page
	filters.Limit = limit

	// 搜索文档
	documents, err := h.documentService.SearchDocuments(c.Request.Context(), query, filters)
	if err != nil {
		c.JSON(http.StatusInternalServerError, utils.ErrorResponse{
			Error:   "failed to search documents",
			Message: err.Error(),
		})
		return
	}

	c.JSON(http.StatusOK, utils.SuccessResponse{
		Success: true,
		Data:    documents,
	})
}

// ListDocuments 列出文档
// @Summary 列出文档
// @Description 获取文档列表
// @Tags document-registry
// @Produce json
// @Param category query string false "文档分类"
// @Param page query int false "页码" default(1)
// @Param limit query int false "每页数量" default(20)
// @Success 200 {object} utils.SuccessResponse{data=[]models.DocumentInfo}
// @Failure 400 {object} utils.ErrorResponse
// @Router /api/v1/document-registry [get]
func (h *DocumentRegistryHandler) ListDocuments(c *gin.Context) {
	// 解析过滤条件
	filters := &models.DocumentFilters{}
	
	if category := c.Query("category"); category != "" {
		filters.Category = &category
	}
	
	// 解析分页参数
	page, _ := strconv.Atoi(c.DefaultQuery("page", "1"))
	limit, _ := strconv.Atoi(c.DefaultQuery("limit", "20"))
	
	if page < 1 {
		page = 1
	}
	if limit < 1 || limit > 100 {
		limit = 20
	}
	
	filters.Page = page
	filters.Limit = limit

	// 获取文档列表
	documents, err := h.documentService.ListDocuments(c.Request.Context(), filters)
	if err != nil {
		c.JSON(http.StatusInternalServerError, utils.ErrorResponse{
			Error:   "failed to list documents",
			Message: err.Error(),
		})
		return
	}

	c.JSON(http.StatusOK, utils.SuccessResponse{
		Success: true,
		Data:    documents,
	})
}

// GetDocumentsByCategory 根据分类获取文档
// @Summary 根据分类获取文档
// @Description 获取指定分类的文档列表
// @Tags document-registry
// @Produce json
// @Param category path string true "文档分类"
// @Param page query int false "页码" default(1)
// @Param limit query int false "每页数量" default(20)
// @Success 200 {object} utils.SuccessResponse{data=[]models.DocumentInfo}
// @Failure 400 {object} utils.ErrorResponse
// @Router /api/v1/document-registry/category/{category} [get]
func (h *DocumentRegistryHandler) GetDocumentsByCategory(c *gin.Context) {
	category := c.Param("category")
	if !models.IsValidCategory(category) {
		c.JSON(http.StatusBadRequest, utils.ErrorResponse{
			Error:   "invalid category",
			Message: "Invalid document category",
		})
		return
	}

	// 解析分页参数
	page, _ := strconv.Atoi(c.DefaultQuery("page", "1"))
	limit, _ := strconv.Atoi(c.DefaultQuery("limit", "20"))
	
	if page < 1 {
		page = 1
	}
	if limit < 1 || limit > 100 {
		limit = 20
	}
	
	offset := (page - 1) * limit

	// 获取文档列表
	documents, err := h.documentService.GetDocumentsByCategory(c.Request.Context(), category, limit, offset)
	if err != nil {
		c.JSON(http.StatusInternalServerError, utils.ErrorResponse{
			Error:   "failed to get documents by category",
			Message: err.Error(),
		})
		return
	}

	c.JSON(http.StatusOK, utils.SuccessResponse{
		Success: true,
		Data:    documents,
	})
}

// CreateDocumentTaskAssociation 创建文档-任务关联
// @Summary 创建文档-任务关联
// @Description 创建文档与任务的关联关系
// @Tags document-registry
// @Accept json
// @Produce json
// @Param association body models.CreateDocumentTaskAssociationRequest true "关联信息"
// @Success 201 {object} utils.SuccessResponse
// @Failure 400 {object} utils.ErrorResponse
// @Failure 500 {object} utils.ErrorResponse
// @Router /api/v1/document-registry/associations [post]
func (h *DocumentRegistryHandler) CreateDocumentTaskAssociation(c *gin.Context) {
	var req models.CreateDocumentTaskAssociationRequest
	if err := c.ShouldBindJSON(&req); err != nil {
		c.JSON(http.StatusBadRequest, utils.ErrorResponse{
			Error:   "invalid request body",
			Message: err.Error(),
		})
		return
	}

	// 获取用户ID
	userID := utils.GetUserIDFromContext(c)
	req.CreatedBy = userID

	// 验证关联类型
	if !models.IsValidAssociationType(req.AssociationType) {
		c.JSON(http.StatusBadRequest, utils.ErrorResponse{
			Error:   "invalid association type",
			Message: "Invalid association type",
		})
		return
	}

	// 创建关联
	err := h.documentService.CreateDocumentTaskAssociation(c.Request.Context(), &req)
	if err != nil {
		c.JSON(http.StatusInternalServerError, utils.ErrorResponse{
			Error:   "failed to create association",
			Message: err.Error(),
		})
		return
	}

	c.JSON(http.StatusCreated, utils.SuccessResponse{
		Success: true,
		Message: "Document-task association created successfully",
	})
}

