package handlers

import (
	"ai-project-backend/database"
	"ai-project-backend/models"
	"log"
	"net/http"
	"strconv"
	"time"

	"github.com/gin-gonic/gin"
	"github.com/go-playground/validator/v10"
)

// DocumentVersionCommentHandler handles document version comment operations
type DocumentVersionCommentHandler struct {
	db       database.DB
	logger   *log.Logger
	validate *validator.Validate
}

// NewDocumentVersionCommentHandler creates a new document version comment handler
func NewDocumentVersionCommentHandler(db database.DB, logger *log.Logger, validate *validator.Validate) *DocumentVersionCommentHandler {
	return &DocumentVersionCommentHandler{
		db:       db,
		logger:   logger,
		validate: validate,
	}
}

// CreateComment creates a new version comment
// POST /api/v1/document-version-comments
func (h *DocumentVersionCommentHandler) CreateComment(c *gin.Context) {
	var req models.CreateVersionCommentRequest
	if err := c.ShouldBindJSON(&req); err != nil {
		c.JSON(http.StatusBadRequest, gin.H{
			"error":   "Invalid request body",
			"details": err.Error(),
		})
		return
	}

	// Validate request
	if err := h.validate.Struct(&req); err != nil {
		c.JSON(http.StatusBadRequest, gin.H{
			"error":   "Validation failed",
			"details": err.Error(),
		})
		return
	}

	// Check if version exists
	version, err := h.db.DocumentVersions().GetByDocumentAndVersion(req.DocumentID, req.VersionNumber)
	if err != nil {
		h.logger.Printf("Error checking version existence: %v", err)
		c.JSON(http.StatusNotFound, gin.H{
			"error": "Document version not found",
		})
		return
	}

	// Check if parent comment exists (for replies)
	if req.ParentID != nil {
		parentComment, err := h.db.DocumentVersions().GetCommentByID(*req.ParentID)
		if err != nil {
			h.logger.Printf("Error checking parent comment: %v", err)
			c.JSON(http.StatusNotFound, gin.H{
				"error": "Parent comment not found",
			})
			return
		}

		// Ensure parent comment is for the same version
		if parentComment.DocumentID != req.DocumentID || parentComment.VersionNumber != req.VersionNumber {
			c.JSON(http.StatusBadRequest, gin.H{
				"error": "Parent comment must be for the same document version",
			})
			return
		}
	}

	// Create comment
	comment := &models.DocumentVersionComment{
		DocumentID:    req.DocumentID,
		VersionNumber: req.VersionNumber,
		UserID:        getUserID(c),
		Content:       req.Content,
		LineNumber:    req.LineNumber,
		CreatedAt:     time.Now(),
		UpdatedAt:     time.Now(),
		IsResolved:    false,
		ParentID:      req.ParentID,
	}

	createdComment, err := h.db.DocumentVersions().CreateComment(comment)
	if err != nil {
		h.logger.Printf("Error creating version comment: %v", err)
		c.JSON(http.StatusInternalServerError, gin.H{
			"error": "Failed to create version comment",
		})
		return
	}

	c.JSON(http.StatusCreated, createdComment)
}

// GetVersionComments gets all comments for a specific document version
// GET /api/v1/documents/:document_id/versions/:version_number/comments
func (h *DocumentVersionCommentHandler) GetVersionComments(c *gin.Context) {
	documentID, err := strconv.Atoi(c.Param("document_id"))
	if err != nil {
		c.JSON(http.StatusBadRequest, gin.H{
			"error": "Invalid document ID",
		})
		return
	}

	versionNumber, err := strconv.Atoi(c.Param("version_number"))
	if err != nil {
		c.JSON(http.StatusBadRequest, gin.H{
			"error": "Invalid version number",
		})
		return
	}

	// Parse query parameters
	includeReplies := c.DefaultQuery("include_replies", "true") == "true"
	onlyResolved := c.Query("resolved")
	
	var comments []*models.DocumentVersionComment
	
	if includeReplies {
		comments, err = h.db.DocumentVersions().GetVersionCommentsWithReplies(documentID, versionNumber)
	} else {
		comments, err = h.db.DocumentVersions().GetVersionComments(documentID, versionNumber)
	}

	if err != nil {
		h.logger.Printf("Error getting version comments: %v", err)
		c.JSON(http.StatusInternalServerError, gin.H{
			"error": "Failed to get version comments",
		})
		return
	}

	// Filter by resolved status if specified
	if onlyResolved != "" {
		resolved := onlyResolved == "true"
		filteredComments := make([]*models.DocumentVersionComment, 0)
		for _, comment := range comments {
			if comment.IsResolved == resolved {
				filteredComments = append(filteredComments, comment)
			}
		}
		comments = filteredComments
	}

	c.JSON(http.StatusOK, gin.H{
		"comments": comments,
	})
}

// GetComment gets a specific comment by ID
// GET /api/v1/document-version-comments/:id
func (h *DocumentVersionCommentHandler) GetComment(c *gin.Context) {
	commentID, err := strconv.Atoi(c.Param("id"))
	if err != nil {
		c.JSON(http.StatusBadRequest, gin.H{
			"error": "Invalid comment ID",
		})
		return
	}

	comment, err := h.db.DocumentVersions().GetCommentByID(commentID)
	if err != nil {
		h.logger.Printf("Error getting version comment: %v", err)
		c.JSON(http.StatusNotFound, gin.H{
			"error": "Version comment not found",
		})
		return
	}

	// Load replies if requested
	if c.Query("include_replies") == "true" {
		replies, err := h.db.DocumentVersions().GetCommentReplies(commentID)
		if err != nil {
			h.logger.Printf("Error getting comment replies: %v", err)
			// Continue without replies
		} else {
			comment.Replies = replies
		}
	}

	c.JSON(http.StatusOK, comment)
}

// UpdateComment updates a version comment
// PUT /api/v1/document-version-comments/:id
func (h *DocumentVersionCommentHandler) UpdateComment(c *gin.Context) {
	commentID, err := strconv.Atoi(c.Param("id"))
	if err != nil {
		c.JSON(http.StatusBadRequest, gin.H{
			"error": "Invalid comment ID",
		})
		return
	}

	var req struct {
		Content *string `json:"content,omitempty" validate:"omitempty,max=1000"`
	}

	if err := c.ShouldBindJSON(&req); err != nil {
		c.JSON(http.StatusBadRequest, gin.H{
			"error":   "Invalid request body",
			"details": err.Error(),
		})
		return
	}

	// Validate request
	if err := h.validate.Struct(&req); err != nil {
		c.JSON(http.StatusBadRequest, gin.H{
			"error":   "Validation failed",
			"details": err.Error(),
		})
		return
	}

	// Get existing comment
	existingComment, err := h.db.DocumentVersions().GetCommentByID(commentID)
	if err != nil {
		h.logger.Printf("Error getting version comment: %v", err)
		c.JSON(http.StatusNotFound, gin.H{
			"error": "Version comment not found",
		})
		return
	}

	// Check permissions - user can only update their own comments
	currentUserID := getUserID(c)
	if existingComment.UserID != currentUserID {
		c.JSON(http.StatusForbidden, gin.H{
			"error": "You can only update your own comments",
		})
		return
	}

	// Update fields
	if req.Content != nil {
		existingComment.Content = *req.Content
		existingComment.UpdatedAt = time.Now()
	}

	updatedComment, err := h.db.DocumentVersions().UpdateComment(existingComment)
	if err != nil {
		h.logger.Printf("Error updating version comment: %v", err)
		c.JSON(http.StatusInternalServerError, gin.H{
			"error": "Failed to update version comment",
		})
		return
	}

	c.JSON(http.StatusOK, updatedComment)
}

// ResolveComment marks a comment as resolved/unresolved
// PATCH /api/v1/document-version-comments/:id/resolve
func (h *DocumentVersionCommentHandler) ResolveComment(c *gin.Context) {
	commentID, err := strconv.Atoi(c.Param("id"))
	if err != nil {
		c.JSON(http.StatusBadRequest, gin.H{
			"error": "Invalid comment ID",
		})
		return
	}

	var req struct {
		IsResolved bool `json:"is_resolved"`
	}

	if err := c.ShouldBindJSON(&req); err != nil {
		c.JSON(http.StatusBadRequest, gin.H{
			"error":   "Invalid request body",
			"details": err.Error(),
		})
		return
	}

	// Get existing comment
	existingComment, err := h.db.DocumentVersions().GetCommentByID(commentID)
	if err != nil {
		h.logger.Printf("Error getting version comment: %v", err)
		c.JSON(http.StatusNotFound, gin.H{
			"error": "Version comment not found",
		})
		return
	}

	// Update resolved status
	existingComment.IsResolved = req.IsResolved
	existingComment.UpdatedAt = time.Now()

	updatedComment, err := h.db.DocumentVersions().UpdateComment(existingComment)
	if err != nil {
		h.logger.Printf("Error updating comment resolution: %v", err)
		c.JSON(http.StatusInternalServerError, gin.H{
			"error": "Failed to update comment resolution",
		})
		return
	}

	action := "resolved"
	if !req.IsResolved {
		action = "unresolved"
	}

	c.JSON(http.StatusOK, gin.H{
		"message": "Comment " + action + " successfully",
		"comment": updatedComment,
	})
}

// DeleteComment deletes a version comment
// DELETE /api/v1/document-version-comments/:id
func (h *DocumentVersionCommentHandler) DeleteComment(c *gin.Context) {
	commentID, err := strconv.Atoi(c.Param("id"))
	if err != nil {
		c.JSON(http.StatusBadRequest, gin.H{
			"error": "Invalid comment ID",
		})
		return
	}

	// Get existing comment
	existingComment, err := h.db.DocumentVersions().GetCommentByID(commentID)
	if err != nil {
		h.logger.Printf("Error getting version comment: %v", err)
		c.JSON(http.StatusNotFound, gin.H{
			"error": "Version comment not found",
		})
		return
	}

	// Check permissions - user can only delete their own comments
	currentUserID := getUserID(c)
	if existingComment.UserID != currentUserID {
		c.JSON(http.StatusForbidden, gin.H{
			"error": "You can only delete your own comments",
		})
		return
	}

	// Check if comment has replies
	replies, err := h.db.DocumentVersions().GetCommentReplies(commentID)
	if err != nil {
		h.logger.Printf("Error checking comment replies: %v", err)
		// Continue - not critical
	} else if len(replies) > 0 {
		c.JSON(http.StatusBadRequest, gin.H{
			"error": "Cannot delete comment with replies",
		})
		return
	}

	// Delete the comment
	if err := h.db.DocumentVersions().DeleteComment(commentID); err != nil {
		h.logger.Printf("Error deleting version comment: %v", err)
		c.JSON(http.StatusInternalServerError, gin.H{
			"error": "Failed to delete version comment",
		})
		return
	}

	c.JSON(http.StatusOK, gin.H{
		"message": "Version comment deleted successfully",
	})
}

// GetCommentReplies gets all replies for a comment
// GET /api/v1/document-version-comments/:id/replies
func (h *DocumentVersionCommentHandler) GetCommentReplies(c *gin.Context) {
	commentID, err := strconv.Atoi(c.Param("id"))
	if err != nil {
		c.JSON(http.StatusBadRequest, gin.H{
			"error": "Invalid comment ID",
		})
		return
	}

	// Check if parent comment exists
	_, err = h.db.DocumentVersions().GetCommentByID(commentID)
	if err != nil {
		h.logger.Printf("Error getting parent comment: %v", err)
		c.JSON(http.StatusNotFound, gin.H{
			"error": "Parent comment not found",
		})
		return
	}

	replies, err := h.db.DocumentVersions().GetCommentReplies(commentID)
	if err != nil {
		h.logger.Printf("Error getting comment replies: %v", err)
		c.JSON(http.StatusInternalServerError, gin.H{
			"error": "Failed to get comment replies",
		})
		return
	}

	c.JSON(http.StatusOK, gin.H{
		"replies": replies,
	})
}

// GetDocumentComments gets all comments for a document (across all versions)
// GET /api/v1/documents/:document_id/comments
func (h *DocumentVersionCommentHandler) GetDocumentComments(c *gin.Context) {
	documentID, err := strconv.Atoi(c.Param("document_id"))
	if err != nil {
		c.JSON(http.StatusBadRequest, gin.H{
			"error": "Invalid document ID",
		})
		return
	}

	// Parse pagination parameters
	page, _ := strconv.Atoi(c.DefaultQuery("page", "1"))
	pageSize, _ := strconv.Atoi(c.DefaultQuery("page_size", "20"))
	
	if page < 1 {
		page = 1
	}
	if pageSize < 1 || pageSize > 100 {
		pageSize = 20
	}

	// Parse filter parameters
	onlyResolved := c.Query("resolved")
	versionNumber := c.Query("version")

	comments, totalCount, err := h.db.DocumentVersions().GetDocumentComments(documentID, page, pageSize)
	if err != nil {
		h.logger.Printf("Error getting document comments: %v", err)
		c.JSON(http.StatusInternalServerError, gin.H{
			"error": "Failed to get document comments",
		})
		return
	}

	// Apply filters
	if onlyResolved != "" || versionNumber != "" {
		filteredComments := make([]*models.DocumentVersionComment, 0)
		for _, comment := range comments {
			// Filter by resolved status
			if onlyResolved != "" {
				resolved := onlyResolved == "true"
				if comment.IsResolved != resolved {
					continue
				}
			}

			// Filter by version number
			if versionNumber != "" {
				if vn, err := strconv.Atoi(versionNumber); err == nil {
					if comment.VersionNumber != vn {
						continue
					}
				}
			}

			filteredComments = append(filteredComments, comment)
		}
		comments = filteredComments
		totalCount = len(comments)
	}

	c.JSON(http.StatusOK, gin.H{
		"comments":     comments,
		"total_count":  totalCount,
		"current_page": page,
		"page_size":    pageSize,
		"has_more":     (page * pageSize) < totalCount,
	})
}