	var req models.UpdateDocumentShareRequest
	if err := c.ShouldBindJSON(&req); err != nil {
		c.JSON(http.StatusBadRequest, gin.H{"error": err.Error()})
		return
	}

	share, err := h.repo.UpdateShare(c.Request.Context(), shareID, &req, userID)
	if err != nil {
