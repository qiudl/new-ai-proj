// @Summary Get document shares
// @Description Get all shareable links for a specific document
// @Tags document-shares
// @Produce json
// @Param document_id path int true "Document ID"
// @Success 200 {object} models.DocumentShareResponse
// @Failure 400 {object} map[string]string
// @Failure 401 {object} map[string]string
// @Failure 500 {object} map[string]string
// @Router /api/v1/documents/{document_id}/shares [get]
func (h *DocumentPermissionHandler) GetDocumentShares(c *gin.Context) {
	userID := utils.GetUserIDFromContext(c)
	if userID == 0 {
