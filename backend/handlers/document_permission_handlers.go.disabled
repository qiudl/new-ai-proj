package handlers

import (
	"ai-project-backend/models"
	"ai-project-backend/utils"
	"net/http"
	"strconv"
	"time"

	"github.com/gin-gonic/gin"
)

type DocumentPermissionHandler struct {
	repo models.DocumentPermissionRepository
}

func NewDocumentPermissionHandler(repo models.DocumentPermissionRepository) *DocumentPermissionHandler {
	return &DocumentPermissionHandler{repo: repo}
}

// GrantPermission grants a permission to a user for a document
// @Summary Grant document permission
// @Description Grant a permission to a user for a specific document
// @Tags document-permissions
// @Accept json
// @Produce json
// @Param request body models.GrantDocumentPermissionRequest true "Grant permission request"
// @Success 201 {object} models.DocumentPermission
// @Failure 400 {object} map[string]string
// @Failure 401 {object} map[string]string
// @Failure 500 {object} map[string]string
// @Router /api/v1/document-permissions [post]
func (h *DocumentPermissionHandler) GrantPermission(c *gin.Context) {
	userID := utils.GetUserIDFromContext(c)
	if userID == 0 {
		c.JSON(http.StatusUnauthorized, gin.H{"error": "Unauthorized"})
		return
	}

	var req models.GrantDocumentPermissionRequest
	if err := c.ShouldBindJSON(&req); err != nil {
		c.JSON(http.StatusBadRequest, gin.H{"error": err.Error()})
		return
	}

	permission, err := h.repo.GrantPermission(c.Request.Context(), &req, userID)
	if err != nil {
		c.JSON(http.StatusInternalServerError, gin.H{"error": err.Error()})
		return
	}

	c.JSON(http.StatusCreated, permission)
}

// GetDocumentPermissions retrieves all permissions for a document
// @Summary Get document permissions
// @Description Get all permissions for a specific document
// @Tags document-permissions
// @Produce json
// @Param document_id path int true "Document ID"
// @Success 200 {object} models.DocumentPermissionResponse
// @Failure 400 {object} map[string]string
// @Failure 401 {object} map[string]string
// @Failure 500 {object} map[string]string
// @Router /api/v1/documents/{document_id}/permissions [get]
func (h *DocumentPermissionHandler) GetDocumentPermissions(c *gin.Context) {
	userID := utils.GetUserIDFromContext(c)
	if userID == 0 {
		c.JSON(http.StatusUnauthorized, gin.H{"error": "Unauthorized"})
		return
	}

	documentIDStr := c.Param("document_id")
	documentID, err := strconv.Atoi(documentIDStr)
	if err != nil {
		c.JSON(http.StatusBadRequest, gin.H{"error": "Invalid document ID"})
		return
	}

	permissions, err := h.repo.GetDocumentPermissions(c.Request.Context(), documentID, userID)
	if err != nil {
		c.JSON(http.StatusInternalServerError, gin.H{"error": err.Error()})
		return
	}

	c.JSON(http.StatusOK, permissions)
}

// GetUserPermissions retrieves all permissions for the current user
// @Summary Get user permissions
// @Description Get all document permissions for the current user
// @Tags document-permissions
// @Produce json
// @Success 200 {object} models.DocumentPermissionResponse
// @Failure 401 {object} map[string]string
// @Failure 500 {object} map[string]string
// @Router /api/v1/my-permissions [get]
func (h *DocumentPermissionHandler) GetUserPermissions(c *gin.Context) {
	userID := utils.GetUserIDFromContext(c)
	if userID == 0 {
		c.JSON(http.StatusUnauthorized, gin.H{"error": "Unauthorized"})
		return
	}

	permissions, err := h.repo.GetUserPermissions(c.Request.Context(), userID)
	if err != nil {
		c.JSON(http.StatusInternalServerError, gin.H{"error": err.Error()})
		return
	}

	c.JSON(http.StatusOK, permissions)
}

// CheckUserPermission checks if the current user has specific permission for a document
// @Summary Check user permission
// @Description Check if the current user has specific permission for a document
// @Tags document-permissions
// @Produce json
// @Param document_id path int true "Document ID"
// @Param permission_type query string true "Permission type" Enums(read, write, admin, comment)
// @Success 200 {object} map[string]bool
// @Failure 400 {object} map[string]string
// @Failure 401 {object} map[string]string
// @Failure 500 {object} map[string]string
// @Router /api/v1/documents/{document_id}/check-permission [get]
func (h *DocumentPermissionHandler) CheckUserPermission(c *gin.Context) {
	userID := utils.GetUserIDFromContext(c)
	if userID == 0 {
		c.JSON(http.StatusUnauthorized, gin.H{"error": "Unauthorized"})
		return
	}

	documentIDStr := c.Param("document_id")
	documentID, err := strconv.Atoi(documentIDStr)
	if err != nil {
		c.JSON(http.StatusBadRequest, gin.H{"error": "Invalid document ID"})
		return
	}

	permissionType := c.Query("permission_type")
	if permissionType == "" {
		c.JSON(http.StatusBadRequest, gin.H{"error": "Permission type is required"})
		return
	}

	hasPermission, err := h.repo.CheckUserPermission(c.Request.Context(), documentID, userID, permissionType)
	if err != nil {
		c.JSON(http.StatusInternalServerError, gin.H{"error": err.Error()})
		return
	}

	c.JSON(http.StatusOK, gin.H{"has_permission": hasPermission})
}

// UpdatePermission updates an existing permission
// @Summary Update document permission
// @Description Update an existing document permission
// @Tags document-permissions
// @Accept json
// @Produce json
// @Param permission_id path int true "Permission ID"
// @Param request body models.UpdateDocumentPermissionRequest true "Update permission request"
// @Success 200 {object} models.DocumentPermission
// @Failure 400 {object} map[string]string
// @Failure 401 {object} map[string]string
// @Failure 404 {object} map[string]string
// @Failure 500 {object} map[string]string
// @Router /api/v1/document-permissions/{permission_id} [put]
func (h *DocumentPermissionHandler) UpdatePermission(c *gin.Context) {
	userID := utils.GetUserIDFromContext(c)
	if userID == 0 {
		c.JSON(http.StatusUnauthorized, gin.H{"error": "Unauthorized"})
		return
	}

	permissionIDStr := c.Param("permission_id")
	permissionID, err := strconv.Atoi(permissionIDStr)
	if err != nil {
		c.JSON(http.StatusBadRequest, gin.H{"error": "Invalid permission ID"})
		return
	}

	var req models.UpdateDocumentPermissionRequest
	if err := c.ShouldBindJSON(&req); err != nil {
		c.JSON(http.StatusBadRequest, gin.H{"error": err.Error()})
		return
	}

	permission, err := h.repo.UpdatePermission(c.Request.Context(), permissionID, &req, userID)
	if err != nil {
		if err.Error() == "permission not found or access denied" {
			c.JSON(http.StatusNotFound, gin.H{"error": "Permission not found"})
			return
		}
		c.JSON(http.StatusInternalServerError, gin.H{"error": err.Error()})
		return
	}

	c.JSON(http.StatusOK, permission)
}

// RevokePermission revokes a permission
// @Summary Revoke document permission
// @Description Revoke a document permission
// @Tags document-permissions
// @Param permission_id path int true "Permission ID"
// @Success 204
// @Failure 400 {object} map[string]string
// @Failure 401 {object} map[string]string
// @Failure 404 {object} map[string]string
// @Failure 500 {object} map[string]string
// @Router /api/v1/document-permissions/{permission_id} [delete]
func (h *DocumentPermissionHandler) RevokePermission(c *gin.Context) {
	userID := utils.GetUserIDFromContext(c)
	if userID == 0 {
		c.JSON(http.StatusUnauthorized, gin.H{"error": "Unauthorized"})
		return
	}

	permissionIDStr := c.Param("permission_id")
	permissionID, err := strconv.Atoi(permissionIDStr)
	if err != nil {
		c.JSON(http.StatusBadRequest, gin.H{"error": "Invalid permission ID"})
		return
	}

	err = h.repo.RevokePermission(c.Request.Context(), permissionID, userID)
	if err != nil {
		if err.Error() == "permission not found or access denied" {
			c.JSON(http.StatusNotFound, gin.H{"error": "Permission not found"})
			return
		}
		c.JSON(http.StatusInternalServerError, gin.H{"error": err.Error()})
		return
	}

	c.Status(http.StatusNoContent)
}

