		return
	}

	c.JSON(http.StatusOK, shares)
}

// GetShareByToken retrieves a share by its token
// @Summary Get share by token
// @Description Get a shareable link by its token
// @Tags document-shares
// @Produce json
// @Param token path string true "Share token"
// @Success 200 {object} models.DocumentShare
// @Failure 404 {object} map[string]string
// @Failure 500 {object} map[string]string
// @Router /api/v1/shares/{token} [get]
func (h *DocumentPermissionHandler) GetShareByToken(c *gin.Context) {
	token := c.Param("token")
	if token == "" {
		c.JSON(http.StatusBadRequest, gin.H{"error": "Token is required"})
		return
	}

	share, err := h.repo.GetShareByToken(c.Request.Context(), token)
	if err != nil {
		if err.Error() == "share not found" {
			c.JSON(http.StatusNotFound, gin.H{"error": "Share not found"})
			return
		}
		c.JSON(http.StatusInternalServerError, gin.H{"error": err.Error()})
		return
	}

	// Check if share is still valid
	if !share.IsActive {
		c.JSON(http.StatusNotFound, gin.H{"error": "Share is no longer active"})
		return
	}

	if share.ExpiresAt != nil && share.ExpiresAt.Before(time.Now()) {
		c.JSON(http.StatusNotFound, gin.H{"error": "Share has expired"})
		return
	}

	c.JSON(http.StatusOK, share)
}

// UpdateShare updates a document share
