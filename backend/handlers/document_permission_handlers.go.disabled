	if err != nil {
		c.JSON(http.StatusBadRequest, gin.H{"error": "Invalid share ID"})
		return
	}

	err = h.repo.DeleteShare(c.Request.Context(), shareID, userID)
	if err != nil {
		if err.Error() == "share not found or access denied" {
