// @Description Delete a document share
// @Tags document-shares
// @Param share_id path int true "Share ID"
// @Success 204
// @Failure 400 {object} map[string]string
// @Failure 401 {object} map[string]string
// @Failure 404 {object} map[string]string
// @Failure 500 {object} map[string]string
// @Router /api/v1/document-shares/{share_id} [delete]
func (h *DocumentPermissionHandler) DeleteShare(c *gin.Context) {
	userID := utils.GetUserIDFromContext(c)
	if userID == 0 {
		c.JSON(http.StatusUnauthorized, gin.H{"error": "Unauthorized"})
		return
	}

	shareIDStr := c.Param("share_id")
