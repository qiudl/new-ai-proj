// @Failure 401 {object} models.APIResponse[interface{}]
// @Failure 500 {object} models.APIResponse[interface{}]
// @Router /api/v1/document-folders/tree [get]
func (h *DocumentFolderHandlers) GetFolderTree(c *gin.Context) {
	userID, exists := c.Get("user_id")
	if !exists {
		c.JSON(http.StatusUnauthorized, models.APIResponse{
			Success: false,
			Message: "Unauthorized",
		})
		return
	}

	visibility := c.Query("visibility")

	response, err := h.db.DocumentFolders().GetTree(c.Request.Context(), userID.(int), visibility)
	if err != nil {
		c.JSON(http.StatusInternalServerError, models.APIResponse{
			Success: false,
			Message: "Failed to get folder tree",
			Error:   err.Error(),
		})
		return
	}

	c.JSON(http.StatusOK, models.APIResponse[*models.FolderTreeResponse]{
		Success: true,
		Message: "Folder tree retrieved successfully",
		Data:    response,
	})
}

