// GetFolderDocuments retrieves documents in a folder
// @Summary Get documents in folder
// @Description Get all documents within a specific folder
// @Tags document-folders
// @Produce json
// @Param id path int true "Folder ID (use 'root' for root folder)"
// @Param limit query int false "Number of documents to return (default 50)"
// @Param offset query int false "Number of documents to skip (default 0)"
// @Success 200 {object} models.APIResponse[map[string]interface{}]
// @Failure 400 {object} models.APIResponse[interface{}]
// @Failure 401 {object} models.APIResponse[interface{}]
// @Failure 500 {object} models.APIResponse[interface{}]
// @Router /api/v1/document-folders/{id}/documents [get]
func (h *DocumentFolderHandlers) GetFolderDocuments(c *gin.Context) {
	userID, exists := c.Get("user_id")
	if !exists {
		c.JSON(http.StatusUnauthorized, models.APIResponse{
			Success: false,
			Message: "Unauthorized",
		})
		return
	}

	idStr := c.Param("id")
	var folderID *int
	
	if idStr != "root" {
		id, err := strconv.Atoi(idStr)
		if err != nil {
			c.JSON(http.StatusBadRequest, models.APIResponse{
				Success: false,
				Message: "Invalid folder ID",
			})
			return
		}
		folderID = &id
	}

	limitStr := c.DefaultQuery("limit", "50")
	limit, err := strconv.Atoi(limitStr)
	if err != nil {
		c.JSON(http.StatusBadRequest, models.APIResponse{
			Success: false,
			Message: "Invalid limit parameter",
		})
		return
	}

	offsetStr := c.DefaultQuery("offset", "0")
	offset, err := strconv.Atoi(offsetStr)
	if err != nil {
		c.JSON(http.StatusBadRequest, models.APIResponse{
			Success: false,
			Message: "Invalid offset parameter",
		})
		return
	}

	documents, totalCount, err := h.db.DocumentFolders().GetDocumentsByFolder(c.Request.Context(), folderID, userID.(int), limit, offset)
	if err != nil {
		c.JSON(http.StatusInternalServerError, models.APIResponse{
			Success: false,
			Message: "Failed to get folder documents",
			Error:   err.Error(),
		})
		return
	}

	response := map[string]interface{}{
		"documents":   documents,
		"total_count": totalCount,
		"has_more":    (offset + limit) < totalCount,
	}

	c.JSON(http.StatusOK, models.APIResponse[map[string]interface{}]{
		Success: true,
		Message: "Folder documents retrieved successfully",
		Data:    response,
	})
}

// MoveDocument moves a document to a different folder
// @Summary Move document to folder
// @Description Move a document from one folder to another
// @Tags document-folders
// @Accept json
// @Produce json
// @Param document_id path int true "Document ID"
// @Param folder_id path int true "Target folder ID (use 'root' for root folder)"
// @Success 200 {object} models.APIResponse[interface{}]
// @Failure 400 {object} models.APIResponse[interface{}]
// @Failure 401 {object} models.APIResponse[interface{}]
// @Failure 403 {object} models.APIResponse[interface{}]
// @Failure 500 {object} models.APIResponse[interface{}]
// @Router /api/v1/document-folders/move-document/{document_id}/to/{folder_id} [post]
func (h *DocumentFolderHandlers) MoveDocument(c *gin.Context) {
	userID, exists := c.Get("user_id")
	if !exists {
		c.JSON(http.StatusUnauthorized, models.APIResponse{
			Success: false,
			Message: "Unauthorized",
		})
		return
	}

	documentIDStr := c.Param("document_id")
	documentID, err := strconv.Atoi(documentIDStr)
	if err != nil {
		c.JSON(http.StatusBadRequest, models.APIResponse{
			Success: false,
			Message: "Invalid document ID",
		})
		return
	}

	folderIDStr := c.Param("folder_id")
	var targetFolderID *int
	
	if folderIDStr != "root" {
		id, err := strconv.Atoi(folderIDStr)
		if err != nil {
			c.JSON(http.StatusBadRequest, models.APIResponse{
				Success: false,
				Message: "Invalid folder ID",
			})
			return
		}
		targetFolderID = &id
	}

	err = h.db.DocumentFolders().MoveDocument(c.Request.Context(), documentID, targetFolderID, userID.(int))
	if err != nil {
		status := http.StatusInternalServerError
		if err.Error() == "document not found or permission denied" {
			status = http.StatusForbidden
		}
		c.JSON(status, models.APIResponse{
			Success: false,
			Message: "Failed to move document",
			Error:   err.Error(),
		})
		return
	}

	c.JSON(http.StatusOK, models.APIResponse{
		Success: true,
		Message: "Document moved successfully",
	})
}

// GetUserFolderStats retrieves user's folder statistics
// @Summary Get user folder statistics
// @Description Get statistics about all folders owned by the current user
// @Tags document-folders
