package handlers

import (
	"ai-project-backend/database"
	"ai-project-backend/models"
	"net/http"
	"strconv"

	"github.com/gin-gonic/gin"
)

// DocumentFolderHandlers handles document folder related HTTP requests
type DocumentFolderHandlers struct {
	db database.DB
}

// NewDocumentFolderHandlers creates a new document folder handlers instance
func NewDocumentFolderHandlers(db database.DB) *DocumentFolderHandlers {
	return &DocumentFolderHandlers{
		db: db,
	}
}

// CreateFolder creates a new document folder
// @Summary Create a new document folder
// @Description Create a new document folder with the provided information
// @Tags document-folders
// @Accept json
// @Produce json
// @Param folder body models.CreateDocumentFolderRequest true "Folder creation request"
// @Success 201 {object} models.APIResponse[models.DocumentFolder]
// @Failure 400 {object} models.APIResponse[interface{}]
// @Failure 401 {object} models.APIResponse[interface{}]
// @Failure 500 {object} models.APIResponse[interface{}]
// @Router /api/v1/document-folders [post]
func (h *DocumentFolderHandlers) CreateFolder(c *gin.Context) {
	userID, exists := c.Get("user_id")
	if !exists {
		c.JSON(http.StatusUnauthorized, models.APIResponse{
			Success: false,
			Message: "Unauthorized",
		})
		return
	}

	var req models.CreateDocumentFolderRequest
	if err := c.ShouldBindJSON(&req); err != nil {
		c.JSON(http.StatusBadRequest, models.APIResponse{
			Success: false,
			Message: "Invalid request format",
			Error:   err.Error(),
		})
		return
	}

	folder, err := h.db.DocumentFolders().Create(c.Request.Context(), &req, userID.(int))
	if err != nil {
		c.JSON(http.StatusInternalServerError, models.APIResponse{
			Success: false,
			Message: "Failed to create folder",
			Error:   err.Error(),
		})
		return
	}

	c.JSON(http.StatusCreated, models.APIResponse{
		Success: true,
		Message: "Folder created successfully",
		Data:    folder,
	})
}

// GetFolder retrieves a folder by ID
// @Summary Get a document folder by ID
// @Description Retrieve detailed information about a specific document folder
// @Tags document-folders
// @Produce json
// @Param id path int true "Folder ID"
// @Success 200 {object} models.APIResponse[models.DocumentFolder]
// @Failure 400 {object} models.APIResponse[interface{}]
// @Failure 404 {object} models.APIResponse[interface{}]
// @Failure 500 {object} models.APIResponse[interface{}]
// @Router /api/v1/document-folders/{id} [get]
func (h *DocumentFolderHandlers) GetFolder(c *gin.Context) {
	idStr := c.Param("id")
	id, err := strconv.Atoi(idStr)
	if err != nil {
		c.JSON(http.StatusBadRequest, models.APIResponse{
			Success: false,
			Message: "Invalid folder ID",
		})
		return
	}

	folder, err := h.db.DocumentFolders().GetByID(c.Request.Context(), id)
	if err != nil {
		status := http.StatusInternalServerError
		if err.Error() == "folder not found" {
			status = http.StatusNotFound
		}
		c.JSON(status, models.APIResponse{
			Success: false,
			Message: "Failed to get folder",
			Error:   err.Error(),
		})
		return
	}

	c.JSON(http.StatusOK, models.APIResponse{
		Success: true,
		Message: "Folder retrieved successfully",
		Data:    folder,
	})
}

// UpdateFolder updates a folder
// @Summary Update a document folder
// @Description Update an existing document folder with new information
// @Tags document-folders
// @Accept json
// @Produce json
// @Param id path int true "Folder ID"
// @Param folder body models.UpdateDocumentFolderRequest true "Folder update request"
// @Success 200 {object} models.APIResponse[models.DocumentFolder]
// @Failure 400 {object} models.APIResponse[interface{}]
// @Failure 401 {object} models.APIResponse[interface{}]
// @Failure 403 {object} models.APIResponse[interface{}]
// @Failure 404 {object} models.APIResponse[interface{}]
// @Failure 500 {object} models.APIResponse[interface{}]
// @Router /api/v1/document-folders/{id} [put]
func (h *DocumentFolderHandlers) UpdateFolder(c *gin.Context) {
	userID, exists := c.Get("user_id")
	if !exists {
		c.JSON(http.StatusUnauthorized, models.APIResponse{
			Success: false,
			Message: "Unauthorized",
		})
		return
	}

	idStr := c.Param("id")
	id, err := strconv.Atoi(idStr)
	if err != nil {
		c.JSON(http.StatusBadRequest, models.APIResponse{
			Success: false,
			Message: "Invalid folder ID",
		})
		return
	}

	var req models.UpdateDocumentFolderRequest
	if err := c.ShouldBindJSON(&req); err != nil {
		c.JSON(http.StatusBadRequest, models.APIResponse{
			Success: false,
			Message: "Invalid request format",
			Error:   err.Error(),
		})
		return
	}

	folder, err := h.db.DocumentFolders().Update(c.Request.Context(), id, &req, userID.(int))
	if err != nil {
		status := http.StatusInternalServerError
		if err.Error() == "folder not found" {
			status = http.StatusNotFound
		} else if err.Error() == "permission denied: not folder owner" {
			status = http.StatusForbidden
		}
		c.JSON(status, models.APIResponse{
			Success: false,
			Message: "Failed to update folder",
			Error:   err.Error(),
		})
		return
	}

	c.JSON(http.StatusOK, models.APIResponse{
		Success: true,
		Message: "Folder updated successfully",
		Data:    folder,
	})
}

// DeleteFolder deletes a folder
// @Summary Delete a document folder
// @Description Soft delete a document folder (move to recycle bin)
// @Tags document-folders
// @Produce json
// @Param id path int true "Folder ID"
// @Success 200 {object} models.APIResponse[interface{}]
// @Failure 400 {object} models.APIResponse[interface{}]
// @Failure 401 {object} models.APIResponse[interface{}]
// @Failure 403 {object} models.APIResponse[interface{}]
// @Failure 409 {object} models.APIResponse[interface{}]
// @Failure 500 {object} models.APIResponse[interface{}]
// @Router /api/v1/document-folders/{id} [delete]
func (h *DocumentFolderHandlers) DeleteFolder(c *gin.Context) {
	userID, exists := c.Get("user_id")
	if !exists {
		c.JSON(http.StatusUnauthorized, models.APIResponse{
			Success: false,
			Message: "Unauthorized",
		})
		return
	}

	idStr := c.Param("id")
	id, err := strconv.Atoi(idStr)
	if err != nil {
		c.JSON(http.StatusBadRequest, models.APIResponse{
			Success: false,
			Message: "Invalid folder ID",
		})
		return
	}

	err = h.db.DocumentFolders().Delete(c.Request.Context(), id, userID.(int))
	if err != nil {
		status := http.StatusInternalServerError
		if err.Error() == "folder not found" {
			status = http.StatusNotFound
		} else if err.Error() == "permission denied: not folder owner" {
			status = http.StatusForbidden
		} else if err.Error() == "cannot delete folder with children" {
			status = http.StatusConflict
		}
		c.JSON(status, models.APIResponse{
			Success: false,
			Message: "Failed to delete folder",
			Error:   err.Error(),
		})
		return
	}

	c.JSON(http.StatusOK, models.APIResponse{
		Success: true,
		Message: "Folder deleted successfully",
	})
}

// ListFolders lists folders based on criteria
// @Summary List document folders
// @Description Get a list of document folders based on various filters
// @Tags document-folders
// @Produce json
// @Param parent_folder_id query int false "Parent folder ID (null for root folders)"
// @Param visibility query string false "Visibility filter (private, team, public)"
// @Param owner_id query int false "Owner ID filter"
// @Param include_stats query bool false "Include folder statistics"
// @Param limit query int false "Number of folders to return (default 50)"
// @Param offset query int false "Number of folders to skip (default 0)"
// @Success 200 {object} models.APIResponse[models.ListFoldersResponse]
// @Failure 400 {object} models.APIResponse[interface{}]
// @Failure 401 {object} models.APIResponse[interface{}]
// @Failure 500 {object} models.APIResponse[interface{}]
// @Router /api/v1/document-folders [get]
func (h *DocumentFolderHandlers) ListFolders(c *gin.Context) {
	userID, exists := c.Get("user_id")
	if !exists {
		c.JSON(http.StatusUnauthorized, models.APIResponse{
			Success: false,
			Message: "Unauthorized",
		})
		return
	}

	var req models.ListFoldersRequest
	if err := c.ShouldBindQuery(&req); err != nil {
		c.JSON(http.StatusBadRequest, models.APIResponse{
			Success: false,
			Message: "Invalid query parameters",
			Error:   err.Error(),
		})
		return
	}

	// Set default values
	if req.Limit == 0 {
		req.Limit = 50
	}

	response, err := h.db.DocumentFolders().List(c.Request.Context(), &req, userID.(int))
	if err != nil {
		c.JSON(http.StatusInternalServerError, models.APIResponse{
			Success: false,
			Message: "Failed to list folders",
			Error:   err.Error(),
		})
		return
	}

	c.JSON(http.StatusOK, models.APIResponse[*models.ListFoldersResponse]{
		Success: true,
		Message: "Folders retrieved successfully",
		Data:    response,
	})
}

// GetFolderTree retrieves the folder tree structure
// @Summary Get document folder tree
// @Description Retrieve the hierarchical folder tree structure
// @Tags document-folders
// @Produce json
// @Param visibility query string false "Visibility filter (private, team, public)"
