package handlers

import (
	"ai-project-backend/database"
	"ai-project-backend/models"
	"log"
	"net/http"
	"strconv"
	"time"

	"github.com/gin-gonic/gin"
	"github.com/go-playground/validator/v10"
)

// DocumentVersionLabelHandler handles document version label operations
type DocumentVersionLabelHandler struct {
	db       database.DB
	logger   *log.Logger
	validate *validator.Validate
}

// NewDocumentVersionLabelHandler creates a new document version label handler
func NewDocumentVersionLabelHandler(db database.DB, logger *log.Logger, validate *validator.Validate) *DocumentVersionLabelHandler {
	return &DocumentVersionLabelHandler{
		db:       db,
		logger:   logger,
		validate: validate,
	}
}

// CreateLabel creates a new version label
// POST /api/v1/document-version-labels
func (h *DocumentVersionLabelHandler) CreateLabel(c *gin.Context) {
	var req models.CreateVersionLabelRequest
	if err := c.ShouldBindJSON(&req); err != nil {
		c.JSON(http.StatusBadRequest, gin.H{
			"error":   "Invalid request body",
			"details": err.Error(),
		})
		return
	}

	// Validate request
	if err := h.validate.Struct(&req); err != nil {
		c.JSON(http.StatusBadRequest, gin.H{
			"error":   "Validation failed",
			"details": err.Error(),
		})
		return
	}

	// Check if version exists
	version, err := h.db.DocumentVersions().GetByDocumentAndVersion(req.DocumentID, req.VersionNumber)
	if err != nil {
		h.logger.Printf("Error checking version existence: %v", err)
		c.JSON(http.StatusNotFound, gin.H{
			"error": "Document version not found",
		})
		return
	}

	// Check if label already exists for this version
	existingLabels, err := h.db.DocumentVersions().GetVersionLabels(req.DocumentID, req.VersionNumber)
	if err != nil {
		h.logger.Printf("Error checking existing labels: %v", err)
		// Continue - not critical
	} else {
		for _, label := range existingLabels {
			if label.Label == req.Label {
				c.JSON(http.StatusConflict, gin.H{
					"error": "Label already exists for this version",
				})
				return
			}
		}
	}

	// Create label
	label := &models.DocumentVersionLabel{
		DocumentID:    req.DocumentID,
		VersionNumber: req.VersionNumber,
		Label:         req.Label,
		Color:         req.Color,
		Description:   req.Description,
		CreatedBy:     getUserID(c),
		CreatedAt:     time.Now(),
	}

	createdLabel, err := h.db.DocumentVersions().CreateLabel(label)
	if err != nil {
		h.logger.Printf("Error creating version label: %v", err)
		c.JSON(http.StatusInternalServerError, gin.H{
			"error": "Failed to create version label",
		})
		return
	}

	c.JSON(http.StatusCreated, createdLabel)
}

// GetVersionLabels gets all labels for a specific document version
// GET /api/v1/documents/:document_id/versions/:version_number/labels
func (h *DocumentVersionLabelHandler) GetVersionLabels(c *gin.Context) {
	documentID, err := strconv.Atoi(c.Param("document_id"))
	if err != nil {
		c.JSON(http.StatusBadRequest, gin.H{
			"error": "Invalid document ID",
		})
		return
	}

	versionNumber, err := strconv.Atoi(c.Param("version_number"))
	if err != nil {
		c.JSON(http.StatusBadRequest, gin.H{
			"error": "Invalid version number",
		})
		return
	}

	labels, err := h.db.DocumentVersions().GetVersionLabels(documentID, versionNumber)
	if err != nil {
		h.logger.Printf("Error getting version labels: %v", err)
		c.JSON(http.StatusInternalServerError, gin.H{
			"error": "Failed to get version labels",
		})
		return
	}

	c.JSON(http.StatusOK, gin.H{
		"labels": labels,
	})
}

// GetDocumentLabels gets all labels for a document
// GET /api/v1/documents/:document_id/labels
func (h *DocumentVersionLabelHandler) GetDocumentLabels(c *gin.Context) {
	documentID, err := strconv.Atoi(c.Param("document_id"))
	if err != nil {
		c.JSON(http.StatusBadRequest, gin.H{
			"error": "Invalid document ID",
		})
		return
	}

	labels, err := h.db.DocumentVersions().GetAllLabels(documentID)
	if err != nil {
		h.logger.Printf("Error getting document labels: %v", err)
		c.JSON(http.StatusInternalServerError, gin.H{
			"error": "Failed to get document labels",
		})
		return
	}

	c.JSON(http.StatusOK, gin.H{
		"labels": labels,
	})
}

// UpdateLabel updates a version label
// PUT /api/v1/document-version-labels/:id
func (h *DocumentVersionLabelHandler) UpdateLabel(c *gin.Context) {
	labelID, err := strconv.Atoi(c.Param("id"))
	if err != nil {
		c.JSON(http.StatusBadRequest, gin.H{
			"error": "Invalid label ID",
		})
		return
	}

	var req struct {
		Label       *string `json:"label,omitempty" validate:"omitempty,max=100"`
		Color       *string `json:"color,omitempty" validate:"omitempty,hexcolor"`
		Description *string `json:"description,omitempty"`
	}

	if err := c.ShouldBindJSON(&req); err != nil {
		c.JSON(http.StatusBadRequest, gin.H{
			"error":   "Invalid request body",
			"details": err.Error(),
		})
		return
	}

	// Validate request
	if err := h.validate.Struct(&req); err != nil {
		c.JSON(http.StatusBadRequest, gin.H{
			"error":   "Validation failed",
			"details": err.Error(),
		})
		return
	}

	// Get existing label
	existingLabel, err := h.db.DocumentVersions().GetLabelByID(labelID)
	if err != nil {
		h.logger.Printf("Error getting version label: %v", err)
		c.JSON(http.StatusNotFound, gin.H{
			"error": "Version label not found",
		})
		return
	}

	// Update fields
	if req.Label != nil {
		existingLabel.Label = *req.Label
	}
	if req.Color != nil {
		existingLabel.Color = *req.Color
	}
	if req.Description != nil {
		existingLabel.Description = req.Description
	}

	updatedLabel, err := h.db.DocumentVersions().UpdateLabel(existingLabel)
	if err != nil {
		h.logger.Printf("Error updating version label: %v", err)
		c.JSON(http.StatusInternalServerError, gin.H{
			"error": "Failed to update version label",
		})
		return
	}

	c.JSON(http.StatusOK, updatedLabel)
}

// DeleteLabel deletes a version label
// DELETE /api/v1/document-version-labels/:id
func (h *DocumentVersionLabelHandler) DeleteLabel(c *gin.Context) {
	labelID, err := strconv.Atoi(c.Param("id"))
	if err != nil {
		c.JSON(http.StatusBadRequest, gin.H{
			"error": "Invalid label ID",
		})
		return
	}

	// Check if label exists
	_, err = h.db.DocumentVersions().GetLabelByID(labelID)
	if err != nil {
		h.logger.Printf("Error getting version label: %v", err)
		c.JSON(http.StatusNotFound, gin.H{
			"error": "Version label not found",
		})
		return
	}

	// Delete the label
	if err := h.db.DocumentVersions().DeleteLabel(labelID); err != nil {
		h.logger.Printf("Error deleting version label: %v", err)
		c.JSON(http.StatusInternalServerError, gin.H{
			"error": "Failed to delete version label",
		})
		return
	}

	c.JSON(http.StatusOK, gin.H{
		"message": "Version label deleted successfully",
	})
}

// GetLabelsByColor gets all labels with a specific color
// GET /api/v1/document-version-labels/by-color/:color
func (h *DocumentVersionLabelHandler) GetLabelsByColor(c *gin.Context) {
	color := c.Param("color")
	if color == "" {
		c.JSON(http.StatusBadRequest, gin.H{
			"error": "Color parameter is required",
		})
		return
	}

	labels, err := h.db.DocumentVersions().GetLabelsByColor(color)
	if err != nil {
		h.logger.Printf("Error getting labels by color: %v", err)
		c.JSON(http.StatusInternalServerError, gin.H{
			"error": "Failed to get labels by color",
		})
		return
	}

	c.JSON(http.StatusOK, gin.H{
		"labels": labels,
	})
}

// SearchLabels searches labels by name
// GET /api/v1/document-version-labels/search?q=:query
func (h *DocumentVersionLabelHandler) SearchLabels(c *gin.Context) {
	query := c.Query("q")
	if query == "" {
		c.JSON(http.StatusBadRequest, gin.H{
			"error": "Search query is required",
		})
		return
	}

	// Parse pagination parameters
	page, _ := strconv.Atoi(c.DefaultQuery("page", "1"))
	pageSize, _ := strconv.Atoi(c.DefaultQuery("page_size", "20"))
	
	if page < 1 {
		page = 1
	}
	if pageSize < 1 || pageSize > 100 {
		pageSize = 20
	}

	labels, totalCount, err := h.db.DocumentVersions().SearchLabels(query, page, pageSize)
	if err != nil {
		h.logger.Printf("Error searching version labels: %v", err)
		c.JSON(http.StatusInternalServerError, gin.H{
			"error": "Failed to search version labels",
		})
		return
	}

	c.JSON(http.StatusOK, gin.H{
		"labels":       labels,
		"total_count":  totalCount,
		"current_page": page,
		"page_size":    pageSize,
		"has_more":     (page * pageSize) < totalCount,
	})
}