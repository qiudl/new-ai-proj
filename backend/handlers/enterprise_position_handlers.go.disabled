// RemoveUserFromPosition 移除用户岗位
func (h *EnterprisePositionHandler) RemoveUserFromPosition(w http.ResponseWriter, r *http.Request) {
	vars := mux.Vars(r)
	userID, err := strconv.Atoi(vars["user_id"])
	if err != nil {
		http.Error(w, "无效的用户ID", http.StatusBadRequest)
		return
	}

	positionID, err := strconv.Atoi(vars["position_id"])
	if err != nil {
		http.Error(w, "无效的岗位ID", http.StatusBadRequest)
		return
	}

	err = h.positionService.RemoveUserFromPosition(userID, positionID)
	if err != nil {
		http.Error(w, "移除用户岗位失败: "+err.Error(), http.StatusInternalServerError)
		return
	}

	w.Header().Set("Content-Type", "application/json")
	json.NewEncoder(w).Encode(map[string]interface{}{
		"success": true,
		"message": "用户岗位移除成功",
	})
}

