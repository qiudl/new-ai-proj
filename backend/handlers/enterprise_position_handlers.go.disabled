// ClonePosition 克隆岗位
func (h *EnterprisePositionHandler) ClonePosition(w http.ResponseWriter, r *http.Request) {
	vars := mux.Vars(r)
	sourceID, err := strconv.Atoi(vars["id"])
	if err != nil {
		http.Error(w, "无效的岗位ID", http.StatusBadRequest)
		return
	}

	var req struct {
		NewCode string `json:"new_code" validate:"required,max=50"`
		NewName string `json:"new_name" validate:"required,max=100"`
	}

	if err := json.NewDecoder(r.Body).Decode(&req); err != nil {
		http.Error(w, "无效的请求数据: "+err.Error(), http.StatusBadRequest)
		return
	}

	// 验证请求数据
	if err := validateStruct(&req); err != nil {
		http.Error(w, "数据验证失败: "+err.Error(), http.StatusBadRequest)
		return
	}

	// 获取当前用户ID
	userID := getUserIDFromContext(r.Context())

	position, err := h.positionService.ClonePosition(sourceID, req.NewCode, req.NewName, userID)
	if err != nil {
		http.Error(w, "克隆岗位失败: "+err.Error(), http.StatusInternalServerError)
		return
	}

	w.Header().Set("Content-Type", "application/json")
	json.NewEncoder(w).Encode(map[string]interface{}{
		"success": true,
		"message": "岗位克隆成功",
		"data":    position,
	})
}

// BatchUpdatePositionStatus 批量更新岗位状态
func (h *EnterprisePositionHandler) BatchUpdatePositionStatus(w http.ResponseWriter, r *http.Request) {
	var req struct {
		PositionIDs []int  `json:"position_ids" validate:"required,min=1"`
		Status      string `json:"status" validate:"required,oneof=active inactive frozen"`
	}

	if err := json.NewDecoder(r.Body).Decode(&req); err != nil {
		http.Error(w, "无效的请求数据: "+err.Error(), http.StatusBadRequest)
		return
	}

	// 验证请求数据
	if err := validateStruct(&req); err != nil {
		http.Error(w, "数据验证失败: "+err.Error(), http.StatusBadRequest)
		return
	}

	// 获取当前用户ID
	userID := getUserIDFromContext(r.Context())

	err := h.positionService.BatchUpdatePositionStatus(req.PositionIDs, req.Status, userID)
	if err != nil {
		http.Error(w, "批量更新岗位状态失败: "+err.Error(), http.StatusInternalServerError)
		return
	}

	w.Header().Set("Content-Type", "application/json")
	json.NewEncoder(w).Encode(map[string]interface{}{
		"success": true,
		"message": "岗位状态更新成功",
	})
}