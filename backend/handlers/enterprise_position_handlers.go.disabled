package handlers

import (
	"encoding/json"
	"net/http"
	"strconv"

	"github.com/gorilla/mux"

	"ai-project-backend/models"
	"ai-project-backend/services"
)

type EnterprisePositionHandler struct {
	positionService *services.EnterprisePositionService
	roleService     *services.EnterpriseRoleService
}

func NewEnterprisePositionHandler(
	positionService *services.EnterprisePositionService,
	roleService *services.EnterpriseRoleService,
) *EnterprisePositionHandler {
	return &EnterprisePositionHandler{
		positionService: positionService,
		roleService:     roleService,
	}
}

// CreatePosition 创建岗位
func (h *EnterprisePositionHandler) CreatePosition(w http.ResponseWriter, r *http.Request) {
	var req models.CreatePositionRequest
	if err := json.NewDecoder(r.Body).Decode(&req); err != nil {
		http.Error(w, "无效的请求数据: "+err.Error(), http.StatusBadRequest)
		return
	}

	// 验证请求数据
	if err := validateStruct(&req); err != nil {
		http.Error(w, "数据验证失败: "+err.Error(), http.StatusBadRequest)
		return
	}

	// 获取当前用户ID（从认证中间件获取）
	userID := getUserIDFromContext(r.Context())

	position, err := h.positionService.CreatePosition(&req, userID)
	if err != nil {
		http.Error(w, "创建岗位失败: "+err.Error(), http.StatusInternalServerError)
		return
	}

	w.Header().Set("Content-Type", "application/json")
	json.NewEncoder(w).Encode(map[string]interface{}{
		"success": true,
		"message": "岗位创建成功",
		"data":    position,
	})
}

// GetPositionByID 获取岗位详情
func (h *EnterprisePositionHandler) GetPositionByID(w http.ResponseWriter, r *http.Request) {
	vars := mux.Vars(r)
	positionID, err := strconv.Atoi(vars["id"])
	if err != nil {
		http.Error(w, "无效的岗位ID", http.StatusBadRequest)
		return
	}

	includeRelated := r.URL.Query().Get("include_related") == "true"

	position, err := h.positionService.GetPositionByID(positionID, includeRelated)
	if err != nil {
		http.Error(w, "获取岗位失败: "+err.Error(), http.StatusNotFound)
		return
	}

	w.Header().Set("Content-Type", "application/json")
	json.NewEncoder(w).Encode(map[string]interface{}{
		"success": true,
		"data":    position,
	})
}

// GetPositionsByEnterpriseID 获取企业岗位列表
func (h *EnterprisePositionHandler) GetPositionsByEnterpriseID(w http.ResponseWriter, r *http.Request) {
	vars := mux.Vars(r)
	enterpriseID, err := strconv.Atoi(vars["enterprise_id"])
	if err != nil {
		http.Error(w, "无效的企业ID", http.StatusBadRequest)
		return
	}

	page := 1
	pageSize := 20

	if p := r.URL.Query().Get("page"); p != "" {
		if parsed, err := strconv.Atoi(p); err == nil && parsed > 0 {
			page = parsed
		}
	}

	if ps := r.URL.Query().Get("page_size"); ps != "" {
		if parsed, err := strconv.Atoi(ps); err == nil && parsed > 0 && parsed <= 100 {
			pageSize = parsed
		}
	}

	response, err := h.positionService.GetPositionsByEnterpriseID(enterpriseID, page, pageSize)
	if err != nil {
		http.Error(w, "获取岗位列表失败: "+err.Error(), http.StatusInternalServerError)
		return
	}

	w.Header().Set("Content-Type", "application/json")
	json.NewEncoder(w).Encode(map[string]interface{}{
		"success": true,
		"data":    response,
	})
}

// UpdatePosition 更新岗位
func (h *EnterprisePositionHandler) UpdatePosition(w http.ResponseWriter, r *http.Request) {
	vars := mux.Vars(r)
	positionID, err := strconv.Atoi(vars["id"])
	if err != nil {
		http.Error(w, "无效的岗位ID", http.StatusBadRequest)
		return
	}

	var req models.UpdatePositionRequest
	if err := json.NewDecoder(r.Body).Decode(&req); err != nil {
		http.Error(w, "无效的请求数据: "+err.Error(), http.StatusBadRequest)
		return
	}

	// 验证请求数据
	if err := validateStruct(&req); err != nil {
		http.Error(w, "数据验证失败: "+err.Error(), http.StatusBadRequest)
		return
	}

	// 获取当前用户ID
	userID := getUserIDFromContext(r.Context())

	position, err := h.positionService.UpdatePosition(positionID, &req, userID)
	if err != nil {
		http.Error(w, "更新岗位失败: "+err.Error(), http.StatusInternalServerError)
		return
	}

	w.Header().Set("Content-Type", "application/json")
	json.NewEncoder(w).Encode(map[string]interface{}{
		"success": true,
		"message": "岗位更新成功",
		"data":    position,
	})
}

