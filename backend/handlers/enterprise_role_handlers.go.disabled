// CreateRoleFromTemplate 从模板创建角色
func (h *EnterpriseRoleHandler) CreateRoleFromTemplate(w http.ResponseWriter, r *http.Request) {
	var req struct {
		EnterpriseID int    `json:"enterprise_id" validate:"required"`
		TemplateID   int    `json:"template_id" validate:"required"`
		RoleCode     string `json:"role_code" validate:"required,max=50"`
		RoleName     string `json:"role_name" validate:"required,max=100"`
	}

	if err := json.NewDecoder(r.Body).Decode(&req); err != nil {
		http.Error(w, "无效的请求数据: "+err.Error(), http.StatusBadRequest)
		return
	}

	// 验证请求数据
	if err := validateStruct(&req); err != nil {
		http.Error(w, "数据验证失败: "+err.Error(), http.StatusBadRequest)
		return
	}

	// 获取当前用户ID
	userID := getUserIDFromContext(r.Context())

	role, err := h.roleService.CreateRoleFromTemplate(req.EnterpriseID, req.TemplateID, req.RoleCode, req.RoleName, userID)
	if err != nil {
		http.Error(w, "从模板创建角色失败: "+err.Error(), http.StatusInternalServerError)
		return
	}

	w.Header().Set("Content-Type", "application/json")
	json.NewEncoder(w).Encode(map[string]interface{}{
		"success": true,
		"message": "角色创建成功",
		"data":    role,
	})
}

