package handlers

import (
	"encoding/json"
	"net/http"
	"strconv"

	"github.com/gorilla/mux"

	"ai-project-backend/models"
	"ai-project-backend/services"
)

type EnterpriseRoleHandler struct {
	roleService     *services.EnterpriseRoleService
	positionService *services.EnterprisePositionService
}

func NewEnterpriseRoleHandler(
	roleService *services.EnterpriseRoleService,
	positionService *services.EnterprisePositionService,
) *EnterpriseRoleHandler {
	return &EnterpriseRoleHandler{
		roleService:     roleService,
		positionService: positionService,
	}
}

// CreateRole 创建角色
func (h *EnterpriseRoleHandler) CreateRole(w http.ResponseWriter, r *http.Request) {
	var req models.CreateRoleRequest
	if err := json.NewDecoder(r.Body).Decode(&req); err != nil {
		http.Error(w, "无效的请求数据: "+err.Error(), http.StatusBadRequest)
		return
	}

	// 验证请求数据
	if err := validateStruct(&req); err != nil {
		http.Error(w, "数据验证失败: "+err.Error(), http.StatusBadRequest)
		return
	}

	// 获取当前用户ID
	userID := getUserIDFromContext(r.Context())

	role, err := h.roleService.CreateRole(&req, userID)
	if err != nil {
		http.Error(w, "创建角色失败: "+err.Error(), http.StatusInternalServerError)
		return
	}

	w.Header().Set("Content-Type", "application/json")
	json.NewEncoder(w).Encode(map[string]interface{}{
		"success": true,
		"message": "角色创建成功",
		"data":    role,
	})
}

// GetRoleByID 获取角色详情
func (h *EnterpriseRoleHandler) GetRoleByID(w http.ResponseWriter, r *http.Request) {
	vars := mux.Vars(r)
	roleID, err := strconv.Atoi(vars["id"])
	if err != nil {
		http.Error(w, "无效的角色ID", http.StatusBadRequest)
		return
	}

	includeRelated := r.URL.Query().Get("include_related") == "true"

	role, err := h.roleService.GetRoleByID(roleID, includeRelated)
	if err != nil {
		http.Error(w, "获取角色失败: "+err.Error(), http.StatusNotFound)
		return
	}

	w.Header().Set("Content-Type", "application/json")
	json.NewEncoder(w).Encode(map[string]interface{}{
		"success": true,
		"data":    role,
	})
}

// GetRolesByEnterpriseID 获取企业角色列表
func (h *EnterpriseRoleHandler) GetRolesByEnterpriseID(w http.ResponseWriter, r *http.Request) {
	vars := mux.Vars(r)
	enterpriseID, err := strconv.Atoi(vars["enterprise_id"])
	if err != nil {
		http.Error(w, "无效的企业ID", http.StatusBadRequest)
		return
	}

	page := 1
	pageSize := 20

	if p := r.URL.Query().Get("page"); p != "" {
		if parsed, err := strconv.Atoi(p); err == nil && parsed > 0 {
			page = parsed
		}
	}

	if ps := r.URL.Query().Get("page_size"); ps != "" {
		if parsed, err := strconv.Atoi(ps); err == nil && parsed > 0 && parsed <= 100 {
			pageSize = parsed
		}
	}

	response, err := h.roleService.GetRolesByEnterpriseID(enterpriseID, page, pageSize)
	if err != nil {
		http.Error(w, "获取角色列表失败: "+err.Error(), http.StatusInternalServerError)
		return
	}

	w.Header().Set("Content-Type", "application/json")
	json.NewEncoder(w).Encode(map[string]interface{}{
		"success": true,
		"data":    response,
	})
}

// UpdateRole 更新角色
func (h *EnterpriseRoleHandler) UpdateRole(w http.ResponseWriter, r *http.Request) {
	vars := mux.Vars(r)
	roleID, err := strconv.Atoi(vars["id"])
	if err != nil {
		http.Error(w, "无效的角色ID", http.StatusBadRequest)
		return
	}

	var req models.UpdateRoleRequest
	if err := json.NewDecoder(r.Body).Decode(&req); err != nil {
		http.Error(w, "无效的请求数据: "+err.Error(), http.StatusBadRequest)
		return
	}

	// 验证请求数据
	if err := validateStruct(&req); err != nil {
		http.Error(w, "数据验证失败: "+err.Error(), http.StatusBadRequest)
		return
	}

	// 获取当前用户ID
	userID := getUserIDFromContext(r.Context())

	role, err := h.roleService.UpdateRole(roleID, &req, userID)
	if err != nil {
		http.Error(w, "更新角色失败: "+err.Error(), http.StatusInternalServerError)
		return
	}

	w.Header().Set("Content-Type", "application/json")
	json.NewEncoder(w).Encode(map[string]interface{}{
		"success": true,
		"message": "角色更新成功",
		"data":    role,
	})
}

