// CloneRole 克隆角色
func (h *EnterpriseRoleHandler) CloneRole(w http.ResponseWriter, r *http.Request) {
	vars := mux.Vars(r)
	sourceID, err := strconv.Atoi(vars["id"])
	if err != nil {
		http.Error(w, "无效的角色ID", http.StatusBadRequest)
		return
	}

	var req struct {
		NewCode string `json:"new_code" validate:"required,max=50"`
		NewName string `json:"new_name" validate:"required,max=100"`
	}

	if err := json.NewDecoder(r.Body).Decode(&req); err != nil {
		http.Error(w, "无效的请求数据: "+err.Error(), http.StatusBadRequest)
		return
	}

	// 验证请求数据
	if err := validateStruct(&req); err != nil {
		http.Error(w, "数据验证失败: "+err.Error(), http.StatusBadRequest)
		return
	}

	// 获取当前用户ID
	userID := getUserIDFromContext(r.Context())

	role, err := h.roleService.CloneRole(sourceID, req.NewCode, req.NewName, userID)
	if err != nil {
		http.Error(w, "克隆角色失败: "+err.Error(), http.StatusInternalServerError)
		return
	}

	w.Header().Set("Content-Type", "application/json")
	json.NewEncoder(w).Encode(map[string]interface{}{
		"success": true,
		"message": "角色克隆成功",
		"data":    role,
	})
}

// BatchUpdateRoleStatus 批量更新角色状态
func (h *EnterpriseRoleHandler) BatchUpdateRoleStatus(w http.ResponseWriter, r *http.Request) {
	var req struct {
		RoleIDs  []int `json:"role_ids" validate:"required,min=1"`
		IsActive bool  `json:"is_active"`
	}

	if err := json.NewDecoder(r.Body).Decode(&req); err != nil {
		http.Error(w, "无效的请求数据: "+err.Error(), http.StatusBadRequest)
		return
	}

	// 验证请求数据
	if err := validateStruct(&req); err != nil {
		http.Error(w, "数据验证失败: "+err.Error(), http.StatusBadRequest)
		return
	}

	// 获取当前用户ID
	userID := getUserIDFromContext(r.Context())

	err := h.roleService.BatchUpdateRoleStatus(req.RoleIDs, req.IsActive, userID)
	if err != nil {
		http.Error(w, "批量更新角色状态失败: "+err.Error(), http.StatusInternalServerError)
		return
	}

	statusText := "启用"
	if !req.IsActive {
		statusText = "停用"
	}

	w.Header().Set("Content-Type", "application/json")
	json.NewEncoder(w).Encode(map[string]interface{}{
		"success": true,
		"message": "角色" + statusText + "成功",
	})
}

