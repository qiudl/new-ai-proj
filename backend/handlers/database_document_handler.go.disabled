package handlers

import (
	"context"
	"net/http"
	"strconv"
	"time"

	"ai-project-backend/database"
	"ai-project-backend/models"
	"github.com/gin-gonic/gin"
)

// DatabaseDocumentHandler 连接数据库的文档处理器
type DatabaseDocumentHandler struct {
	db database.DB
}

// NewDatabaseDocumentHandler 创建新的数据库文档处理器
func NewDatabaseDocumentHandler(db database.DB) *DatabaseDocumentHandler {
	return &DatabaseDocumentHandler{
		db: db,
	}
}

// GetDocuments 获取文档列表
func (h *DatabaseDocumentHandler) GetDocuments(c *gin.Context) {
	ctx := context.Background()
	
	// 获取查询参数
	folderIDStr := c.Query("folder_id")
	
	// 构建过滤器
	filter := &models.DocumentFilter{
		Page:  1,
		Limit: 100, // 默认限制
	}
	
	var documents []*models.DocumentListResponse
	var total int
	var err error
	
	if folderIDStr != "" {
		// 如果指定了文件夹ID，通过文件夹查询
		folderID, parseErr := strconv.Atoi(folderIDStr)
		if parseErr != nil {
			c.JSON(http.StatusBadRequest, gin.H{
				"success": false,
				"message": "Invalid folder ID",
			})
			return
		}
		
		// 获取用户ID
		userID, exists := c.Get("user_id")
		if !exists {
			c.JSON(http.StatusUnauthorized, gin.H{
				"success": false,
				"message": "Unauthorized",
			})
			return
		}
		
		// 通过文件夹获取文档
		var folderIDPtr *int
		if folderID > 0 {
			folderIDPtr = &folderID
		}
		
		docs, docTotal, err := h.db.DocumentFolders().GetDocumentsByFolder(ctx, folderIDPtr, userID.(int), 100, 0)
		if err != nil {
			c.JSON(http.StatusInternalServerError, gin.H{
				"success": false,
				"message": "Failed to get documents",
				"error":   err.Error(),
			})
			return
		}
		
		// 转换为简化格式
		documents = make([]*models.DocumentListResponse, len(docs))
		for i, doc := range docs {
			documents[i] = &models.DocumentListResponse{
				ID:          doc.ID,
				Title:       doc.Title,
				Type:        doc.Type,
				Status:      doc.Status,
				Description: doc.Description,
				Tags:        doc.Tags,
				OwnerID:     doc.OwnerID,
				Visibility:  doc.Visibility,
				Version:     doc.Version,
				IsTemplate:  doc.IsTemplate,
				CreatedAt:   doc.CreatedAt,
				UpdatedAt:   doc.UpdatedAt,
				CreatedBy:   doc.CreatedBy,
				OwnerName:   doc.OwnerName,
				FolderName:  doc.FolderName,
				ProjectID:   doc.ProjectID,
				ProjectName: doc.ProjectName,
				CustomerID:  doc.CustomerID,
				CustomerName: doc.CustomerName,
				Category:    doc.Category,
			}
		}
		total = docTotal
	} else {
		// 获取所有文档
		documents, total, err = h.db.Documents().GetAllDocumentsWithRelations(ctx, filter)
	}
	
	if err != nil {
		c.JSON(http.StatusInternalServerError, gin.H{
			"success": false,
			"message": "Failed to get documents",
			"error":   err.Error(),
		})
		return
	}
	
	c.JSON(http.StatusOK, gin.H{
		"success": true,
		"message": "Documents retrieved successfully",
		"data":    documents,
		"total":   total,
	})
}

// CreateDocument 创建文档
func (h *DatabaseDocumentHandler) CreateDocument(c *gin.Context) {
	ctx := context.Background()
	
	var req models.CreateDocumentRequest
	if err := c.ShouldBindJSON(&req); err != nil {
		c.JSON(http.StatusBadRequest, gin.H{
			"success": false,
			"message": "Invalid request format",
			"error":   err.Error(),
		})
		return
	}

	// 获取用户ID
	userID, exists := c.Get("user_id")
	if !exists {
		c.JSON(http.StatusUnauthorized, gin.H{
			"success": false,
			"message": "Unauthorized",
		})
		return
	}

	// 构建文档对象
	document := &models.Document{
		FolderID:    req.FolderID,
		Title:       req.Title,
		Content:     req.Content,
		Type:        req.Type,
		Status:      req.Status,
		Description: req.Description,
		Tags:        req.Tags,
		OwnerID:     userID.(int),
		Visibility:  req.Visibility,
		Version:     1,
		IsTemplate:  req.IsTemplate,
		CreatedAt:   time.Now(),
		UpdatedAt:   time.Now(),
		CreatedBy:   userID.(int),
		ProjectID:   req.ProjectID,
		CustomerID:  req.CustomerID,
		Category:    req.Category,
	}

	// 设置默认值
	if document.Status == "" {
		document.Status = models.DocumentStatusDraft
	}
	if document.Visibility == "" {
		document.Visibility = models.VisibilityTeam
	}
	if document.Type == "" {
		document.Type = models.DocumentTypeMarkdown
	}

	// 保存到数据库
	createdDoc, err := h.db.Documents().Create(ctx, document)
	if err != nil {
		c.JSON(http.StatusInternalServerError, gin.H{
			"success": false,
			"message": "Failed to create document",
			"error":   err.Error(),
		})
		return
	}

	c.JSON(http.StatusCreated, gin.H{
		"success": true,
		"message": "Document created successfully",
		"data":    createdDoc,
	})
}

// GetDocument 获取单个文档
func (h *DatabaseDocumentHandler) GetDocument(c *gin.Context) {
	ctx := context.Background()
	
	idStr := c.Param("id")
	id, err := strconv.Atoi(idStr)
	if err != nil {
		c.JSON(http.StatusBadRequest, gin.H{
			"success": false,
			"message": "Invalid document ID",
		})
		return
	}

	document, err := h.db.Documents().GetByID(ctx, id)
	if err != nil {
		c.JSON(http.StatusNotFound, gin.H{
			"success": false,
			"message": "Document not found",
		})
		return
	}

	c.JSON(http.StatusOK, gin.H{
		"success": true,
		"message": "Document retrieved successfully",
		"data":    document,
	})
}

// UpdateDocument 更新文档
func (h *DatabaseDocumentHandler) UpdateDocument(c *gin.Context) {
	ctx := context.Background()
	
	idStr := c.Param("id")
	id, err := strconv.Atoi(idStr)
	if err != nil {
		c.JSON(http.StatusBadRequest, gin.H{
			"success": false,
			"message": "Invalid document ID",
		})
		return
	}

	var req models.UpdateDocumentRequest
	if err := c.ShouldBindJSON(&req); err != nil {
		c.JSON(http.StatusBadRequest, gin.H{
			"success": false,
			"message": "Invalid request format",
			"error":   err.Error(),
		})
		return
	}

	// 获取现有文档
	document, err := h.db.Documents().GetByID(ctx, id)
	if err != nil {
		c.JSON(http.StatusNotFound, gin.H{
			"success": false,
			"message": "Document not found",
		})
		return
	}

	// 更新字段
	if req.Title != nil {
		document.Title = *req.Title
	}
	if req.Content != nil {
		document.Content = req.Content
	}
	if req.Description != nil {
		document.Description = req.Description
	}
	if req.Tags != nil {
		document.Tags = req.Tags
	}
	if req.Status != nil {
		document.Status = *req.Status
	}
	if req.Visibility != nil {
		document.Visibility = *req.Visibility
	}
	if req.IsTemplate != nil {
		document.IsTemplate = *req.IsTemplate
	}
	document.UpdatedAt = time.Now()

	// 保存到数据库
	updatedDoc, err := h.db.Documents().Update(ctx, document)
	if err != nil {
		c.JSON(http.StatusInternalServerError, gin.H{
			"success": false,
			"message": "Failed to update document",
			"error":   err.Error(),
		})
		return
	}

	c.JSON(http.StatusOK, gin.H{
		"success": true,
		"message": "Document updated successfully",
		"data":    updatedDoc,
	})
}

// DeleteDocument 删除文档
func (h *DatabaseDocumentHandler) DeleteDocument(c *gin.Context) {
	ctx := context.Background()
	
	idStr := c.Param("id")
	id, err := strconv.Atoi(idStr)
	if err != nil {
		c.JSON(http.StatusBadRequest, gin.H{
			"success": false,
			"message": "Invalid document ID",
		})
		return
	}

	err = h.db.Documents().Delete(ctx, id)
	if err != nil {
		c.JSON(http.StatusInternalServerError, gin.H{
			"success": false,
			"message": "Failed to delete document",
			"error":   err.Error(),
		})
		return
	}

	c.JSON(http.StatusOK, gin.H{
		"success": true,
		"message": "Document deleted successfully",
	})
}

// CopyDocument 复制文档 (简化实现)
func (h *DatabaseDocumentHandler) CopyDocument(c *gin.Context) {
	ctx := context.Background()
	
	idStr := c.Param("id")
	id, err := strconv.Atoi(idStr)
	if err != nil {
		c.JSON(http.StatusBadRequest, gin.H{
			"success": false,
			"message": "Invalid document ID",
		})
		return
	}

	// 获取用户ID
	userID, exists := c.Get("user_id")
	if !exists {
		c.JSON(http.StatusUnauthorized, gin.H{
			"success": false,
			"message": "Unauthorized",
		})
		return
	}

	// 获取原文档
	originalDoc, err := h.db.Documents().GetByID(ctx, id)
	if err != nil {
		c.JSON(http.StatusNotFound, gin.H{
			"success": false,
			"message": "Document not found",
		})
		return
	}

	// 创建副本
	copyDoc := &models.Document{
		FolderID:    originalDoc.FolderID,
		Title:       originalDoc.Title + " (副本)",
		Content:     originalDoc.Content,
		Type:        originalDoc.Type,
		Status:      models.DocumentStatusDraft, // 副本默认为草稿
		Description: originalDoc.Description,
		Tags:        originalDoc.Tags,
		OwnerID:     userID.(int),
		Visibility:  originalDoc.Visibility,
		Version:     1,
		IsTemplate:  false, // 副本不是模板
		CreatedAt:   time.Now(),
		UpdatedAt:   time.Now(),
		CreatedBy:   userID.(int),
		ProjectID:   originalDoc.ProjectID,
		CustomerID:  originalDoc.CustomerID,
		Category:    originalDoc.Category,
	}

	createdDoc, err := h.db.Documents().Create(ctx, copyDoc)
	if err != nil {
		c.JSON(http.StatusInternalServerError, gin.H{
			"success": false,
			"message": "Failed to copy document",
			"error":   err.Error(),
		})
		return
	}

	c.JSON(http.StatusCreated, gin.H{
		"success": true,
		"message": "Document copied successfully",
		"data":    createdDoc,
	})
}

// ToggleTemplate 切换模板状态
func (h *DatabaseDocumentHandler) ToggleTemplate(c *gin.Context) {
	ctx := context.Background()
	
	idStr := c.Param("id")
	id, err := strconv.Atoi(idStr)
	if err != nil {
		c.JSON(http.StatusBadRequest, gin.H{
			"success": false,
			"message": "Invalid document ID",
		})
		return
	}

	// 获取现有文档
	document, err := h.db.Documents().GetByID(ctx, id)
	if err != nil {
		c.JSON(http.StatusNotFound, gin.H{
			"success": false,
			"message": "Document not found",
		})
		return
	}

	// 切换模板状态
	document.IsTemplate = !document.IsTemplate
	document.UpdatedAt = time.Now()

	// 保存到数据库
	updatedDoc, err := h.db.Documents().Update(ctx, document)
	if err != nil {
		c.JSON(http.StatusInternalServerError, gin.H{
			"success": false,
			"message": "Failed to toggle template status",
			"error":   err.Error(),
		})
		return
	}

	c.JSON(http.StatusOK, gin.H{
		"success": true,
		"message": "Template status toggled successfully",
		"data":    updatedDoc,
	})
}