// DeleteRelation deletes a document relation (generic endpoint that requires entity type)
func (h *DocumentRelationHandler) DeleteRelation(c *gin.Context) {
	entityType := c.Param("entityType")
	relationIDStr := c.Param("id")
	relationID, err := strconv.Atoi(relationIDStr)
	if err != nil {
		c.JSON(http.StatusBadRequest, gin.H{"error": "Invalid relation ID"})
		return
	}

	// Validate entity type
	if entityType != "customer" && entityType != "project" && entityType != "task" {
		c.JSON(http.StatusBadRequest, gin.H{"error": "Invalid entity type. Must be customer, project, or task"})
		return
	}

	// Get current user ID from context
	userID, exists := c.Get("user_id")
	if !exists {
		c.JSON(http.StatusUnauthorized, gin.H{"error": "User not authenticated"})
		return
	}

	ctx := context.TODO()
	if err := h.db.DocumentRelations().DeleteRelation(ctx, entityType, relationID, userID.(int)); err != nil {
		c.JSON(http.StatusInternalServerError, gin.H{"error": "Failed to delete relation", "details": err.Error()})
		return
	}

	c.JSON(http.StatusOK, gin.H{
		"message": "Relation deleted successfully",
	})
}

// GetRelationStats gets statistics about document relations
func (h *DocumentRelationHandler) GetRelationStats(c *gin.Context) {
	// Get current user ID from context
	userID, exists := c.Get("user_id")
	if !exists {
		c.JSON(http.StatusUnauthorized, gin.H{"error": "User not authenticated"})
		return
	}

	// Optional document ID filter
	var documentID *int
	if docIDStr := c.Query("document_id"); docIDStr != "" {
		if docID, err := strconv.Atoi(docIDStr); err == nil {
			documentID = &docID
		}
	}

	ctx := context.TODO()
	stats, err := h.db.DocumentRelations().GetRelationStats(ctx, documentID, userID.(int))
	if err != nil {
		c.JSON(http.StatusInternalServerError, gin.H{"error": "Failed to get relation statistics", "details": err.Error()})
		return
	}

	c.JSON(http.StatusOK, stats)
}

// BulkCreateRelations creates multiple document relations at once
func (h *DocumentRelationHandler) BulkCreateRelations(c *gin.Context) {
	var req []models.AddDocumentRelationRequest
	if err := c.ShouldBindJSON(&req); err != nil {
		c.JSON(http.StatusBadRequest, gin.H{"error": "Invalid request format", "details": err.Error()})
		return
	}

	// Get current user ID from context
	userID, exists := c.Get("user_id")
	if !exists {
		c.JSON(http.StatusUnauthorized, gin.H{"error": "User not authenticated"})
		return
	}

	ctx := context.TODO()
	if err := h.db.DocumentRelations().BulkCreateRelations(ctx, req, userID.(int)); err != nil {
		c.JSON(http.StatusInternalServerError, gin.H{"error": "Failed to create relations", "details": err.Error()})
		return
	}

	c.JSON(http.StatusCreated, gin.H{
		"message": "Document relations created successfully",
		"count":   len(req),
	})
}

