# 简单的Docker文件，在容器内编译Go代码
FROM golang:1.24-alpine AS builder

# 安装git和其他依赖
RUN apk --no-cache add git ca-certificates

# 设置工作目录
WORKDIR /app

# 复制go mod文件
COPY go.mod go.sum ./

# 下载依赖
RUN go mod download

# 复制源代码（只复制需要的核心文件）
COPY main.go ./
COPY config/ ./config/
COPY models/ ./models/
COPY database/ ./database/
COPY utils/ ./utils/
COPY middleware/ ./middleware/
COPY routes/ ./routes/
COPY application/ ./application/
COPY factories/ ./factories/
COPY handlers/auth_handler.go ./handlers/
COPY handlers/auth_refresh_handler.go ./handlers/
COPY handlers/customer_handlers.go ./handlers/
COPY handlers/company_handlers.go ./handlers/
COPY handlers/permission_handlers.go ./handlers/
COPY handlers/user_management_handlers.go ./handlers/
COPY handlers/company_user_handler.go ./handlers/
COPY handlers/hybrid_document_handler.go ./handlers/
COPY handlers/hybrid_document_folder_handler.go ./handlers/
COPY handlers/simple_document_handler.go ./handlers/
COPY handlers/simple_document_folder_handler.go ./handlers/
COPY handlers/unified_document_handler.go ./handlers/
COPY handlers/timer_handlers.go ./handlers/
COPY handlers/user_timer_handlers.go ./handlers/
COPY handlers/unified_timer_handler.go ./handlers/
COPY handlers/task_hierarchy_handlers.go ./handlers/
COPY handlers/user_profile_handlers.go ./handlers/
COPY handlers/ai_config_placeholder_handlers.go ./handlers/
COPY handlers/utility_handlers.go ./handlers/
COPY handlers/archive_handler.go ./handlers/
COPY handlers/recycle_bin_handlers.go ./handlers/
COPY handlers/audit_enhanced_handlers.go ./handlers/
COPY handlers/task_update_handlers.go ./handlers/
COPY handlers/today_tasks_handlers.go ./handlers/
COPY handlers/document_utility_handlers.go ./handlers/
COPY handlers/bulk_operation_handlers.go ./handlers/
COPY handlers/validation_handlers.go ./handlers/
COPY handlers/task_document_file_handler.go ./handlers/
COPY handlers/google_auth_handler.go ./handlers/
COPY handlers/calendar_sync_handler.go ./handlers/
COPY handlers/smart_template_handler.go ./handlers/
COPY handlers/document_collaboration_handler.go ./handlers/
COPY handlers/statistics_handlers.go ./handlers/
COPY handlers/audit_handler.go ./handlers/
COPY handlers/ai_config_handler.go ./handlers/
COPY handlers/ai_task_generator_handler.go ./handlers/
COPY handlers/dashboard_handler.go ./handlers/
COPY handlers/task_analysis_handler.go ./handlers/
COPY handlers/api_key_handler.go ./handlers/
COPY services/ ./services/
COPY security/ ./security/
COPY interfaces/ ./interfaces/
COPY templates/ ./templates/

# 构建应用
RUN CGO_ENABLED=0 GOOS=linux go build -o backend .

# 运行阶段
FROM alpine:latest

# 安装运行时依赖
RUN apk --no-cache add ca-certificates curl tzdata

# 设置工作目录
WORKDIR /app

# 从builder阶段复制编译好的二进制文件
COPY --from=builder /app/backend .

# 暴露端口
EXPOSE 8080

# 设置环境变量
ENV APP_ENV=development
ENV PORT=8080

# 运行应用
CMD ["./backend"]