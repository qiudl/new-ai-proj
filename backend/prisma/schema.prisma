generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model audit_logs {
  id              BigInt   @id @default(autoincrement())
  event_id        String   @unique @db.VarChar(255)
  timestamp       DateTime @default(now()) @db.Timestamptz(6)
  user_id         Int?
  user_email      String?  @db.VarChar(255)
  user_name       String?  @db.VarChar(255)
  user_role       String?  @db.VarChar(100)
  action          String   @db.VarChar(255)
  resource_type   String   @db.VarChar(100)
  resource_id     String?  @db.VarChar(100)
  resource_name   String?  @db.VarChar(255)
  ip_address      String?  @db.Inet
  user_agent      String?
  session_id      String?  @db.VarChar(255)
  request_id      String?  @db.VarChar(255)
  description     String?
  before_data     Json?
  after_data      Json?
  changes         Json?
  status          String?  @default("success") @db.VarChar(50)
  error_message   String?
  project_id      Int?
  parent_event_id String?  @db.VarChar(255)
  correlation_id  String?  @db.VarChar(255)
  metadata        Json?
  tags            String[]

  @@index([action], map: "idx_audit_logs_action")
  @@index([project_id], map: "idx_audit_logs_project_id")
  @@index([resource_type, resource_id], map: "idx_audit_logs_resource")
  @@index([session_id], map: "idx_audit_logs_session_id")
  @@index([timestamp], map: "idx_audit_logs_timestamp")
  @@index([user_id], map: "idx_audit_logs_user_id")
}

model login_attempts {
  id           BigInt   @id @default(autoincrement())
  ip_address   String   @db.Inet
  username     String?  @db.VarChar(255)
  success      Boolean  @default(false)
  timestamp    DateTime @default(now()) @db.Timestamptz(6)
  user_agent   String?
  error_reason String?  @db.VarChar(255)

  @@index([ip_address, timestamp], map: "idx_login_attempts_ip_timestamp")
}

model permissions {
  id               Int                @id @default(autoincrement())
  name             String             @unique @db.VarChar(255)
  description      String?
  category         String?            @db.VarChar(100)
  created_at       DateTime           @default(now()) @db.Timestamptz(6)
  role_permissions role_permissions[]
  user_permissions user_permissions[]
}

model project_members {
  id         Int      @id @default(autoincrement())
  project_id Int
  user_id    Int
  role_id    Int
  added_by   Int
  created_at DateTime @default(now()) @db.Timestamptz(6)
  roles      roles    @relation(fields: [role_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([project_id, user_id])
  @@index([project_id], map: "idx_project_members_project_id")
  @@index([user_id], map: "idx_project_members_user_id")
}

model role_permissions {
  id            Int         @id @default(autoincrement())
  role_id       Int
  permission_id Int
  created_at    DateTime    @default(now()) @db.Timestamptz(6)
  permissions   permissions @relation(fields: [permission_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  roles         roles       @relation(fields: [role_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([role_id, permission_id])
}

model roles {
  id               Int                @id @default(autoincrement())
  name             String             @unique @db.VarChar(100)
  description      String?
  is_system        Boolean?           @default(false)
  created_at       DateTime           @default(now()) @db.Timestamptz(6)
  updated_at       DateTime           @default(now()) @db.Timestamptz(6)
  project_members  project_members[]
  role_permissions role_permissions[]
}

model user_permissions {
  id            Int         @id @default(autoincrement())
  user_id       Int
  permission_id Int
  project_id    Int?
  granted       Boolean     @default(true)
  granted_by    Int
  created_at    DateTime    @default(now()) @db.Timestamptz(6)
  permissions   permissions @relation(fields: [permission_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id], map: "idx_user_permissions_user_id")
}

model user_sessions {
  id         String   @id @db.VarChar(255)
  user_id    Int
  token      String
  expires_at DateTime @db.Timestamptz(6)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  last_seen  DateTime @default(now()) @db.Timestamptz(6)
  ip_address String?  @db.Inet
  user_agent String?
  is_active  Boolean? @default(true)

  @@index([expires_at], map: "idx_user_sessions_expires_at")
  @@index([user_id], map: "idx_user_sessions_user_id")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model ai_configs {
  id                                 Int              @id @default(autoincrement())
  provider                           String           @unique @db.VarChar(50)
  api_key_encrypted                  String
  api_key_hash                       String           @db.VarChar(255)
  model                              String           @db.VarChar(255)
  base_url                           String?
  temperature                        Decimal          @default(0.7) @db.Decimal(3, 2)
  max_tokens                         Int              @default(4000)
  enabled                            Boolean          @default(true)
  metadata                           Json?
  created_by                         Int?
  updated_by                         Int?
  created_at                         DateTime?        @default(now()) @db.Timestamptz(6)
  updated_at                         DateTime?        @default(now()) @db.Timestamptz(6)
  last_tested_at                     DateTime?        @db.Timestamptz(6)
  test_success_count                 Int              @default(0)
  test_failure_count                 Int              @default(0)
  users_ai_configs_created_byTousers users?           @relation("ai_configs_created_byTousers", fields: [created_by], references: [id], onUpdate: NoAction)
  users_ai_configs_updated_byTousers users?           @relation("ai_configs_updated_byTousers", fields: [updated_by], references: [id], onUpdate: NoAction)
  ai_test_logs                       ai_test_logs[]
  ai_usage_stats                     ai_usage_stats[]

  @@index([created_by], map: "idx_ai_configs_created_by")
  @@index([enabled], map: "idx_ai_configs_enabled")
  @@index([provider], map: "idx_ai_configs_provider")
  @@index([updated_at], map: "idx_ai_configs_updated_at")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model ai_test_logs {
  id               Int         @id @default(autoincrement())
  config_id        Int?
  provider         String      @db.VarChar(50)
  success          Boolean
  response_time_ms Int?
  error_message    String?
  tested_at        DateTime?   @default(now()) @db.Timestamptz(6)
  tested_by        Int?
  ai_configs       ai_configs? @relation(fields: [config_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users            users?      @relation(fields: [tested_by], references: [id], onUpdate: NoAction)

  @@index([config_id], map: "idx_ai_test_logs_config_id")
  @@index([provider], map: "idx_ai_test_logs_provider")
  @@index([success], map: "idx_ai_test_logs_success")
  @@index([tested_at], map: "idx_ai_test_logs_tested_at")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model ai_usage_stats {
  id            Int         @id @default(autoincrement())
  config_id     Int?
  provider      String      @db.VarChar(50)
  usage_date    DateTime    @db.Date
  request_count Int         @default(0)
  token_count   Int         @default(0)
  cost_amount   Decimal     @default(0) @db.Decimal(10, 4)
  created_at    DateTime?   @default(now()) @db.Timestamptz(6)
  ai_configs    ai_configs? @relation(fields: [config_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([config_id, usage_date], map: "idx_ai_usage_stats_unique")
  @@index([config_id], map: "idx_ai_usage_stats_config_id")
  @@index([provider], map: "idx_ai_usage_stats_provider")
  @@index([usage_date], map: "idx_ai_usage_stats_usage_date")
}

model customers {
  id                    Int                 @id @default(autoincrement())
  company_name          String              @db.VarChar(255)
  company_code          String?             @db.VarChar(100)
  industry              String?             @db.VarChar(100)
  company_type          String?             @db.VarChar(100)
  business_license      String?             @db.VarChar(100)
  tax_number            String?             @db.VarChar(100)
  legal_representative  String?             @db.VarChar(100)
  address               String?
  city                  String?             @db.VarChar(100)
  province              String?             @db.VarChar(100)
  postal_code           String?             @db.VarChar(20)
  website               String?             @db.VarChar(255)
  main_phone            String?             @db.VarChar(50)
  main_email            String?             @db.VarChar(255)
  status                String?             @default("active") @db.VarChar(50)
  priority              String?             @default("medium") @db.VarChar(20)
  annual_contract_value Decimal?            @default(0) @db.Decimal(15, 2)
  total_contract_value  Decimal?            @default(0) @db.Decimal(15, 2)
  start_date            DateTime?           @db.Date
  employee_count        Int?
  company_size          String?             @db.VarChar(50)
  created_by            Int?
  updated_by            Int?
  created_at            DateTime?           @default(now()) @db.Timestamptz(6)
  updated_at            DateTime?           @default(now()) @db.Timestamptz(6)
  deleted_at            DateTime?           @db.Timestamptz(6)
  project_companies     project_companies[]
  projects              projects[]
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model encryption_keys {
  id         Int       @id @default(autoincrement())
  key_name   String    @unique @db.VarChar(255)
  key_value  String
  algorithm  String    @default("AES-256-GCM") @db.VarChar(50)
  created_at DateTime? @default(now()) @db.Timestamptz(6)
  is_active  Boolean   @default(true)
}

model project_companies {
  id         Int       @id @default(autoincrement())
  project_id Int
  company_id Int
  role       String?   @db.VarChar(50)
  is_primary Boolean?  @default(false)
  created_at DateTime? @default(now()) @db.Timestamptz(6)
  updated_at DateTime? @default(now()) @db.Timestamptz(6)
  customers  customers @relation(fields: [company_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  projects   projects  @relation(fields: [project_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([project_id, company_id])
  @@index([company_id], map: "idx_project_companies_company_id")
  @@index([project_id], map: "idx_project_companies_project_id")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model project_users {
  id         Int       @id @default(autoincrement())
  project_id Int
  user_id    Int
  role       String    @default("customer") @db.VarChar(20)
  is_primary Boolean?  @default(false)
  created_at DateTime? @default(now()) @db.Timestamptz(6)
  updated_at DateTime? @default(now()) @db.Timestamptz(6)
  projects   projects  @relation(fields: [project_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users      users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([project_id, user_id])
  @@index([project_id], map: "idx_project_users_project_id")
  @@index([user_id], map: "idx_project_users_user_id")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model projects {
  id                Int                 @id @default(autoincrement())
  name              String              @db.VarChar(255)
  description       String?
  owner_id          Int?
  created_at        DateTime            @default(now()) @db.Timestamptz(6)
  updated_at        DateTime            @default(now()) @db.Timestamptz(6)
  company_id        Int?
  status            String?             @default("planning") @db.VarChar(20)
  priority          String?             @default("medium") @db.VarChar(10)
  progress          Int?                @default(0)
  start_date        DateTime?           @db.Date
  end_date          DateTime?           @db.Date
  budget            Decimal?            @db.Decimal(15, 2)
  project_companies project_companies[]
  project_users     project_users[]
  customers         customers?          @relation(fields: [company_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  tasks             tasks[]

  @@index([company_id], map: "idx_projects_company_id")
  @@index([start_date, end_date], map: "idx_projects_dates")
  @@index([priority], map: "idx_projects_priority")
  @@index([status], map: "idx_projects_status")
}

model tasks {
  id          Int       @id @default(autoincrement())
  project_id  Int?
  title       String    @db.VarChar(255)
  description String?
  status      String?   @default("todo") @db.VarChar(50)
  created_by  Int?
  assigned_to Int?
  created_at  DateTime  @default(now()) @db.Timestamptz(6)
  updated_at  DateTime  @default(now()) @db.Timestamptz(6)
  projects    projects? @relation(fields: [project_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model users {
  id                                      Int             @id @default(autoincrement())
  username                                String?         @db.VarChar(255)
  contact_person_name                     String?         @db.VarChar(100)
  contact_phone                           String?         @db.VarChar(50)
  department_title                        String?         @db.VarChar(100)
  is_primary_contact                      Boolean?        @default(false)
  account_expires_at                      DateTime?       @db.Timestamptz(6)
  last_project_access                     DateTime?       @db.Timestamptz(6)
  notes                                   String?
  email                                   String?         @db.VarChar(255)
  password_hash                           String?
  user_type                               String?         @default("system") @db.VarChar(20)
  company_id                              Int?
  company_user_id                         Int?
  role                                    String?         @default("user") @db.VarChar(50)
  status                                  String?         @default("active") @db.VarChar(20)
  profile                                 Json?           @default("{}")
  last_login_at                           DateTime?       @db.Timestamptz(6)
  created_at                              DateTime?       @default(now()) @db.Timestamptz(6)
  updated_at                              DateTime?       @default(now()) @db.Timestamptz(6)
  ai_configs_ai_configs_created_byTousers ai_configs[]    @relation("ai_configs_created_byTousers")
  ai_configs_ai_configs_updated_byTousers ai_configs[]    @relation("ai_configs_updated_byTousers")
  ai_test_logs                            ai_test_logs[]
  project_users                           project_users[]
}
