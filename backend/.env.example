# Backend Environment Configuration
# 后端环境配置模板
# 复制此文件为 .env 并填入实际值

# ============================================================================
# 环境设置
# ============================================================================
ENV=development
NODE_ENV=development
APP_ENV=development
GIN_MODE=debug

# ============================================================================
# 数据库配置
# ============================================================================
DB_HOST=localhost
DB_PORT=5432
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=your_db_name
DB_SSL_MODE=disable

# Prisma 数据库 URL
DATABASE_URL=postgresql://your_db_user:your_db_password@localhost:5432/your_db_name?sslmode=disable

# 读写分离配置 (可选)
ENABLE_READ_WRITE_SPLIT=false
DB_MASTER_DSN=postgresql://your_db_user:your_db_password@localhost:5432/your_db_name?sslmode=disable
DB_SLAVE_DSN=postgresql://your_db_user:your_db_password@localhost:5432/your_db_name?sslmode=disable

# ============================================================================
# Redis 配置
# ============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=redis://localhost:6379

# ============================================================================
# 服务配置
# ============================================================================
BACKEND_PORT=8080
PORT=8080
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRATION=168h
LOG_LEVEL=debug
CORS_ORIGIN=http://localhost:3000

# ============================================================================
# 安全配置
# ============================================================================
ENCRYPTION_KEY=your_32_character_encryption_key

# ============================================================================
# 调试配置
# ============================================================================
DEBUG_MODE=true
MOCK_EXTERNAL_SERVICES=false

# ============================================================================
# MCP 服务配置
# ============================================================================
API_BASE_URL=http://localhost:8080/api/v1
TASK_API_BASE=http://localhost:8080/api/v1
MCP_ENABLE_PERMISSIONS=false
MCP_STRICT_PERMISSIONS=false
MCP_DEBUG_PERMISSIONS=true

# ============================================================================
# 超级管理员配置
# ============================================================================
FEATURE_SUPERADMIN_ENABLE=true
SUPER_ADMIN_USERNAMES=admin
SUPER_ADMIN_IDS=1

# ============================================================================
# MCP 服务密钥
# ============================================================================
MCP_SERVICE_API_KEY=your_mcp_service_api_key
