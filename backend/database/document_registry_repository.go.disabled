func (r *PostgresDocumentRegistryRepository) GetRecentDocuments(ctx context.Context, limit int) ([]*models.DocumentInfo, error) {
	query := `
		SELECT id, file_path, filename, title, category, description, file_size, 
		       last_modified, quality_score, technologies, keywords, is_active, created_at
		FROM document_registry 
		WHERE is_active = true
		ORDER BY last_modified DESC
		LIMIT $1
	`
	
	rows, err := r.db.QueryContext(ctx, query, limit)
	if err != nil {
		return nil, fmt.Errorf("failed to get recent documents: %w", err)
	}
	defer rows.Close()
	
	var documents []*models.DocumentInfo
	for rows.Next() {
		doc := &models.DocumentInfo{}
		err := rows.Scan(
			&doc.ID, &doc.FilePath, &doc.Filename, &doc.Title, &doc.Category,
			&doc.Description, &doc.FileSize, &doc.LastModified, &doc.QualityScore,
			pq.Array(&doc.Technologies), pq.Array(&doc.Keywords), &doc.IsActive, &doc.CreatedAt,
		)
		if err != nil {
			return nil, fmt.Errorf("failed to scan document: %w", err)
		}
		documents = append(documents, doc)
	}
	
	return documents, nil
}

