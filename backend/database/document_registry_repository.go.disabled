	}
	
	return documents, nil
}

// GetDocumentCategories retrieves all document categories
func (r *PostgresDocumentRegistryRepository) GetDocumentCategories(ctx context.Context) ([]*models.DocumentCategory, error) {
	query := `
		SELECT id, name, display_name, description, directory_path, color, icon, sort_order, is_active, created_at
		FROM document_categories 
		WHERE is_active = true
		ORDER BY sort_order, name
	`
	
	rows, err := r.db.QueryContext(ctx, query)
	if err != nil {
		return nil, fmt.Errorf("failed to get document categories: %w", err)
	}
	defer rows.Close()
	
	var categories []*models.DocumentCategory
	for rows.Next() {
		cat := &models.DocumentCategory{}
		err := rows.Scan(
			&cat.ID, &cat.Name, &cat.DisplayName, &cat.Description,
			&cat.DirectoryPath, &cat.Color, &cat.Icon, &cat.SortOrder,
			&cat.IsActive, &cat.CreatedAt,
		)
		if err != nil {
			return nil, fmt.Errorf("failed to scan document category: %w", err)
		}
		categories = append(categories, cat)
	}
	
	return categories, nil
}

// GetCategoryStatistics retrieves category statistics
func (r *PostgresDocumentRegistryRepository) GetCategoryStatistics(ctx context.Context) (map[string]int, error) {
	query := `
		SELECT category, COUNT(*) as count
		FROM document_registry 
		WHERE is_active = true
		GROUP BY category
		ORDER BY count DESC
	`
	
	rows, err := r.db.QueryContext(ctx, query)
	if err != nil {
		return nil, fmt.Errorf("failed to get category statistics: %w", err)
	}
	defer rows.Close()
	
	stats := make(map[string]int)
	for rows.Next() {
		var category string
		var count int
		if err := rows.Scan(&category, &count); err != nil {
			return nil, fmt.Errorf("failed to scan category statistics: %w", err)
		}
		stats[category] = count
	}
	
	return stats, nil
}

// BatchCreateDocuments creates multiple documents in a batch
func (r *PostgresDocumentRegistryRepository) BatchCreateDocuments(ctx context.Context, documents []*models.CreateDocumentRequest) (*models.DocumentScanResult, error) {
	result := &models.DocumentScanResult{
		TotalScanned:     len(documents),
		NewDocuments:     0,
		UpdatedDocuments: 0,
		Errors:           []models.DocumentError{},
	}
	
	tx, err := r.db.BeginTx(ctx, nil)
	if err != nil {
		return nil, fmt.Errorf("failed to begin transaction: %w", err)
	}
	defer tx.Rollback()
	
	stmt, err := tx.PrepareContext(ctx, `
		INSERT INTO document_registry 
		(file_path, filename, category, title, description, file_size, content_hash, last_modified, created_by)
		VALUES ($1, $2, $3, $4, $5, $6, $7, $8, $9)
		ON CONFLICT (file_path) DO UPDATE SET
			filename = EXCLUDED.filename,
			category = EXCLUDED.category,
			title = EXCLUDED.title,
			description = EXCLUDED.description,
			file_size = EXCLUDED.file_size,
			content_hash = EXCLUDED.content_hash,
			last_modified = EXCLUDED.last_modified,
			updated_at = NOW()
		RETURNING (xmax = 0) as is_insert
	`)
	if err != nil {
		return nil, fmt.Errorf("failed to prepare statement: %w", err)
	}
	defer stmt.Close()
	
	for _, doc := range documents {
		var isInsert bool
		err := stmt.QueryRowContext(ctx,
			doc.FilePath, doc.Filename, doc.Category, doc.Title, doc.Description,
			doc.FileSize, doc.ContentHash, doc.LastModified, doc.CreatedBy,
		).Scan(&isInsert)
		
		if err != nil {
			result.Errors = append(result.Errors, models.DocumentError{
				FilePath: doc.FilePath,
				Error:    err.Error(),
			})
			continue
		}
		
		if isInsert {
			result.NewDocuments++
		} else {
			result.UpdatedDocuments++
		}
	}
	
	if err := tx.Commit(); err != nil {
		return nil, fmt.Errorf("failed to commit transaction: %w", err)
	}
	
	return result, nil
}

// BatchUpdateDocuments updates multiple documents in a batch
func (r *PostgresDocumentRegistryRepository) BatchUpdateDocuments(ctx context.Context, updates map[int]*models.UpdateDocumentRequest) error {
	tx, err := r.db.BeginTx(ctx, nil)
	if err != nil {
		return fmt.Errorf("failed to begin transaction: %w", err)
	}
	defer tx.Rollback()
	
	for id, req := range updates {
		err := r.UpdateDocument(ctx, id, req)
		if err != nil {
			return fmt.Errorf("failed to update document %d: %w", id, err)
		}
	}
	
	if err := tx.Commit(); err != nil {
		return fmt.Errorf("failed to commit transaction: %w", err)
	}
	
	return nil
}