package database

import (
	"context"
	"database/sql"
	"errors"
	"fmt"
	"strings"

	"github.com/lib/pq"
	"new-ai-proj/models"
)

// Common errors
var (
	ErrDocumentNotFound = errors.New("document not found")
)

// PostgresDocumentRegistryRepository implements the DocumentRegistryRepository interface
type PostgresDocumentRegistryRepository struct {
	db *sql.DB
}

// NewDocumentRegistryRepository creates a new document registry repository
func NewDocumentRegistryRepository(db *sql.DB) DocumentRegistryRepository {
	return &PostgresDocumentRegistryRepository{db: db}
}

// CreateDocument creates a new document registry entry
func (r *PostgresDocumentRegistryRepository) CreateDocument(ctx context.Context, req *models.CreateDocumentRequest) (int, error) {
	query := `
		INSERT INTO document_registry 
		(file_path, filename, category, title, description, file_size, content_hash, last_modified, created_by)
		VALUES ($1, $2, $3, $4, $5, $6, $7, $8, $9)
		RETURNING id
	`
	
	var id int
	err := r.db.QueryRowContext(ctx, query,
		req.FilePath, req.Filename, req.Category, req.Title, req.Description,
		req.FileSize, req.ContentHash, req.LastModified, req.CreatedBy,
	).Scan(&id)
	
	if err != nil {
		return 0, fmt.Errorf("failed to create document: %w", err)
	}
	
	return id, nil
}

// GetDocumentByID retrieves a document by its ID
func (r *PostgresDocumentRegistryRepository) GetDocumentByID(ctx context.Context, id int) (*models.DocumentRegistry, error) {
	query := `
		SELECT id, file_path, filename, category, title, description, file_size, 
		       content_hash, last_modified, is_active, quality_score, 
		       technologies, keywords, created_by, created_at, updated_at
		FROM document_registry 
		WHERE id = $1 AND is_active = true
	`
	
	doc := &models.DocumentRegistry{}
	err := r.db.QueryRowContext(ctx, query, id).Scan(
		&doc.ID, &doc.FilePath, &doc.Filename, &doc.Category, &doc.Title,
		&doc.Description, &doc.FileSize, &doc.ContentHash, &doc.LastModified,
		&doc.IsActive, &doc.QualityScore, pq.Array(&doc.Technologies),
		pq.Array(&doc.Keywords), &doc.CreatedBy, &doc.CreatedAt, &doc.UpdatedAt,
	)
	
	if err != nil {
		if err == sql.ErrNoRows {
			return nil, ErrDocumentNotFound
		}
		return nil, fmt.Errorf("failed to get document by ID: %w", err)
	}
	
	return doc, nil
}

// GetDocumentByPath retrieves a document by its file path
func (r *PostgresDocumentRegistryRepository) GetDocumentByPath(ctx context.Context, filePath string) (*models.DocumentRegistry, error) {
	query := `
		SELECT id, file_path, filename, category, title, description, file_size, 
		       content_hash, last_modified, is_active, quality_score, 
		       technologies, keywords, created_by, created_at, updated_at
		FROM document_registry 
		WHERE file_path = $1 AND is_active = true
	`
	
	doc := &models.DocumentRegistry{}
	err := r.db.QueryRowContext(ctx, query, filePath).Scan(
		&doc.ID, &doc.FilePath, &doc.Filename, &doc.Category, &doc.Title,
		&doc.Description, &doc.FileSize, &doc.ContentHash, &doc.LastModified,
		&doc.IsActive, &doc.QualityScore, pq.Array(&doc.Technologies),
		pq.Array(&doc.Keywords), &doc.CreatedBy, &doc.CreatedAt, &doc.UpdatedAt,
	)
	
	if err != nil {
		if err == sql.ErrNoRows {
			return nil, ErrDocumentNotFound
		}
		return nil, fmt.Errorf("failed to get document by path: %w", err)
	}
	
	return doc, nil
}

// UpdateDocument updates an existing document registry entry
func (r *PostgresDocumentRegistryRepository) UpdateDocument(ctx context.Context, id int, req *models.UpdateDocumentRequest) error {
	setParts := []string{}
	args := []interface{}{}
	argCount := 1
	
	if req.Title != nil {
		setParts = append(setParts, fmt.Sprintf("title = $%d", argCount))
		args = append(args, *req.Title)
		argCount++
	}
	
	if req.Description != nil {
		setParts = append(setParts, fmt.Sprintf("description = $%d", argCount))
		args = append(args, *req.Description)
		argCount++
	}
	
	if req.FileSize > 0 {
		setParts = append(setParts, fmt.Sprintf("file_size = $%d", argCount))
		args = append(args, req.FileSize)
		argCount++
	}
	
	if req.ContentHash != "" {
		setParts = append(setParts, fmt.Sprintf("content_hash = $%d", argCount))
		args = append(args, req.ContentHash)
		argCount++
	}
	
	if !req.LastModified.IsZero() {
		setParts = append(setParts, fmt.Sprintf("last_modified = $%d", argCount))
		args = append(args, req.LastModified)
		argCount++
	}
	
	if req.IsActive != nil {
		setParts = append(setParts, fmt.Sprintf("is_active = $%d", argCount))
		args = append(args, *req.IsActive)
		argCount++
	}
	
	if len(setParts) == 0 {
		return nil // Nothing to update
	}
	
	setParts = append(setParts, "updated_at = NOW()")
	
	query := fmt.Sprintf(`
		UPDATE document_registry 
		SET %s
		WHERE id = $%d
	`, strings.Join(setParts, ", "), argCount)
	
	args = append(args, id)
	
	result, err := r.db.ExecContext(ctx, query, args...)
	if err != nil {
		return fmt.Errorf("failed to update document: %w", err)
	}
	
	rowsAffected, err := result.RowsAffected()
	if err != nil {
		return fmt.Errorf("failed to get rows affected: %w", err)
	}
	
	if rowsAffected == 0 {
		return ErrDocumentNotFound
	}
	
	return nil
}

// DeleteDocument soft deletes a document (marks as inactive)
func (r *PostgresDocumentRegistryRepository) DeleteDocument(ctx context.Context, id int) error {
	query := `UPDATE document_registry SET is_active = false, updated_at = NOW() WHERE id = $1`
	
	result, err := r.db.ExecContext(ctx, query, id)
	if err != nil {
		return fmt.Errorf("failed to delete document: %w", err)
	}
	
	rowsAffected, err := result.RowsAffected()
	if err != nil {
		return fmt.Errorf("failed to get rows affected: %w", err)
	}
	
	if rowsAffected == 0 {
		return ErrDocumentNotFound
	}
	
	return nil
}

// SearchDocuments searches documents based on query and filters
func (r *PostgresDocumentRegistryRepository) SearchDocuments(ctx context.Context, query string, filters *models.DocumentFilters) ([]*models.DocumentInfo, error) {
	whereClauses := []string{"dr.is_active = true"}
	args := []interface{}{}
	argCount := 1
	
	// Add search query
	if query != "" {
		whereClauses = append(whereClauses, fmt.Sprintf(`(
			dr.title ILIKE $%d OR 
			dr.description ILIKE $%d OR 
			dr.filename ILIKE $%d OR
			to_tsvector('english', COALESCE(dr.title, '') || ' ' || COALESCE(dr.description, '')) @@ plainto_tsquery('english', $%d)
		)`, argCount, argCount, argCount, argCount))
		searchPattern := "%" + query + "%"
		args = append(args, searchPattern)
		argCount++
	}
	
	// Add filters
	if filters != nil {
		if filters.Category != nil {
			whereClauses = append(whereClauses, fmt.Sprintf("dr.category = $%d", argCount))
			args = append(args, *filters.Category)
			argCount++
		}
		
		if filters.IsActive != nil {
			whereClauses = append(whereClauses, fmt.Sprintf("dr.is_active = $%d", argCount))
			args = append(args, *filters.IsActive)
			argCount++
		}
		
		if filters.CreatedBy != nil {
			whereClauses = append(whereClauses, fmt.Sprintf("dr.created_by = $%d", argCount))
			args = append(args, *filters.CreatedBy)
			argCount++
		}
	}
	
	// Build the main query
	sqlQuery := fmt.Sprintf(`
		SELECT dr.id, dr.file_path, dr.filename, dr.title, dr.category, 
		       dr.description, dr.file_size, dr.last_modified, dr.quality_score,
		       dr.technologies, dr.keywords, dr.is_active, dr.created_at
		FROM document_registry dr
		WHERE %s
		ORDER BY dr.last_modified DESC
	`, strings.Join(whereClauses, " AND "))
	
	// Add pagination
	if filters != nil {
		if filters.Limit > 0 {
			sqlQuery += fmt.Sprintf(" LIMIT $%d", argCount)
			args = append(args, filters.Limit)
			argCount++
			
			if filters.Page > 0 {
				offset := (filters.Page - 1) * filters.Limit
				sqlQuery += fmt.Sprintf(" OFFSET $%d", argCount)
				args = append(args, offset)
			}
		}
	}
	
	rows, err := r.db.QueryContext(ctx, sqlQuery, args...)
	if err != nil {
		return nil, fmt.Errorf("failed to search documents: %w", err)
	}
	defer rows.Close()
	
	var documents []*models.DocumentInfo
	for rows.Next() {
		doc := &models.DocumentInfo{}
		err := rows.Scan(
			&doc.ID, &doc.FilePath, &doc.Filename, &doc.Title, &doc.Category,
			&doc.Description, &doc.FileSize, &doc.LastModified, &doc.QualityScore,
			pq.Array(&doc.Technologies), pq.Array(&doc.Keywords), &doc.IsActive, &doc.CreatedAt,
		)
		if err != nil {
			return nil, fmt.Errorf("failed to scan document: %w", err)
		}
		documents = append(documents, doc)
	}
	
	return documents, nil
}

// ListDocuments lists all documents with optional filters
func (r *PostgresDocumentRegistryRepository) ListDocuments(ctx context.Context, filters *models.DocumentFilters) ([]*models.DocumentInfo, error) {
	return r.SearchDocuments(ctx, "", filters)
}

// GetDocumentsByCategory retrieves documents by category
func (r *PostgresDocumentRegistryRepository) GetDocumentsByCategory(ctx context.Context, category string, limit, offset int) ([]*models.DocumentInfo, error) {
	filters := &models.DocumentFilters{
		Category: &category,
		Limit:    limit,
		Page:     (offset / limit) + 1,
	}
	return r.SearchDocuments(ctx, "", filters)
}

// CreateDocumentTaskAssociation creates a new document-task association
func (r *PostgresDocumentRegistryRepository) CreateDocumentTaskAssociation(ctx context.Context, req *models.CreateDocumentTaskAssociationRequest) error {
	query := `
		INSERT INTO document_task_associations 
		(document_id, task_id, association_type, confidence_score, notes, created_by)
		VALUES ($1, $2, $3, $4, $5, $6)
		ON CONFLICT (document_id, task_id, association_type) 
		DO UPDATE SET 
			confidence_score = EXCLUDED.confidence_score,
			notes = EXCLUDED.notes,
			created_by = EXCLUDED.created_by,
			created_at = NOW()
	`
	
	_, err := r.db.ExecContext(ctx, query,
		req.DocumentID, req.TaskID, req.AssociationType,
		req.ConfidenceScore, req.Notes, req.CreatedBy,
	)
	
	if err != nil {
		return fmt.Errorf("failed to create document task association: %w", err)
	}
	
	return nil
}

// GetTaskDocuments retrieves all documents associated with a task
func (r *PostgresDocumentRegistryRepository) GetTaskDocuments(ctx context.Context, taskID int) ([]*models.DocumentInfo, error) {
	query := `
		SELECT dr.id, dr.file_path, dr.filename, dr.title, dr.category, 
		       dr.description, dr.file_size, dr.last_modified, dr.quality_score,
		       dr.technologies, dr.keywords, dr.is_active, dr.created_at,
		       dta.association_type, dta.confidence_score
		FROM document_registry dr
		JOIN document_task_associations dta ON dr.id = dta.document_id
		WHERE dta.task_id = $1 AND dr.is_active = true
		ORDER BY dta.association_type, dta.confidence_score DESC, dr.last_modified DESC
	`
	
	rows, err := r.db.QueryContext(ctx, query, taskID)
	if err != nil {
		return nil, fmt.Errorf("failed to get task documents: %w", err)
	}
	defer rows.Close()
	
	var documents []*models.DocumentInfo
	for rows.Next() {
		doc := &models.DocumentInfo{}
		err := rows.Scan(
			&doc.ID, &doc.FilePath, &doc.Filename, &doc.Title, &doc.Category,
			&doc.Description, &doc.FileSize, &doc.LastModified, &doc.QualityScore,
			pq.Array(&doc.Technologies), pq.Array(&doc.Keywords), &doc.IsActive, &doc.CreatedAt,
			&doc.AssociationType, &doc.ConfidenceScore,
		)
		if err != nil {
			return nil, fmt.Errorf("failed to scan task document: %w", err)
		}
		documents = append(documents, doc)
	}
	
	return documents, nil
}

// GetDocumentTasks retrieves all tasks associated with a document  
func (r *PostgresDocumentRegistryRepository) GetDocumentTasks(ctx context.Context, documentID int) ([]*models.TaskDocumentInfo, error) {
	query := `
		SELECT t.id, t.title, t.status, t.description, t.created_at, t.updated_at,
		       dta.association_type, dta.confidence_score, dta.notes
		FROM tasks t
		JOIN document_task_associations dta ON t.id = dta.task_id
		WHERE dta.document_id = $1 AND t.deleted_at IS NULL
		ORDER BY dta.association_type, dta.confidence_score DESC, t.updated_at DESC
	`
	
	rows, err := r.db.QueryContext(ctx, query, documentID)
	if err != nil {
		return nil, fmt.Errorf("failed to get document tasks: %w", err)
	}
	defer rows.Close()
	
	var tasks []*models.TaskDocumentInfo
	for rows.Next() {
		task := &models.TaskDocumentInfo{}
		err := rows.Scan(
			&task.ID, &task.Title, &task.Category, &task.Description, &task.CreatedAt, &task.CreatedAt,
			&task.AssociationType, &task.ConfidenceScore, &task.Notes,
		)
		if err != nil {
			return nil, fmt.Errorf("failed to scan document task: %w", err)
		}
		tasks = append(tasks, task)
	}
	
	return tasks, nil
}

// DeleteDocumentTaskAssociation deletes a document-task association
func (r *PostgresDocumentRegistryRepository) DeleteDocumentTaskAssociation(ctx context.Context, documentID, taskID int) error {
	query := `DELETE FROM document_task_associations WHERE document_id = $1 AND task_id = $2`
	
	result, err := r.db.ExecContext(ctx, query, documentID, taskID)
	if err != nil {
		return fmt.Errorf("failed to delete document task association: %w", err)
	}
	
	rowsAffected, err := result.RowsAffected()
	if err != nil {
		return fmt.Errorf("failed to get rows affected: %w", err)
	}
	
	if rowsAffected == 0 {
		return errors.New("association not found")
	}
	
	return nil
}

// UpdateDocumentTaskAssociation updates a document-task association
func (r *PostgresDocumentRegistryRepository) UpdateDocumentTaskAssociation(ctx context.Context, id int, associationType string, confidence float64, notes string) error {
	query := `
		UPDATE document_task_associations 
		SET association_type = $1, confidence_score = $2, notes = $3, created_at = NOW()
		WHERE id = $4
	`
	
	result, err := r.db.ExecContext(ctx, query, associationType, confidence, notes, id)
	if err != nil {
		return fmt.Errorf("failed to update document task association: %w", err)
	}
	
	rowsAffected, err := result.RowsAffected()
	if err != nil {
		return fmt.Errorf("failed to get rows affected: %w", err)
	}
	
	if rowsAffected == 0 {
		return errors.New("association not found")
	}
	
	return nil
}

// GetDocumentStatistics retrieves document statistics
func (r *PostgresDocumentRegistryRepository) GetDocumentStatistics(ctx context.Context) (*models.DocumentStatistics, error) {
	stats := &models.DocumentStatistics{
		DocumentsByCategory: make(map[string]int),
	}
	
	// Get total document counts
	err := r.db.QueryRowContext(ctx, `
		SELECT 
			COUNT(*) as total,
			COUNT(CASE WHEN is_active = true THEN 1 END) as active,
			COUNT(CASE WHEN is_active = false THEN 1 END) as inactive,
			COALESCE(AVG(quality_score), 0) as avg_quality
		FROM document_registry
	`).Scan(&stats.TotalDocuments, &stats.ActiveDocuments, &stats.InactiveDocuments, &stats.AverageQualityScore)
	
	if err != nil {
		return nil, fmt.Errorf("failed to get document statistics: %w", err)
	}
	
	// Get category statistics
	rows, err := r.db.QueryContext(ctx, `
		SELECT category, COUNT(*) as count
		FROM document_registry 
		WHERE is_active = true
		GROUP BY category
		ORDER BY count DESC
	`)
	if err != nil {
		return nil, fmt.Errorf("failed to get category statistics: %w", err)
	}
	defer rows.Close()
	
	for rows.Next() {
		var category string
		var count int
		if err := rows.Scan(&category, &count); err != nil {
			return nil, fmt.Errorf("failed to scan category statistics: %w", err)
		}
		stats.DocumentsByCategory[category] = count
	}
	
	// Get association statistics
	err = r.db.QueryRowContext(ctx, `
		SELECT 
			COUNT(DISTINCT task_id) as tasks_with_docs,
			COUNT(*) as total_associations
		FROM document_task_associations dta
		JOIN document_registry dr ON dta.document_id = dr.id
		WHERE dr.is_active = true
	`).Scan(&stats.TasksWithDocuments, &stats.DocumentAssociations)
	
	if err != nil {
		return nil, fmt.Errorf("failed to get association statistics: %w", err)
	}
	
	return stats, nil
}

// GetDocumentsByQuality retrieves documents by minimum quality score
func (r *PostgresDocumentRegistryRepository) GetDocumentsByQuality(ctx context.Context, minScore int, limit, offset int) ([]*models.DocumentInfo, error) {
	query := `
		SELECT id, file_path, filename, title, category, description, file_size, 
		       last_modified, quality_score, technologies, keywords, is_active, created_at
		FROM document_registry 
		WHERE is_active = true AND quality_score >= $1
		ORDER BY quality_score DESC, last_modified DESC
		LIMIT $2 OFFSET $3
	`
	
	rows, err := r.db.QueryContext(ctx, query, minScore, limit, offset)
	if err != nil {
		return nil, fmt.Errorf("failed to get documents by quality: %w", err)
	}
	defer rows.Close()
	
	var documents []*models.DocumentInfo
	for rows.Next() {
		doc := &models.DocumentInfo{}
		err := rows.Scan(
			&doc.ID, &doc.FilePath, &doc.Filename, &doc.Title, &doc.Category,
			&doc.Description, &doc.FileSize, &doc.LastModified, &doc.QualityScore,
			pq.Array(&doc.Technologies), pq.Array(&doc.Keywords), &doc.IsActive, &doc.CreatedAt,
		)
		if err != nil {
			return nil, fmt.Errorf("failed to scan document: %w", err)
		}
		documents = append(documents, doc)
	}
	
	return documents, nil
}

