// DeleteRelation deletes any type of document relation
func (r *documentRelationRepository) DeleteRelation(ctx context.Context, entityType string, id, userID int) error {
	var query string

	switch entityType {
	case "customer":
		query = "DELETE FROM document_customer_relations WHERE id = $1 AND created_by = $2"
	case "project":
		query = "DELETE FROM document_project_relations WHERE id = $1 AND created_by = $2"
	case "task":
		query = "DELETE FROM document_task_relations WHERE id = $1 AND created_by = $2"
	default:
		return fmt.Errorf("invalid entity type: %s", entityType)
	}

	result, err := r.db.ExecContext(ctx, query, id, userID)
	if err != nil {
		return fmt.Errorf("failed to delete relation: %w", err)
	}

	rowsAffected, err := result.RowsAffected()
	if err != nil {
		return fmt.Errorf("failed to get affected rows: %w", err)
	}

	if rowsAffected == 0 {
		return fmt.Errorf("relation not found or permission denied")
	}

	return nil
}

// GetRelationStats gets statistics for document relations
func (r *documentRelationRepository) GetRelationStats(ctx context.Context, documentID *int, userID int) (*models.RelationStatsResponse, error) {
	var stats models.RelationStatsResponse

	// Base conditions
	var documentFilter string
	var args []interface{}
	if documentID != nil {
		documentFilter = "WHERE document_id = $1"
		args = append(args, *documentID)
	}

	// Get customer relations count
	customerCountQuery := fmt.Sprintf("SELECT COUNT(*) FROM document_customer_relations %s", documentFilter)
	if err := r.db.QueryRowContext(ctx, customerCountQuery, args...).Scan(&stats.CustomerRelations); err != nil {
		return nil, fmt.Errorf("failed to count customer relations: %w", err)
	}

	// Get project relations count
	projectCountQuery := fmt.Sprintf("SELECT COUNT(*) FROM document_project_relations %s", documentFilter)
	if err := r.db.QueryRowContext(ctx, projectCountQuery, args...).Scan(&stats.ProjectRelations); err != nil {
		return nil, fmt.Errorf("failed to count project relations: %w", err)
	}

	// Get task relations count
	taskCountQuery := fmt.Sprintf("SELECT COUNT(*) FROM document_task_relations %s", documentFilter)
	if err := r.db.QueryRowContext(ctx, taskCountQuery, args...).Scan(&stats.TaskRelations); err != nil {
		return nil, fmt.Errorf("failed to count task relations: %w", err)
	}

	// Get relation type breakdown
	relationTypeQuery := `
		SELECT 'customer' as entity_type, relation_type, COUNT(*) as count
		FROM document_customer_relations %s
		GROUP BY relation_type
		UNION ALL
		SELECT 'project' as entity_type, relation_type, COUNT(*) as count
		FROM document_project_relations %s
		GROUP BY relation_type
		UNION ALL
		SELECT 'task' as entity_type, relation_type, COUNT(*) as count
		FROM document_task_relations %s
		GROUP BY relation_type`

	query := fmt.Sprintf(relationTypeQuery, documentFilter, documentFilter, documentFilter)
	rows, err := r.db.QueryContext(ctx, query, append(args, args...)...)
	if err != nil {
		return nil, fmt.Errorf("failed to get relation type stats: %w", err)
	}
	defer rows.Close()

	for rows.Next() {
		var entityType, relationType string
		var count int
		if err := rows.Scan(&entityType, &relationType, &count); err != nil {
			return nil, fmt.Errorf("failed to scan relation type stats: %w", err)
		}
		// Skip storing individual relation type stats as the field doesn't exist
	}

	// Get recent activity (last 10 relations)
	recentQuery := `
		SELECT id, document_id, 'customer' as entity_type, customer_id as entity_id,
		       '' as entity_name, relation_type, description, created_by, created_at
		FROM document_customer_relations %s
		UNION ALL
		SELECT id, document_id, 'project' as entity_type, project_id as entity_id,
		       '' as entity_name, relation_type, description, created_by, created_at
		FROM document_project_relations %s
		UNION ALL
		SELECT id, document_id, 'task' as entity_type, task_id as entity_id,
		       '' as entity_name, relation_type, description, created_by, created_at
		FROM document_task_relations %s
		ORDER BY created_at DESC LIMIT 10`

	query = fmt.Sprintf(recentQuery, documentFilter, documentFilter, documentFilter)
	rows, err = r.db.QueryContext(ctx, query, append(args, args...)...)
	if err != nil {
		return nil, fmt.Errorf("failed to get recent activity: %w", err)
	}
	defer rows.Close()

	for rows.Next() {
		var relation models.DocumentRelation
		if err := rows.Scan(
			&relation.ID, &relation.DocumentID, &relation.EntityType, &relation.EntityID,
			&relation.EntityName, &relation.RelationType, &relation.Description,
			&relation.CreatedBy, &relation.CreatedAt,
		); err != nil {
			return nil, fmt.Errorf("failed to scan recent activity: %w", err)
		}
		// Skip storing recent activity as the field doesn't exist
	}

	return &stats, nil
}

// BulkCreateRelations creates multiple relations in a single transaction
func (r *documentRelationRepository) BulkCreateRelations(ctx context.Context, relations []models.AddDocumentRelationRequest, userID int) error {
	if len(relations) == 0 {
		return nil
	}

	// Group relations by type for efficient batch inserts
	var customerRelations []models.AddDocumentCustomerRelationRequest
	var projectRelations []models.AddDocumentProjectRelationRequest
	var taskRelations []models.AddDocumentTaskRelationRequest

	for _, rel := range relations {
		switch rel.EntityType {
		case "customer":
			customerRelations = append(customerRelations, models.AddDocumentCustomerRelationRequest{
				DocumentID:   rel.DocumentID,
				CustomerID:   rel.EntityID,
				RelationType: rel.RelationType,
				Description:  rel.Description,
			})
		case "project":
			projectRelations = append(projectRelations, models.AddDocumentProjectRelationRequest{
				DocumentID:   rel.DocumentID,
				ProjectID:    rel.EntityID,
				RelationType: rel.RelationType,
				Description:  rel.Description,
			})
		case "task":
			taskRelations = append(taskRelations, models.AddDocumentTaskRelationRequest{
				DocumentID:   rel.DocumentID,
				TaskID:       rel.EntityID,
				RelationType: rel.RelationType,
				Description:  rel.Description,
			})
		}
	}

	// Batch insert customer relations
	if len(customerRelations) > 0 {
		if err := r.batchInsertCustomerRelations(ctx, customerRelations, userID); err != nil {
			return fmt.Errorf("failed to batch insert customer relations: %w", err)
		}
	}

	// Batch insert project relations
	if len(projectRelations) > 0 {
		if err := r.batchInsertProjectRelations(ctx, projectRelations, userID); err != nil {
			return fmt.Errorf("failed to batch insert project relations: %w", err)
		}
	}

	// Batch insert task relations
	if len(taskRelations) > 0 {
		if err := r.batchInsertTaskRelations(ctx, taskRelations, userID); err != nil {
			return fmt.Errorf("failed to batch insert task relations: %w", err)
		}
	}

	return nil
}

// Helper methods for batch inserts

func (r *documentRelationRepository) batchInsertCustomerRelations(ctx context.Context, relations []models.AddDocumentCustomerRelationRequest, userID int) error {
	if len(relations) == 0 {
		return nil
	}

	valueStrings := make([]string, 0, len(relations))
	valueArgs := make([]interface{}, 0, len(relations)*5)
	
	for i, rel := range relations {
		valueStrings = append(valueStrings, fmt.Sprintf("($%d, $%d, $%d, $%d, $%d)", i*5+1, i*5+2, i*5+3, i*5+4, i*5+5))
		valueArgs = append(valueArgs, rel.DocumentID, rel.CustomerID, rel.RelationType, rel.Description, userID)
	}

	query := fmt.Sprintf(`
		INSERT INTO document_customer_relations (document_id, customer_id, relation_type, description, created_by)
		VALUES %s`, strings.Join(valueStrings, ","))

	_, err := r.db.ExecContext(ctx, query, valueArgs...)
	return err
}

