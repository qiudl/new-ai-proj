// GetDocumentRelations retrieves all relations for a document
func (r *documentRelationRepository) GetDocumentRelations(ctx context.Context, documentID, userID int) (*models.DocumentRelationsResponse, error) {
	var response models.DocumentRelationsResponse

	// Get customer relations
	customerQuery := `
		SELECT dcr.id, dcr.document_id, dcr.customer_id, dcr.relation_type, dcr.description,
		       dcr.created_by, dcr.created_at, d.title as document_title,
		       c.name as customer_name, u.username as creator_name
		FROM document_customer_relations dcr
		LEFT JOIN documents d ON dcr.document_id = d.id
		LEFT JOIN customers c ON dcr.customer_id = c.id
		LEFT JOIN users u ON dcr.created_by = u.id
		WHERE dcr.document_id = $1 AND d.deleted_at IS NULL
		ORDER BY dcr.created_at DESC`

	rows, err := r.db.QueryContext(ctx, customerQuery, documentID)
	if err != nil {
		return nil, fmt.Errorf("failed to get customer relations: %w", err)
	}
	defer rows.Close()

	for rows.Next() {
		var relation models.DocumentCustomerRelation
		if err := rows.Scan(
			&relation.ID, &relation.DocumentID, &relation.CustomerID, &relation.RelationType,
			&relation.Description, &relation.CreatedBy, &relation.CreatedAt,
			&relation.DocumentTitle, &relation.CustomerName, &relation.CreatorName,
		); err != nil {
			return nil, fmt.Errorf("failed to scan customer relation: %w", err)
		}
		// Convert to DocumentRelation
		customerName := ""
		if relation.CustomerName != nil {
			customerName = *relation.CustomerName
		}
		docRelation := relation.ToDocumentRelation(customerName)
		response.CustomerRelations = append(response.CustomerRelations, docRelation)
	}

	// Get project relations
	projectQuery := `
		SELECT dpr.id, dpr.document_id, dpr.project_id, dpr.relation_type, dpr.description,
		       dpr.created_by, dpr.created_at, d.title as document_title,
		       p.name as project_name, u.username as creator_name
		FROM document_project_relations dpr
		LEFT JOIN documents d ON dpr.document_id = d.id
		LEFT JOIN projects p ON dpr.project_id = p.id
		LEFT JOIN users u ON dpr.created_by = u.id
		WHERE dpr.document_id = $1 AND d.deleted_at IS NULL
		ORDER BY dpr.created_at DESC`

	rows, err = r.db.QueryContext(ctx, projectQuery, documentID)
	if err != nil {
		return nil, fmt.Errorf("failed to get project relations: %w", err)
	}
	defer rows.Close()

	for rows.Next() {
		var relation models.DocumentProjectRelation
		if err := rows.Scan(
			&relation.ID, &relation.DocumentID, &relation.ProjectID, &relation.RelationType,
			&relation.Description, &relation.CreatedBy, &relation.CreatedAt,
			&relation.DocumentTitle, &relation.ProjectName, &relation.CreatorName,
		); err != nil {
			return nil, fmt.Errorf("failed to scan project relation: %w", err)
		}
		// Convert to DocumentRelation
		projectName := ""
		if relation.ProjectName != nil {
			projectName = *relation.ProjectName
		}
		docRelation := relation.ToDocumentRelation(projectName)
		response.ProjectRelations = append(response.ProjectRelations, docRelation)
	}

	// Get task relations
	taskQuery := `
		SELECT dtr.id, dtr.document_id, dtr.task_id, dtr.relation_type, dtr.description,
		       dtr.display_order, dtr.created_by, dtr.created_at, d.title as document_title,
		       t.title as task_title, u.username as creator_name
		FROM document_task_relations dtr
		LEFT JOIN documents d ON dtr.document_id = d.id
		LEFT JOIN tasks t ON dtr.task_id = t.id
		LEFT JOIN users u ON dtr.created_by = u.id
		WHERE dtr.document_id = $1 AND d.deleted_at IS NULL
		ORDER BY dtr.display_order, dtr.created_at DESC`

	rows, err = r.db.QueryContext(ctx, taskQuery, documentID)
	if err != nil {
		return nil, fmt.Errorf("failed to get task relations: %w", err)
	}
	defer rows.Close()

	for rows.Next() {
		var relation models.DocumentTaskRelation
		if err := rows.Scan(
			&relation.ID, &relation.DocumentID, &relation.TaskID, &relation.RelationType,
			&relation.Description, &relation.DisplayOrder, &relation.CreatedBy, &relation.CreatedAt,
			&relation.DocumentTitle, &relation.TaskTitle, &relation.CreatorName,
		); err != nil {
			return nil, fmt.Errorf("failed to scan task relation: %w", err)
		}
		// Convert to DocumentRelation
		taskName := ""
		if relation.TaskTitle != nil {
			taskName = *relation.TaskTitle
		}
		docRelation := relation.ToDocumentRelation(taskName)
		response.TaskRelations = append(response.TaskRelations, docRelation)
	}

	// Calculate total count
	response.TotalCount = len(response.CustomerRelations) + len(response.ProjectRelations) + len(response.TaskRelations)

	return &response, nil
}

// GetEntityRelations retrieves relations for a specific entity
func (r *documentRelationRepository) GetEntityRelations(ctx context.Context, entityType string, entityID int, req *models.ListDocumentRelationsRequest) (*models.EntityRelationsResponse, error) {
	var query string
	var args []interface{}
	argIndex := 1

	switch entityType {
	case "customer":
		query = `
			SELECT dcr.id, d.id as document_id, 'customer' as entity_type, dcr.customer_id as entity_id,
			       c.name as entity_name, dcr.relation_type, dcr.description, dcr.created_by, dcr.created_at
			FROM document_customer_relations dcr
			LEFT JOIN documents d ON dcr.document_id = d.id
			LEFT JOIN customers c ON dcr.customer_id = c.id
			WHERE dcr.customer_id = $1 AND d.deleted_at IS NULL`
		args = append(args, entityID)
		argIndex++

	case "project":
		query = `
			SELECT dpr.id, d.id as document_id, 'project' as entity_type, dpr.project_id as entity_id,
			       p.name as entity_name, dpr.relation_type, dpr.description, dpr.created_by, dpr.created_at
			FROM document_project_relations dpr
			LEFT JOIN documents d ON dpr.document_id = d.id
			LEFT JOIN projects p ON dpr.project_id = p.id
			WHERE dpr.project_id = $1 AND d.deleted_at IS NULL`
		args = append(args, entityID)
		argIndex++

	case "task":
		query = `
			SELECT dtr.id, d.id as document_id, 'task' as entity_type, dtr.task_id as entity_id,
			       t.title as entity_name, dtr.relation_type, dtr.description, dtr.created_by, dtr.created_at
			FROM document_task_relations dtr
			LEFT JOIN documents d ON dtr.document_id = d.id
			LEFT JOIN tasks t ON dtr.task_id = t.id
			WHERE dtr.task_id = $1 AND d.deleted_at IS NULL`
		args = append(args, entityID)
		argIndex++

	default:
		return nil, fmt.Errorf("invalid entity type: %s", entityType)
	}

	// Add filters
	var conditions []string
	if req.RelationType != "" {
		conditions = append(conditions, fmt.Sprintf("relation_type = $%d", argIndex))
		args = append(args, req.RelationType)
		argIndex++
	}

	if req.CreatedBy != nil {
		conditions = append(conditions, fmt.Sprintf("created_by = $%d", argIndex))
		args = append(args, *req.CreatedBy)
		argIndex++
	}

	if len(conditions) > 0 {
		query += " AND " + strings.Join(conditions, " AND ")
	}

	// Count total
	countQuery := "SELECT COUNT(*) FROM (" + query + ") as cnt"
	var totalCount int
	if err := r.db.QueryRowContext(ctx, countQuery, args...).Scan(&totalCount); err != nil {
		return nil, fmt.Errorf("failed to count relations: %w", err)
	}

	// Add ordering and pagination
	query += " ORDER BY created_at DESC"
	if req.Limit > 0 {
		query += fmt.Sprintf(" LIMIT $%d", argIndex)
		args = append(args, req.Limit)
		argIndex++

		if req.Offset > 0 {
			query += fmt.Sprintf(" OFFSET $%d", argIndex)
			args = append(args, req.Offset)
		}
	}

	rows, err := r.db.QueryContext(ctx, query, args...)
	if err != nil {
		return nil, fmt.Errorf("failed to get entity relations: %w", err)
	}
	defer rows.Close()

	var relations []models.DocumentRelation
	for rows.Next() {
		var relation models.DocumentRelation
		if err := rows.Scan(
			&relation.ID, &relation.DocumentID, &relation.EntityType, &relation.EntityID,
			&relation.EntityName, &relation.RelationType, &relation.Description,
			&relation.CreatedBy, &relation.CreatedAt,
		); err != nil {
			return nil, fmt.Errorf("failed to scan relation: %w", err)
		}
		relations = append(relations, relation)
	}

	return &models.EntityRelationsResponse{
		Relations:  relations,
		TotalCount: totalCount,
	}, nil
}

// UpdateCustomerRelation updates a document-customer relation
func (r *documentRelationRepository) UpdateCustomerRelation(ctx context.Context, id int, req *models.UpdateDocumentRelationRequest, userID int) (*models.DocumentCustomerRelation, error) {
	// Build update query dynamically
	var setParts []string
	var args []interface{}
	argIndex := 1

	if req.RelationType != nil {
		if !models.ValidateCustomerRelationType(*req.RelationType) {
			return nil, fmt.Errorf("invalid customer relation type: %s", *req.RelationType)
		}
		setParts = append(setParts, fmt.Sprintf("relation_type = $%d", argIndex))
		args = append(args, *req.RelationType)
		argIndex++
	}

	if req.Description != nil {
		setParts = append(setParts, fmt.Sprintf("description = $%d", argIndex))
		args = append(args, *req.Description)
		argIndex++
	}

	if len(setParts) == 0 {
		return nil, fmt.Errorf("no fields to update")
	}

	query := fmt.Sprintf(`
		UPDATE document_customer_relations 
		SET %s
		WHERE id = $%d AND created_by = $%d
		RETURNING id, document_id, customer_id, relation_type, description, created_by, created_at`,
		strings.Join(setParts, ", "), argIndex, argIndex+1)

	args = append(args, id, userID)

	row := r.db.QueryRowContext(ctx, query, args...)

	var relation models.DocumentCustomerRelation
	if err := row.Scan(
		&relation.ID, &relation.DocumentID, &relation.CustomerID, &relation.RelationType,
		&relation.Description, &relation.CreatedBy, &relation.CreatedAt,
	); err != nil {
		if err == sql.ErrNoRows {
			return nil, fmt.Errorf("relation not found or permission denied")
		}
		return nil, fmt.Errorf("failed to update customer relation: %w", err)
	}

	return &relation, nil
}

