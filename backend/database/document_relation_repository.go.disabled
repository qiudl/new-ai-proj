package database

import (
	"ai-project-backend/models"
	"context"
	"database/sql"
	"fmt"
	"strings"

	"github.com/lib/pq"
)

type documentRelationRepository struct {
	db DBExecutor
}

// NewDocumentRelationRepository creates a new document relation repository
func NewDocumentRelationRepository(db DBExecutor) DocumentRelationRepository {
	return &documentRelationRepository{db: db}
}

// CreateCustomerRelation creates a new document-customer relation
func (r *documentRelationRepository) CreateCustomerRelation(ctx context.Context, req *models.AddDocumentCustomerRelationRequest, userID int) (*models.DocumentCustomerRelation, error) {
	// Validate relation type
	if !models.ValidateCustomerRelationType(req.RelationType) {
		return nil, fmt.Errorf("invalid customer relation type: %s", req.RelationType)
	}

	query := `
		INSERT INTO document_customer_relations (
			document_id, customer_id, relation_type, description, created_by
		) VALUES ($1, $2, $3, $4, $5)
		RETURNING id, created_at`

	relation := &models.DocumentCustomerRelation{
		DocumentID:   req.DocumentID,
		CustomerID:   req.CustomerID,
		RelationType: req.RelationType,
		Description:  req.Description,
		CreatedBy:    userID,
	}

	row := r.db.QueryRowContext(ctx, query,
		relation.DocumentID, relation.CustomerID, relation.RelationType,
		relation.Description, relation.CreatedBy)

	if err := row.Scan(&relation.ID, &relation.CreatedAt); err != nil {
		return nil, fmt.Errorf("failed to create customer relation: %w", err)
	}

	return relation, nil
}

