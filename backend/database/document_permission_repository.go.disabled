package database

import (
	"ai-project-backend/models"
	"context"
	"crypto/rand"
	"database/sql"
	"encoding/hex"
	"fmt"
	"strings"
	"time"

	"github.com/lib/pq"
)

type documentPermissionRepository struct {
	db DBExecutor
}

func NewDocumentPermissionRepository(db DBExecutor) DocumentPermissionRepository {
	return &documentPermissionRepository{db: db}
}

// GrantPermission grants a permission to a user for a document
func (r *documentPermissionRepository) GrantPermission(ctx context.Context, req *models.GrantDocumentPermissionRequest, grantorID int) (*models.DocumentPermission, error) {
	// Check if permission already exists
	existingQuery := `
		SELECT id FROM document_permissions 
		WHERE document_id = $1 AND user_id = $2 AND is_active = true`
	
	var existingID int
	err := r.db.QueryRowContext(ctx, existingQuery, req.DocumentID, req.UserID).Scan(&existingID)
	
	if err == nil {
		// Update existing permission
		updateQuery := `
			UPDATE document_permissions 
			SET permission_type = $1, expires_at = $2, granted_by = $3, granted_at = NOW()
			WHERE id = $4
			RETURNING id, document_id, user_id, permission_type, granted_by, granted_at, expires_at, is_active`
			
		permission := &models.DocumentPermission{}
		row := r.db.QueryRowContext(ctx, updateQuery, req.PermissionType, req.ExpiresAt, grantorID, existingID)
		
		if err := row.Scan(&permission.ID, &permission.DocumentID, &permission.UserID, 
			&permission.PermissionType, &permission.GrantedBy, &permission.GrantedAt,
			&permission.ExpiresAt, &permission.IsActive); err != nil {
			return nil, fmt.Errorf("failed to update permission: %w", err)
		}
		
		return permission, nil
	} else if err != sql.ErrNoRows {
		return nil, fmt.Errorf("failed to check existing permission: %w", err)
	}
	
	// Create new permission
	insertQuery := `
		INSERT INTO document_permissions (document_id, user_id, permission_type, granted_by, expires_at, is_active)
		VALUES ($1, $2, $3, $4, $5, true)
		RETURNING id, document_id, user_id, permission_type, granted_by, granted_at, expires_at, is_active`
	
	permission := &models.DocumentPermission{}
	row := r.db.QueryRowContext(ctx, insertQuery, req.DocumentID, req.UserID, req.PermissionType, grantorID, req.ExpiresAt)
	
	if err := row.Scan(&permission.ID, &permission.DocumentID, &permission.UserID, 
		&permission.PermissionType, &permission.GrantedBy, &permission.GrantedAt,
		&permission.ExpiresAt, &permission.IsActive); err != nil {
		return nil, fmt.Errorf("failed to grant permission: %w", err)
	}
	
	return permission, nil
}

// GetDocumentPermissions retrieves all permissions for a document
func (r *documentPermissionRepository) GetDocumentPermissions(ctx context.Context, documentID int, userID int) (*models.DocumentPermissionResponse, error) {
	query := `
		SELECT dp.id, dp.document_id, dp.user_id, dp.permission_type, dp.granted_by, 
		       dp.granted_at, dp.expires_at, dp.is_active,
		       d.title as document_title, u.username, u.email as user_email, gu.username as grantor_name
		FROM document_permissions dp
		LEFT JOIN documents d ON dp.document_id = d.id
		LEFT JOIN users u ON dp.user_id = u.id
		LEFT JOIN users gu ON dp.granted_by = gu.id
		WHERE dp.document_id = $1 AND d.deleted_at IS NULL
		ORDER BY dp.granted_at DESC`
	
	rows, err := r.db.QueryContext(ctx, query, documentID)
	if err != nil {
		return nil, fmt.Errorf("failed to get document permissions: %w", err)
	}
	defer rows.Close()
	
	var permissions []*models.DocumentPermission
	for rows.Next() {
		permission := &models.DocumentPermission{}
		if err := rows.Scan(
			&permission.ID, &permission.DocumentID, &permission.UserID, &permission.PermissionType,
			&permission.GrantedBy, &permission.GrantedAt, &permission.ExpiresAt, &permission.IsActive,
			&permission.DocumentTitle, &permission.Username, &permission.UserEmail, &permission.GrantorName,
		); err != nil {
			return nil, fmt.Errorf("failed to scan permission: %w", err)
		}
		permissions = append(permissions, permission)
	}
	
	return &models.DocumentPermissionResponse{
		Permissions: permissions,
		TotalCount:  len(permissions),
	}, nil
}

// GetUserPermissions retrieves all permissions for a user
func (r *documentPermissionRepository) GetUserPermissions(ctx context.Context, userID int) (*models.DocumentPermissionResponse, error) {
	query := `
		SELECT dp.id, dp.document_id, dp.user_id, dp.permission_type, dp.granted_by, 
		       dp.granted_at, dp.expires_at, dp.is_active,
		       d.title as document_title, u.username, u.email as user_email, gu.username as grantor_name
		FROM document_permissions dp
		LEFT JOIN documents d ON dp.document_id = d.id
		LEFT JOIN users u ON dp.user_id = u.id
		LEFT JOIN users gu ON dp.granted_by = gu.id
		WHERE dp.user_id = $1 AND d.deleted_at IS NULL AND dp.is_active = true
		ORDER BY dp.granted_at DESC`
	
	rows, err := r.db.QueryContext(ctx, query, userID)
	if err != nil {
		return nil, fmt.Errorf("failed to get user permissions: %w", err)
	}
	defer rows.Close()
	
	var permissions []*models.DocumentPermission
	for rows.Next() {
		permission := &models.DocumentPermission{}
		if err := rows.Scan(
			&permission.ID, &permission.DocumentID, &permission.UserID, &permission.PermissionType,
			&permission.GrantedBy, &permission.GrantedAt, &permission.ExpiresAt, &permission.IsActive,
			&permission.DocumentTitle, &permission.Username, &permission.UserEmail, &permission.GrantorName,
		); err != nil {
			return nil, fmt.Errorf("failed to scan permission: %w", err)
		}
		permissions = append(permissions, permission)
	}
	
	return &models.DocumentPermissionResponse{
		Permissions: permissions,
		TotalCount:  len(permissions),
	}, nil
}

// CheckUserPermission checks if a user has specific permission for a document
func (r *documentPermissionRepository) CheckUserPermission(ctx context.Context, documentID, userID int, permissionType string) (bool, error) {
	// First check if user is the owner
	ownerQuery := `SELECT owner_id FROM documents WHERE id = $1 AND deleted_at IS NULL`
	var ownerID int
	if err := r.db.QueryRowContext(ctx, ownerQuery, documentID).Scan(&ownerID); err != nil {
		if err == sql.ErrNoRows {
			return false, fmt.Errorf("document not found")
		}
		return false, fmt.Errorf("failed to check document owner: %w", err)
	}
	
	if ownerID == userID {
		return true, nil // Owner has all permissions
	}
	
	// Check explicit permissions
	permQuery := `
		SELECT dp.permission_type, dp.expires_at
		FROM document_permissions dp
		WHERE dp.document_id = $1 AND dp.user_id = $2 AND dp.is_active = true`
	
	rows, err := r.db.QueryContext(ctx, permQuery, documentID, userID)
	if err != nil {
		return false, fmt.Errorf("failed to check permissions: %w", err)
	}
	defer rows.Close()
	
	var permissions []*models.DocumentPermission
	for rows.Next() {
		perm := &models.DocumentPermission{}
		if err := rows.Scan(&perm.PermissionType, &perm.ExpiresAt); err != nil {
			return false, fmt.Errorf("failed to scan permission: %w", err)
		}
		perm.IsActive = true
		permissions = append(permissions, perm)
	}
	
	// Check if any permission grants the requested access
	for _, perm := range permissions {
		if perm.HasPermission(permissionType) {
			return true, nil
		}
	}
	
	return false, nil
}

// UpdatePermission updates an existing permission
func (r *documentPermissionRepository) UpdatePermission(ctx context.Context, permissionID int, req *models.UpdateDocumentPermissionRequest, userID int) (*models.DocumentPermission, error) {
	// Build update query dynamically
	var setParts []string
	var args []interface{}
	argIndex := 1
	
	if req.PermissionType != "" {
		setParts = append(setParts, fmt.Sprintf("permission_type = $%d", argIndex))
		args = append(args, req.PermissionType)
		argIndex++
	}
	
	if req.ExpiresAt != nil {
		setParts = append(setParts, fmt.Sprintf("expires_at = $%d", argIndex))
		args = append(args, req.ExpiresAt)
		argIndex++
	}
	
	if req.IsActive != nil {
		setParts = append(setParts, fmt.Sprintf("is_active = $%d", argIndex))
		args = append(args, *req.IsActive)
		argIndex++
	}
	
	if len(setParts) == 0 {
		return nil, fmt.Errorf("no fields to update")
	}
	
	query := fmt.Sprintf(`
		UPDATE document_permissions 
		SET %s, granted_at = NOW()
		WHERE id = $%d AND granted_by = $%d
		RETURNING id, document_id, user_id, permission_type, granted_by, granted_at, expires_at, is_active`,
		strings.Join(setParts, ", "), argIndex, argIndex+1)
	
	args = append(args, permissionID, userID)
	
	permission := &models.DocumentPermission{}
	row := r.db.QueryRowContext(ctx, query, args...)
	
	if err := row.Scan(&permission.ID, &permission.DocumentID, &permission.UserID, 
		&permission.PermissionType, &permission.GrantedBy, &permission.GrantedAt,
		&permission.ExpiresAt, &permission.IsActive); err != nil {
		if err == sql.ErrNoRows {
			return nil, fmt.Errorf("permission not found or access denied")
		}
		return nil, fmt.Errorf("failed to update permission: %w", err)
	}
	
	return permission, nil
}

// RevokePermission revokes a permission
func (r *documentPermissionRepository) RevokePermission(ctx context.Context, permissionID, userID int) error {
	query := `
		UPDATE document_permissions 
		SET is_active = false
		WHERE id = $1 AND granted_by = $2`
	
	result, err := r.db.ExecContext(ctx, query, permissionID, userID)
	if err != nil {
		return fmt.Errorf("failed to revoke permission: %w", err)
	}
	
	rowsAffected, err := result.RowsAffected()
	if err != nil {
		return fmt.Errorf("failed to get affected rows: %w", err)
	}
	
	if rowsAffected == 0 {
		return fmt.Errorf("permission not found or access denied")
	}
	
	return nil
}

// CreateShare creates a shareable link for a document
func (r *documentPermissionRepository) CreateShare(ctx context.Context, req *models.CreateDocumentShareRequest, userID int) (*models.DocumentShare, error) {
	// Generate share token
	tokenBytes := make([]byte, 16)
	if _, err := rand.Read(tokenBytes); err != nil {
		return nil, fmt.Errorf("failed to generate share token: %w", err)
	}
	shareToken := hex.EncodeToString(tokenBytes)
	
	query := `
		INSERT INTO document_shares (document_id, share_token, share_type, permission_type, 
		                           created_by, expires_at, is_active, require_auth, allow_download)
		VALUES ($1, $2, $3, $4, $5, $6, true, $7, $8)
		RETURNING id, document_id, share_token, share_type, permission_type, created_by, 
		          created_at, expires_at, is_active, access_count, require_auth, allow_download`
	
	share := &models.DocumentShare{}
	row := r.db.QueryRowContext(ctx, query, req.DocumentID, shareToken, req.ShareType, 
		req.PermissionType, userID, req.ExpiresAt, req.RequireAuth, req.AllowDownload)
	
	if err := row.Scan(&share.ID, &share.DocumentID, &share.ShareToken, &share.ShareType,
		&share.PermissionType, &share.CreatedBy, &share.CreatedAt, &share.ExpiresAt,
		&share.IsActive, &share.AccessCount, &share.RequireAuth, &share.AllowDownload); err != nil {
		return nil, fmt.Errorf("failed to create share: %w", err)
	}
	
	return share, nil
}

// GetDocumentShares retrieves all shares for a document
func (r *documentPermissionRepository) GetDocumentShares(ctx context.Context, documentID int) (*models.DocumentShareResponse, error) {
	query := `
		SELECT ds.id, ds.document_id, ds.share_token, ds.share_type, ds.permission_type,
		       ds.created_by, ds.created_at, ds.expires_at, ds.is_active, ds.access_count,
		       ds.require_auth, ds.allow_download,
		       d.title as document_title, u.username as creator_name
		FROM document_shares ds
		LEFT JOIN documents d ON ds.document_id = d.id
		LEFT JOIN users u ON ds.created_by = u.id
		WHERE ds.document_id = $1 AND d.deleted_at IS NULL
		ORDER BY ds.created_at DESC`
	
	rows, err := r.db.QueryContext(ctx, query, documentID)
	if err != nil {
		return nil, fmt.Errorf("failed to get document shares: %w", err)
	}
	defer rows.Close()
	
	var shares []*models.DocumentShare
	for rows.Next() {
		share := &models.DocumentShare{}
		if err := rows.Scan(
			&share.ID, &share.DocumentID, &share.ShareToken, &share.ShareType, &share.PermissionType,
			&share.CreatedBy, &share.CreatedAt, &share.ExpiresAt, &share.IsActive, &share.AccessCount,
			&share.RequireAuth, &share.AllowDownload, &share.DocumentTitle, &share.CreatorName,
		); err != nil {
			return nil, fmt.Errorf("failed to scan share: %w", err)
		}
		shares = append(shares, share)
	}
	
	return &models.DocumentShareResponse{
		Shares:     shares,
		TotalCount: len(shares),
	}, nil
}

// GetShareByToken retrieves a share by its token
func (r *documentPermissionRepository) GetShareByToken(ctx context.Context, token string) (*models.DocumentShare, error) {
	query := `
		SELECT ds.id, ds.document_id, ds.share_token, ds.share_type, ds.permission_type,
		       ds.created_by, ds.created_at, ds.expires_at, ds.is_active, ds.access_count,
		       ds.require_auth, ds.allow_download,
		       d.title as document_title, u.username as creator_name
		FROM document_shares ds
		LEFT JOIN documents d ON ds.document_id = d.id
		LEFT JOIN users u ON ds.created_by = u.id
		WHERE ds.share_token = $1 AND d.deleted_at IS NULL`
	
	share := &models.DocumentShare{}
	row := r.db.QueryRowContext(ctx, query, token)
	
	if err := row.Scan(
		&share.ID, &share.DocumentID, &share.ShareToken, &share.ShareType, &share.PermissionType,
		&share.CreatedBy, &share.CreatedAt, &share.ExpiresAt, &share.IsActive, &share.AccessCount,
		&share.RequireAuth, &share.AllowDownload, &share.DocumentTitle, &share.CreatorName,
	); err != nil {
		if err == sql.ErrNoRows {
			return nil, fmt.Errorf("share not found")
		}
		return nil, fmt.Errorf("failed to get share: %w", err)
	}
	
	// Increment access count
	_, err := r.db.ExecContext(ctx, "UPDATE document_shares SET access_count = access_count + 1 WHERE id = $1", share.ID)
	if err != nil {
		// Log error but don't fail the operation
		fmt.Printf("Failed to increment access count: %v\n", err)
	}
	
	return share, nil
}

// UpdateShare updates a document share
func (r *documentPermissionRepository) UpdateShare(ctx context.Context, shareID int, req *models.UpdateDocumentShareRequest, userID int) (*models.DocumentShare, error) {
	// Build update query dynamically
	var setParts []string
	var args []interface{}
	argIndex := 1
	
	if req.PermissionType != nil {
		setParts = append(setParts, fmt.Sprintf("permission_type = $%d", argIndex))
		args = append(args, *req.PermissionType)
		argIndex++
	}
	
	if req.ExpiresAt != nil {
		setParts = append(setParts, fmt.Sprintf("expires_at = $%d", argIndex))
		args = append(args, *req.ExpiresAt)
		argIndex++
	}
	
	if req.IsActive != nil {
		setParts = append(setParts, fmt.Sprintf("is_active = $%d", argIndex))
		args = append(args, *req.IsActive)
		argIndex++
	}
	
	if req.RequireAuth != nil {
		setParts = append(setParts, fmt.Sprintf("require_auth = $%d", argIndex))
		args = append(args, *req.RequireAuth)
		argIndex++
	}
	
	if req.AllowDownload != nil {
		setParts = append(setParts, fmt.Sprintf("allow_download = $%d", argIndex))
		args = append(args, *req.AllowDownload)
		argIndex++
	}
	
	if len(setParts) == 0 {
		return nil, fmt.Errorf("no fields to update")
	}
	
	query := fmt.Sprintf(`
		UPDATE document_shares 
		SET %s
		WHERE id = $%d AND created_by = $%d
		RETURNING id, document_id, share_token, share_type, permission_type, created_by, 
		          created_at, expires_at, is_active, access_count, require_auth, allow_download`,
		strings.Join(setParts, ", "), argIndex, argIndex+1)
	
	args = append(args, shareID, userID)
	
	share := &models.DocumentShare{}
	row := r.db.QueryRowContext(ctx, query, args...)
	
	if err := row.Scan(&share.ID, &share.DocumentID, &share.ShareToken, &share.ShareType,
		&share.PermissionType, &share.CreatedBy, &share.CreatedAt, &share.ExpiresAt,
		&share.IsActive, &share.AccessCount, &share.RequireAuth, &share.AllowDownload); err != nil {
		if err == sql.ErrNoRows {
			return nil, fmt.Errorf("share not found or access denied")
		}
		return nil, fmt.Errorf("failed to update share: %w", err)
	}
	
	return share, nil
}

// DeleteShare deletes a document share
func (r *documentPermissionRepository) DeleteShare(ctx context.Context, shareID, userID int) error {
	query := `DELETE FROM document_shares WHERE id = $1 AND created_by = $2`
	
	result, err := r.db.ExecContext(ctx, query, shareID, userID)
	if err != nil {
		return fmt.Errorf("failed to delete share: %w", err)
	}
	
	rowsAffected, err := result.RowsAffected()
	if err != nil {
		return fmt.Errorf("failed to get affected rows: %w", err)
	}
	
	if rowsAffected == 0 {
		return fmt.Errorf("share not found or access denied")
	}
	
	return nil
}