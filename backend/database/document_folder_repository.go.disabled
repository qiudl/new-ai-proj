package database

import (
	"ai-project-backend/models"
	"context"
	"database/sql"
	"fmt"
	"strings"
	"time"
)

// PostgreSQLDocumentFolderRepository PostgreSQL实现
type PostgreSQLDocumentFolderRepository struct {
	db *sql.DB
}

// NewDocumentFolderRepository 创建新的文档文件夹仓库
func NewDocumentFolderRepository(db *sql.DB) DocumentFolderRepository {
	return &PostgreSQLDocumentFolderRepository{db: db}
}

// Create 创建文档文件夹
func (r *PostgreSQLDocumentFolderRepository) Create(ctx context.Context, req *models.CreateDocumentFolderRequest, userID int) (*models.DocumentFolder, error) {
	folder := &models.DocumentFolder{
		Name:             req.Name,
		Description:      req.Description,
		ParentFolderID:   req.ParentFolderID,
		OwnerID:          userID,
		Visibility:       req.Visibility,
		Color:            req.Color,
		Icon:             req.Icon,
		SortOrder:        req.SortOrder,
		CreatedBy:        userID,
	}
	query := `
		INSERT INTO document_folders (
			name, description, parent_folder_id, owner_id, visibility,
			color, icon, sort_order, created_by
		) VALUES ($1, $2, $3, $4, $5, $6, $7, $8, $9)
		RETURNING id, created_at, updated_at`
	
	err := r.db.QueryRowContext(ctx,
		query,
		folder.Name, folder.Description, folder.ParentFolderID, folder.OwnerID,
		folder.Visibility, folder.Color, folder.Icon, folder.SortOrder, folder.CreatedBy,
	).Scan(&folder.ID, &folder.CreatedAt, &folder.UpdatedAt)
	
	if err != nil {
		return nil, fmt.Errorf("failed to create document folder: %w", err)
	}
	
	return folder, nil
}

// GetByID 根据ID获取文档文件夹
func (r *PostgreSQLDocumentFolderRepository) GetByID(ctx context.Context, id int) (*models.DocumentFolder, error) {
	query := `
		SELECT df.id, df.name, df.description, df.parent_folder_id, df.owner_id,
			   df.visibility, df.color, df.icon, df.sort_order, df.created_by,
			   df.created_at, df.updated_at, df.deleted_at,
			   u.username as owner_name,
			   COUNT(d.id) as document_count
		FROM document_folders df
		LEFT JOIN users u ON df.owner_id = u.id
		LEFT JOIN documents d ON df.id = d.folder_id AND d.deleted_at IS NULL
		WHERE df.id = $1 AND df.deleted_at IS NULL
		GROUP BY df.id, u.username`
	
	var folder models.DocumentFolder
	var ownerName sql.NullString
	
	err := r.db.QueryRow(query, id).Scan(
		&folder.ID, &folder.Name, &folder.Description, &folder.ParentFolderID,
		&folder.OwnerID, &folder.Visibility, &folder.Color, &folder.Icon,
		&folder.SortOrder, &folder.CreatedBy, &folder.CreatedAt, &folder.UpdatedAt,
		&folder.DeletedAt, &ownerName, &folder.DocumentCount,
	)
	
	if err != nil {
		if err == sql.ErrNoRows {
			return nil, fmt.Errorf("folder not found")
		}
		return nil, err
	}
	
	if ownerName.Valid {
		folder.OwnerName = &ownerName.String
	}
	
	return &folder, nil
}

// Update 更新文档文件夹
func (r *PostgreSQLDocumentFolderRepository) Update(id int, updates *models.UpdateFolderRequest) error {
	setParts := []string{}
	args := []interface{}{}
	argCount := 1
	
	if updates.Name != nil {
		setParts = append(setParts, fmt.Sprintf("name = $%d", argCount))
		args = append(args, *updates.Name)
		argCount++
	}
	
	if updates.Description != nil {
		setParts = append(setParts, fmt.Sprintf("description = $%d", argCount))
		args = append(args, *updates.Description)
		argCount++
	}
	
	if updates.ParentFolderID != nil {
		// 检查循环引用
		hasCircular, err := r.CheckCircularReference(id, *updates.ParentFolderID)
		if err != nil {
			return err
		}
		if hasCircular {
			return fmt.Errorf("circular reference detected")
		}
		
		setParts = append(setParts, fmt.Sprintf("parent_folder_id = $%d", argCount))
		args = append(args, *updates.ParentFolderID)
		argCount++
	}
	
	if updates.Visibility != nil {
		setParts = append(setParts, fmt.Sprintf("visibility = $%d", argCount))
		args = append(args, *updates.Visibility)
		argCount++
	}
	
	if updates.Color != nil {
		setParts = append(setParts, fmt.Sprintf("color = $%d", argCount))
		args = append(args, *updates.Color)
		argCount++
	}
	
	if updates.Icon != nil {
		setParts = append(setParts, fmt.Sprintf("icon = $%d", argCount))
		args = append(args, *updates.Icon)
		argCount++
	}
	
	if updates.SortOrder != nil {
		setParts = append(setParts, fmt.Sprintf("sort_order = $%d", argCount))
		args = append(args, *updates.SortOrder)
		argCount++
	}
	
	if len(setParts) == 0 {
		return fmt.Errorf("no fields to update")
	}
	
	setParts = append(setParts, fmt.Sprintf("updated_at = $%d", argCount))
	args = append(args, time.Now())
	argCount++
	
	args = append(args, id)
	
	query := fmt.Sprintf(`
		UPDATE document_folders 
		SET %s 
		WHERE id = $%d AND deleted_at IS NULL`,
		strings.Join(setParts, ", "), argCount)
	
	result, err := r.db.Exec(query, args...)
	if err != nil {
		return err
	}
	
	rowsAffected, err := result.RowsAffected()
	if err != nil {
		return err
	}
	
	if rowsAffected == 0 {
		return fmt.Errorf("folder not found or already deleted")
	}
	
	return nil
}

// Delete 删除文档文件夹（软删除）
func (r *PostgreSQLDocumentFolderRepository) Delete(ctx context.Context, id int, userID int) error {
	// 首先检查是否有子文件夹或文档
	var childCount int
	err := r.db.QueryRowContext(ctx, `
		SELECT COUNT(*) FROM (
			SELECT id FROM document_folders WHERE parent_folder_id = $1 AND deleted_at IS NULL
			UNION ALL
			SELECT id FROM documents WHERE folder_id = $1 AND deleted_at IS NULL
		) as children`, id).Scan(&childCount)
	
	if err != nil {
		return err
	}
	
	if childCount > 0 {
		return fmt.Errorf("cannot delete folder with children")
	}
	
	result, err := r.db.ExecContext(ctx, `UPDATE document_folders SET deleted_at = NOW() WHERE id = $1`, id)
	if err != nil {
		return err
	}
	
	rowsAffected, err := result.RowsAffected()
	if err != nil {
		return err
	}
	
	if rowsAffected == 0 {
		return fmt.Errorf("folder not found")
	}
	
	return nil
}

// SoftDelete 软删除文档文件夹
func (r *PostgreSQLDocumentFolderRepository) SoftDelete(id int) error {
	result, err := r.db.Exec(`
		UPDATE document_folders 
		SET deleted_at = CURRENT_TIMESTAMP 
		WHERE id = $1 AND deleted_at IS NULL`, id)
	
	if err != nil {
		return err
	}
	
	rowsAffected, err := result.RowsAffected()
	if err != nil {
		return err
	}
	
	if rowsAffected == 0 {
		return fmt.Errorf("folder not found or already deleted")
	}
	
	return nil
}

// GetByOwner 获取用户的所有文件夹
func (r *PostgreSQLDocumentFolderRepository) GetByOwner(ownerID int) ([]models.DocumentFolder, error) {
	query := `
		SELECT df.id, df.name, df.description, df.parent_folder_id, df.owner_id,
			   df.visibility, df.color, df.icon, df.sort_order, df.created_by,
			   df.created_at, df.updated_at, df.deleted_at,
			   u.username as owner_name,
			   COUNT(d.id) as document_count
		FROM document_folders df
		LEFT JOIN users u ON df.owner_id = u.id
		LEFT JOIN documents d ON df.id = d.folder_id AND d.deleted_at IS NULL
		WHERE df.owner_id = $1 AND df.deleted_at IS NULL
		GROUP BY df.id, u.username
		ORDER BY df.sort_order, df.name`
	
	rows, err := r.db.Query(query, ownerID)
	if err != nil {
		return nil, err
	}
	defer rows.Close()
	
	var folders []models.DocumentFolder
	for rows.Next() {
		var folder models.DocumentFolder
		var ownerName sql.NullString
		
		err := rows.Scan(
			&folder.ID, &folder.Name, &folder.Description, &folder.ParentFolderID,
			&folder.OwnerID, &folder.Visibility, &folder.Color, &folder.Icon,
			&folder.SortOrder, &folder.CreatedBy, &folder.CreatedAt, &folder.UpdatedAt,
			&folder.DeletedAt, &ownerName, &folder.DocumentCount,
		)
		if err != nil {
			return nil, err
		}
		
		if ownerName.Valid {
			folder.OwnerName = &ownerName.String
		}
		
		folders = append(folders, folder)
	}
	
	return folders, nil
}

