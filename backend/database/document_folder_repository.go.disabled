	query := `
		SELECT df.id, df.name, df.description, df.parent_folder_id, df.owner_id,
			   df.visibility, df.color, df.icon, df.sort_order, df.created_by,
			   df.created_at, df.updated_at, df.deleted_at,
			   u.username as owner_name,
			   COUNT(d.id) as document_count
		FROM document_folders df
		LEFT JOIN users u ON df.owner_id = u.id
		LEFT JOIN documents d ON df.id = d.folder_id AND d.deleted_at IS NULL
		WHERE df.owner_id = $1 AND df.parent_folder_id IS NULL AND df.deleted_at IS NULL
		GROUP BY df.id, u.username
		ORDER BY df.sort_order, df.name`
	
	rows, err := r.db.Query(query, ownerID)
	if err != nil {
		return nil, err
	}
	defer rows.Close()
	
	var folders []models.DocumentFolder
	for rows.Next() {
		var folder models.DocumentFolder
		var ownerName sql.NullString
		
		err := rows.Scan(
			&folder.ID, &folder.Name, &folder.Description, &folder.ParentFolderID,
			&folder.OwnerID, &folder.Visibility, &folder.Color, &folder.Icon,
			&folder.SortOrder, &folder.CreatedBy, &folder.CreatedAt, &folder.UpdatedAt,
			&folder.DeletedAt, &ownerName, &folder.DocumentCount,
		)
		if err != nil {
			return nil, err
		}
		
		if ownerName.Valid {
			folder.OwnerName = &ownerName.String
		}
		
		folders = append(folders, folder)
	}
	
	return folders, nil
}

// GetFolderTree 获取文件夹树形结构  
func (r *PostgreSQLDocumentFolderRepository) GetFolderTree(ownerID int) ([]models.DocumentFolder, error) {
	// 使用递归CTE查询
	query := `
		WITH RECURSIVE folder_tree AS (
			-- 根节点
			SELECT df.id, df.name, df.description, df.parent_folder_id, df.owner_id,
				   df.visibility, df.color, df.icon, df.sort_order, df.created_by,
				   df.created_at, df.updated_at, df.deleted_at,
				   u.username as owner_name,
				   COUNT(d.id) as document_count,
				   0 as level,
				   ARRAY[df.sort_order, df.id] as path
			FROM document_folders df
			LEFT JOIN users u ON df.owner_id = u.id
			LEFT JOIN documents d ON df.id = d.folder_id AND d.deleted_at IS NULL
			WHERE df.owner_id = $1 AND df.parent_folder_id IS NULL AND df.deleted_at IS NULL
			GROUP BY df.id, u.username
			
			UNION ALL
			
			-- 递归部分
			SELECT df.id, df.name, df.description, df.parent_folder_id, df.owner_id,
				   df.visibility, df.color, df.icon, df.sort_order, df.created_by,
				   df.created_at, df.updated_at, df.deleted_at,
				   u.username as owner_name,
				   COUNT(d.id) as document_count,
				   ft.level + 1,
				   ft.path || ARRAY[df.sort_order, df.id]
			FROM document_folders df
			LEFT JOIN users u ON df.owner_id = u.id
			LEFT JOIN documents d ON df.id = d.folder_id AND d.deleted_at IS NULL
			INNER JOIN folder_tree ft ON df.parent_folder_id = ft.id
			WHERE df.deleted_at IS NULL
			GROUP BY df.id, u.username, ft.level, ft.path
		)
		SELECT id, name, description, parent_folder_id, owner_id,
			   visibility, color, icon, sort_order, created_by,
			   created_at, updated_at, deleted_at, owner_name, document_count
		FROM folder_tree
		ORDER BY path`
	
	rows, err := r.db.Query(query, ownerID)
	if err != nil {
		return nil, err
	}
	defer rows.Close()
	
	var folders []models.DocumentFolder
	for rows.Next() {
		var folder models.DocumentFolder
		var ownerName sql.NullString
		
		err := rows.Scan(
			&folder.ID, &folder.Name, &folder.Description, &folder.ParentFolderID,
			&folder.OwnerID, &folder.Visibility, &folder.Color, &folder.Icon,
			&folder.SortOrder, &folder.CreatedBy, &folder.CreatedAt, &folder.UpdatedAt,
			&folder.DeletedAt, &ownerName, &folder.DocumentCount,
		)
		if err != nil {
			return nil, err
		}
		
		if ownerName.Valid {
			folder.OwnerName = &ownerName.String
		}
		
		folders = append(folders, folder)
	}
	
	return folders, nil
}

// Move 移动文件夹
func (r *PostgreSQLDocumentFolderRepository) Move(folderID int, newParentID *int) error {
	// 检查循环引用
	if newParentID != nil {
		hasCircular, err := r.CheckCircularReference(folderID, *newParentID)
		if err != nil {
			return err
		}
		if hasCircular {
			return fmt.Errorf("circular reference detected")
		}
	}
	
	result, err := r.db.Exec(`
		UPDATE document_folders 
		SET parent_folder_id = $1, updated_at = CURRENT_TIMESTAMP 
		WHERE id = $2 AND deleted_at IS NULL`, newParentID, folderID)
	
	if err != nil {
		return err
	}
	
	rowsAffected, err := result.RowsAffected()
	if err != nil {
		return err
	}
	
	if rowsAffected == 0 {
		return fmt.Errorf("folder not found or already deleted")
	}
	
	return nil
}

// CheckCircularReference 检查循环引用
func (r *PostgreSQLDocumentFolderRepository) CheckCircularReference(folderID, parentID int) (bool, error) {
	if folderID == parentID {
		return true, nil
	}
	
	query := `
		WITH RECURSIVE parent_check AS (
			SELECT id, parent_folder_id
			FROM document_folders
			WHERE id = $1 AND deleted_at IS NULL
			
			UNION ALL
			
			SELECT df.id, df.parent_folder_id
			FROM document_folders df
			INNER JOIN parent_check pc ON df.id = pc.parent_folder_id
			WHERE df.deleted_at IS NULL
		)
		SELECT COUNT(*) FROM parent_check WHERE id = $2`
	
	var count int
	err := r.db.QueryRow(query, parentID, folderID).Scan(&count)
	if err != nil {
		return false, err
	}
	
	return count > 0, nil
}

// GetDocumentCount 获取文件夹中的文档数量
func (r *PostgreSQLDocumentFolderRepository) GetDocumentCount(folderID int) (int, error) {
	var count int
	err := r.db.QueryRow(`
		SELECT COUNT(*) 
		FROM documents 
		WHERE folder_id = $1 AND deleted_at IS NULL`, folderID).Scan(&count)
	
	return count, err
}

// CanAccess 检查用户是否可以访问指定的文件夹
func (r *PostgreSQLDocumentFolderRepository) CanAccess(ctx context.Context, folderID int, userID int, action string) (bool, error) {
	// 基本权限检查：检查用户是否有权限访问文件夹
	query := `
		SELECT df.id 
		FROM document_folders df
		WHERE df.id = $1 
		AND (
			df.owner_id = $2 
			OR df.visibility = 'public'
			OR df.visibility = 'company'
		)`
	
	var id int
	err := r.db.QueryRowContext(ctx, query, folderID, userID).Scan(&id)
	if err != nil {
		if err == sql.ErrNoRows {
			return false, nil // 文件夹不存在或用户无权限
		}
		return false, fmt.Errorf("failed to check folder access: %w", err)
	}
	
	return true, nil
}
