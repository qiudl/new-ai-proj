func (s *WorkNoteFolderService) ExecuteDailyMaintenance(ctx context.Context) (string, error) {
	query := `SELECT daily_folder_maintenance()`
	
	var result string
	err := s.db.GetContext(ctx, &result, query)
	if err != nil {
		return "", fmt.Errorf("failed to execute daily maintenance: %w", err)
	}
	
	return result, nil
}

// GetFolderTree 获取完整的文件夹树（带缓存优化）
func (s *WorkNoteFolderService) GetFolderTree(ctx context.Context, rootFolderID *int, maxDepth int, userID int) ([]models.WorkNoteFolderTree, error) {
	// 首先获取所有可访问的文件夹
	baseQuery := `
		SELECT 
			df.id, df.name, df.description, df.parent_folder_id,
			df.path, df.depth, df.owner_id, df.visibility,
			df.color, df.icon, df.sort_order, df.folder_type,
			df.is_system_folder, df.note_count_cached,
			df.last_activity_at, df.created_by, df.created_at, df.updated_at,
			-- 计算子文件夹数量
			(SELECT COUNT(*) FROM document_folders child 
			 WHERE child.parent_folder_id = df.id AND child.deleted_at IS NULL) as children_count,
			-- 权限检查（简化版本）
			CASE WHEN df.owner_id = $1 THEN TRUE 
				 WHEN df.visibility != 'private' THEN TRUE 
				 ELSE FALSE END as can_read,
			CASE WHEN df.owner_id = $1 THEN TRUE ELSE FALSE END as can_edit,
			CASE WHEN df.owner_id = $1 THEN TRUE ELSE FALSE END as can_delete
		FROM document_folders df
		WHERE df.deleted_at IS NULL
	`
	
	var conditions []string
	var args []interface{} = []interface{}{userID}
	argIndex := 2
	
	// 添加根文件夹过滤
	if rootFolderID != nil {
		// 获取根文件夹路径
		var rootPath string
		err := s.db.GetContext(ctx, &rootPath, 
			"SELECT path::text FROM document_folders WHERE id = $1 AND deleted_at IS NULL", 
			*rootFolderID)
		if err != nil {
			return nil, fmt.Errorf("failed to get root folder path: %w", err)
		}
		
		conditions = append(conditions, fmt.Sprintf("df.path ~ $%d::lquery", argIndex))
		args = append(args, rootPath+".*")
		argIndex++
	}
	
	// 添加深度限制
	if maxDepth > 0 {
		if rootFolderID != nil {
			// 需要先获取根文件夹深度
			var rootDepth int
			err := s.db.GetContext(ctx, &rootDepth, 
				"SELECT depth FROM document_folders WHERE id = $1 AND deleted_at IS NULL", 
				*rootFolderID)
			if err == nil {
				conditions = append(conditions, fmt.Sprintf("df.depth <= $%d", argIndex))
				args = append(args, rootDepth+maxDepth)
				argIndex++
			}
		} else {
			conditions = append(conditions, fmt.Sprintf("df.depth <= $%d", argIndex))
			args = append(args, maxDepth)
			argIndex++
		}
	}
	
	if len(conditions) > 0 {
		baseQuery += " AND " + strings.Join(conditions, " AND ")
	}
	
	baseQuery += " ORDER BY df.depth, df.sort_order, df.name"
	
	var folders []struct {
		models.WorkNoteFolder
		ChildrenCount int  `db:"children_count"`
		CanRead       bool `db:"can_read"`
		CanEdit       bool `db:"can_edit"`
		CanDelete     bool `db:"can_delete"`
	}
	
	err := s.db.SelectContext(ctx, &folders, baseQuery, args...)
	if err != nil {
		return nil, fmt.Errorf("failed to get folder tree: %w", err)
	}
	
	// 转换为带统计信息的模型
	foldersWithStats := make([]models.WorkNoteFolderWithStats, len(folders))
	for i, folder := range folders {
		foldersWithStats[i] = models.WorkNoteFolderWithStats{
			WorkNoteFolder: folder.WorkNoteFolder,
			ChildrenCount:  folder.ChildrenCount,
			CanEdit:        folder.CanEdit,
			CanDelete:      folder.CanDelete,
			CanManage:      folder.CanEdit, // 简化权限模型
		}
	}
	
	// 构建树结构
	tree := models.BuildFolderTree(foldersWithStats)
	
	// 排序树
	models.SortFolderTree(tree)
	
	return tree, nil
}

// 辅助类型定义

type FolderTreeStats struct {
	TotalFolders          int     `db:"total_folders"`
	RootFolders           int     `db:"root_folders"`
	MaxDepth              int     `db:"max_depth"`
	AvgChildrenPerFolder  float64 `db:"avg_children_per_folder"`
	TotalNotes            int     `db:"total_notes"`
	FoldersWithNotes      int     `db:"folders_with_notes"`
	LargestFolderID       int     `db:"largest_folder_id"`
	LargestFolderNotes    int     `db:"largest_folder_notes"`
}

type FolderPerformanceIssue struct {
	IssueType       string `db:"issue_type"`
	FolderID        int    `db:"folder_id"`
	FolderName      string `db:"folder_name"`
	IssueDetails    string `db:"issue_details"`
	SuggestedAction string `db:"suggested_action"`
}

