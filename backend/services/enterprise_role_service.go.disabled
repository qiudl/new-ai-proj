// CreateRoleFromTemplate 从模板创建角色
func (s *EnterpriseRoleService) CreateRoleFromTemplate(enterpriseID, templateID int, roleCode, roleName string, createdBy *int) (*models.EnterpriseRole, error) {
	return s.roleRepo.CreateRoleFromTemplate(enterpriseID, templateID, roleCode, roleName, createdBy)
}

// GetRoleStatistics 获取角色统计信息
func (s *EnterpriseRoleService) GetRoleStatistics(enterpriseID int) (map[string]interface{}, error) {
	roles, _, err := s.roleRepo.GetRolesByEnterpriseID(enterpriseID, 1, 1000)
	if err != nil {
		return nil, fmt.Errorf("查询角色列表失败: %w", err)
	}

	stats := make(map[string]interface{})
	
	totalRoles := len(roles)
	activeRoles := 0
	defaultRoles := 0
	templateRoles := 0
	customRoles := 0
	systemRoles := 0
	totalUsers := 0
	levelDistribution := make(map[int]int)
	typeDistribution := make(map[string]int)
	
	for _, role := range roles {
		if role.IsActive {
			activeRoles++
		}
		if role.IsDefault {
			defaultRoles++
		}
		totalUsers += role.UserCount
		levelDistribution[role.RoleLevel]++
		typeDistribution[role.RoleType]++
		
		switch role.RoleType {
		case "template":
			templateRoles++
		case "custom":
			customRoles++
		case "system":
			systemRoles++
		}
	}

	stats["total_roles"] = totalRoles
	stats["active_roles"] = activeRoles
	stats["default_roles"] = defaultRoles
	stats["template_roles"] = templateRoles
	stats["custom_roles"] = customRoles
	stats["system_roles"] = systemRoles
	stats["total_users"] = totalUsers
	stats["level_distribution"] = levelDistribution
	stats["type_distribution"] = typeDistribution

	return stats, nil
}

// CloneRole 克隆角色
func (s *EnterpriseRoleService) CloneRole(sourceID int, newCode, newName string, createdBy *int) (*models.EnterpriseRole, error) {
	// 获取源角色
	sourceRole, err := s.roleRepo.GetRoleByID(sourceID, false)
	if err != nil {
		return nil, fmt.Errorf("源角色不存在: %w", err)
	}

	// 创建克隆角色
	cloneRole := &models.EnterpriseRole{
		EnterpriseID:    sourceRole.EnterpriseID,
		RoleCode:        newCode,
		RoleName:        newName,
		RoleDescription: sourceRole.RoleDescription,
		RoleType:        "custom", // 克隆的角色都是自定义类型
		Permissions:     sourceRole.Permissions,
		RoleLevel:       sourceRole.RoleLevel,
		IsDefault:       false, // 克隆的角色不是默认角色
		AutoAssign:      false, // 克隆的角色不自动分配
		MaxUsers:        sourceRole.MaxUsers,
		IsActive:        true,
		CreatedBy:       createdBy,
	}

	// 保存克隆角色
	err = s.roleRepo.CreateRole(cloneRole)
	if err != nil {
		return nil, fmt.Errorf("创建克隆角色失败: %w", err)
	}

	return s.roleRepo.GetRoleByID(cloneRole.ID, true)
}

// BatchUpdateRoleStatus 批量更新角色状态
func (s *EnterpriseRoleService) BatchUpdateRoleStatus(roleIDs []int, isActive bool, updatedBy *int) error {
	for _, id := range roleIDs {
		updates := map[string]interface{}{
			"is_active": isActive,
		}
		if updatedBy != nil {
			updates["updated_by"] = *updatedBy
		}
		
		err := s.roleRepo.UpdateRole(id, updates)
		if err != nil {
			return fmt.Errorf("更新角色 %d 状态失败: %w", id, err)
		}
	}

	return nil
}

// BatchAssignRoles 批量分配角色
func (s *EnterpriseRoleService) BatchAssignRoles(userID int, roleIDs []int, assignedBy *int) error {
	now := time.Now()
	
	for _, roleID := range roleIDs {
		assignment := &models.EnterpriseUserRole{
			EnterpriseUserID: userID,
			RoleID:           roleID,
			AssignedDate:     now,
			IsActive:         true,
			AssignedBy:       assignedBy,
		}
		
		err := s.roleRepo.AssignRoleToUser(assignment)
		if err != nil {
			return fmt.Errorf("分配角色 %d 失败: %w", roleID, err)
		}
	}

	return nil
}

// BatchRemoveRoles 批量移除角色
func (s *EnterpriseRoleService) BatchRemoveRoles(userID int, roleIDs []int) error {
	for _, roleID := range roleIDs {
		err := s.roleRepo.RemoveRoleFromUser(userID, roleID)
		if err != nil {
			return fmt.Errorf("移除角色 %d 失败: %w", roleID, err)
		}
	}

	return nil
}

