package services

import (
	"fmt"
	"time"

	"ai-project-backend/database"
	"ai-project-backend/models"
)

type EnterpriseRoleService struct {
	roleRepo       *database.EnterpriseRoleRepository
	positionRepo   *database.EnterprisePositionRepository
	enterpriseRepo *database.EnterpriseRepository
}

func NewEnterpriseRoleService(
	roleRepo *database.EnterpriseRoleRepository,
	positionRepo *database.EnterprisePositionRepository,
	enterpriseRepo *database.EnterpriseRepository,
) *EnterpriseRoleService {
	return &EnterpriseRoleService{
		roleRepo:       roleRepo,
		positionRepo:   positionRepo,
		enterpriseRepo: enterpriseRepo,
	}
}

// CreateRole 创建角色
func (s *EnterpriseRoleService) CreateRole(req *models.CreateRoleRequest, createdBy *int) (*models.EnterpriseRole, error) {
	// 验证企业是否存在
	_, err := s.enterpriseRepo.GetEnterpriseByID(req.EnterpriseID)
	if err != nil {
		return nil, fmt.Errorf("企业不存在: %w", err)
	}

	// 验证角色代码唯一性
	// TODO: 添加角色代码唯一性检查

	// 验证父角色
	if req.ParentRoleID != nil {
		_, err = s.roleRepo.GetRoleByID(*req.ParentRoleID, false)
		if err != nil {
			return nil, fmt.Errorf("父角色不存在: %w", err)
		}
	}

	// 验证角色模板
	if req.TemplateID != nil && req.RoleType == "template" {
		// TODO: 验证角色模板存在
	}

	// 创建角色对象
	role := &models.EnterpriseRole{
		EnterpriseID:    req.EnterpriseID,
		RoleCode:        req.RoleCode,
		RoleName:        req.RoleName,
		RoleDescription: req.RoleDescription,
		RoleType:        req.RoleType,
		TemplateID:      req.TemplateID,
		Permissions:     req.Permissions,
		RoleLevel:       req.RoleLevel,
		ParentRoleID:    req.ParentRoleID,
		IsDefault:       req.IsDefault,
		AutoAssign:      req.AutoAssign,
		MaxUsers:        req.MaxUsers,
		IsActive:        true,
		CreatedBy:       createdBy,
	}

	// 保存到数据库
	err = s.roleRepo.CreateRole(role)
	if err != nil {
		return nil, fmt.Errorf("创建角色失败: %w", err)
	}

	// 返回完整的角色信息
	return s.roleRepo.GetRoleByID(role.ID, true)
}

// GetRoleByID 获取角色详情
func (s *EnterpriseRoleService) GetRoleByID(id int, includeRelated bool) (*models.EnterpriseRole, error) {
	return s.roleRepo.GetRoleByID(id, includeRelated)
}

// GetRolesByEnterpriseID 获取企业角色列表
func (s *EnterpriseRoleService) GetRolesByEnterpriseID(enterpriseID int, page, pageSize int) (*models.RoleListResponse, error) {
	roles, total, err := s.roleRepo.GetRolesByEnterpriseID(enterpriseID, page, pageSize)
	if err != nil {
		return nil, err
	}

	return &models.RoleListResponse{
		Roles:    roles,
		Total:    total,
		Page:     page,
		PageSize: pageSize,
	}, nil
}

// UpdateRole 更新角色
func (s *EnterpriseRoleService) UpdateRole(id int, req *models.UpdateRoleRequest, updatedBy *int) (*models.EnterpriseRole, error) {
	// 检查角色是否存在
	existingRole, err := s.roleRepo.GetRoleByID(id, false)
	if err != nil {
		return nil, err
	}

	// 构建更新字段
	updates := make(map[string]interface{})
	
	if req.RoleName != nil {
		updates["role_name"] = *req.RoleName
	}
	if req.RoleDescription != nil {
		updates["role_description"] = *req.RoleDescription
	}
	if req.Permissions != nil {
		updates["permissions"] = req.Permissions
	}
	if req.RoleLevel != nil {
		updates["role_level"] = *req.RoleLevel
	}
	if req.ParentRoleID != nil {
		// 验证父角色存在且不是自己
		if *req.ParentRoleID == id {
			return nil, fmt.Errorf("不能将自己设为父角色")
		}
		_, err = s.roleRepo.GetRoleByID(*req.ParentRoleID, false)
		if err != nil {
			return nil, fmt.Errorf("父角色不存在: %w", err)
		}
		updates["parent_role_id"] = *req.ParentRoleID
	}
	if req.IsDefault != nil {
		// 如果设为默认角色，需要检查是否已有默认角色
		if *req.IsDefault {
			// TODO: 检查企业是否已有默认角色
		}
		updates["is_default"] = *req.IsDefault
	}
	if req.AutoAssign != nil {
		updates["auto_assign"] = *req.AutoAssign
	}
	if req.MaxUsers != nil {
		// 验证最大用户数不能少于当前用户数
		if *req.MaxUsers < existingRole.UserCount {
			return nil, fmt.Errorf("最大用户数不能少于当前用户数 %d", existingRole.UserCount)
		}
		updates["max_users"] = *req.MaxUsers
	}
	if req.IsActive != nil {
		updates["is_active"] = *req.IsActive
	}
	if updatedBy != nil {
		updates["updated_by"] = *updatedBy
	}

	// 执行更新
	err = s.roleRepo.UpdateRole(id, updates)
	if err != nil {
		return nil, err
	}

	// 返回更新后的角色信息
	return s.roleRepo.GetRoleByID(id, true)
}

// DeleteRole 删除角色
func (s *EnterpriseRoleService) DeleteRole(id int) error {
	return s.roleRepo.DeleteRole(id)
}

// GetRoleHierarchy 获取角色层级结构
func (s *EnterpriseRoleService) GetRoleHierarchy(enterpriseID int) ([]models.RoleHierarchy, error) {
	return s.roleRepo.GetRoleHierarchy(enterpriseID)
}

// AssignRoleToUser 分配角色给用户
func (s *EnterpriseRoleService) AssignRoleToUser(req *models.AssignRoleRequest, assignedBy *int) (*models.EnterpriseUserRole, error) {
	// 验证请求数据
	if req.ExpiryDate != nil && req.ExpiryDate.Before(req.AssignedDate) {
		return nil, fmt.Errorf("过期日期不能早于分配日期")
	}

	// 创建分配对象
	assignment := &models.EnterpriseUserRole{
		EnterpriseUserID: req.EnterpriseUserID,
		RoleID:           req.RoleID,
		AssignedDate:     req.AssignedDate,
		ExpiryDate:       req.ExpiryDate,
		IsActive:         true,
		AssignedBy:       assignedBy,
	}

	// 执行分配
	err := s.roleRepo.AssignRoleToUser(assignment)
	if err != nil {
		return nil, err
	}

	return assignment, nil
}

// RemoveRoleFromUser 移除用户角色
func (s *EnterpriseRoleService) RemoveRoleFromUser(userID, roleID int) error {
	return s.roleRepo.RemoveRoleFromUser(userID, roleID)
