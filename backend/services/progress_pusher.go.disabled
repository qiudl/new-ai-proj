package services

import (
	"ai-project-backend/database"
	ws "ai-project-backend/websocket"
	"context"
	"encoding/json"
	"fmt"
	"log"
	"time"

	"github.com/go-redis/redis/v8"
)

// ProgressPusher handles real-time progress updates
type ProgressPusher struct {
	hub    *ws.Hub
	redis  *redis.Client
	db     database.DB
	logger *log.Logger
}

// NewProgressPusher creates a new progress pusher service
func NewProgressPusher(hub *ws.Hub, redis *redis.Client, db database.DB, logger *log.Logger) *ProgressPusher {
	return &ProgressPusher{
		hub:    hub,
		redis:  redis,
		db:     db,
		logger: logger,
	}
}

// PushTaskProgress pushes task progress update to WebSocket clients
func (p *ProgressPusher) PushTaskProgress(taskID int, progress *ProgressResult) error {
	update := ws.ProgressUpdate{
		Type:      "task",
		EntityID:  taskID,
		Progress:  progress.Progress,
		Method:    progress.MethodUsed,
		UpdatedAt: time.Now(),
	}

	// Convert breakdown if exists
	if progress.Breakdown != nil {
		update.Breakdown = make([]ws.ProgressBreakdown, len(progress.Breakdown))
		for i, b := range progress.Breakdown {
			update.Breakdown[i] = ws.ProgressBreakdown{
				ID:       b.ID,
				Title:    b.Title,
				Progress: b.Progress,
				Weight:   b.Weight,
				Status:   b.Status,
				Method:   b.Method,
			}
		}
	}

	// Publish to Redis for distributed systems
	if p.redis != nil {
		data, err := json.Marshal(update)
		if err != nil {
			return fmt.Errorf("failed to marshal update: %w", err)
		}

		ctx := context.Background()
		channel := fmt.Sprintf("progress:task:%d", taskID)
		if err := p.redis.Publish(ctx, channel, data).Err(); err != nil {
			p.logger.Printf("Failed to publish to Redis: %v", err)
		}
	}

	// Broadcast to WebSocket clients
	return p.hub.BroadcastProgressUpdate(&update)
}

// PushProjectProgress pushes project progress update to WebSocket clients
func (p *ProgressPusher) PushProjectProgress(projectID int, progress *ProgressResult) error {
	update := ws.ProgressUpdate{
		Type:      "project",
		EntityID:  projectID,
		Progress:  progress.Progress,
		Method:    progress.MethodUsed,
		UpdatedAt: time.Now(),
	}

	// Publish to Redis
	if p.redis != nil {
		data, err := json.Marshal(update)
		if err != nil {
			return fmt.Errorf("failed to marshal update: %w", err)
		}

		ctx := context.Background()
		channel := fmt.Sprintf("progress:project:%d", projectID)
		if err := p.redis.Publish(ctx, channel, data).Err(); err != nil {
			p.logger.Printf("Failed to publish to Redis: %v", err)
		}
	}

	// Broadcast to WebSocket clients
	return p.hub.BroadcastProgressUpdate(&update)
}

// StartRedisSubscriber starts listening to Redis pub/sub channels
func (p *ProgressPusher) StartRedisSubscriber(ctx context.Context) {
	if p.redis == nil {
		return
	}

	pubsub := p.redis.PSubscribe(ctx, "progress:*")
	defer pubsub.Close()

	ch := pubsub.Channel()
	for msg := range ch {
		var update ws.ProgressUpdate
		if err := json.Unmarshal([]byte(msg.Payload), &update); err != nil {
			p.logger.Printf("Failed to unmarshal Redis message: %v", err)
			continue
		}

		// Broadcast to local WebSocket clients
		if err := p.hub.BroadcastProgressUpdate(&update); err != nil {
			p.logger.Printf("Failed to broadcast update: %v", err)
		}
	}
}

// NotifyTaskUpdate sends a task update notification
func (p *ProgressPusher) NotifyTaskUpdate(taskID int, message string) error {
	notification := ws.NotificationMessage{
		Type:      "task_update",
		Title:     "Task Updated",
		Message:   message,
		Level:     "info",
		Timestamp: time.Now(),
	}

	data, err := json.Marshal(notification)
	if err != nil {
		return err
	}

	p.hub.BroadcastToTask(taskID, data)
	return nil
}
