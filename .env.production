# 生产环境配置 (Production Environment)
# 生产部署时的配置文件 - 包含敏感信息，请妥善保管

# 环境标识
ENV=production
NODE_ENV=production

# 数据库配置 - 生产数据库 (需要替换为实际值)
DB_HOST=your-production-db-host
DB_PORT=5432
DB_USER=your-production-db-user
DB_PASSWORD=your-production-db-password
DB_NAME=ai_project_management_prod
DB_SOURCE=postgresql://your-production-db-user:your-production-db-password@your-production-db-host:5432/ai_project_management_prod?sslmode=require

# 后端服务配置
BACKEND_PORT=8080
JWT_SECRET=your-super-secure-jwt-secret-change-this-immediately
JWT_EXPIRATION=24h
GIN_MODE=release
LOG_LEVEL=warn
CORS_ORIGIN=https://yourdomain.com,https://www.yourdomain.com

# 前端配置
FRONTEND_PORT=3000
REACT_APP_API_URL=https://api.yourdomain.com
REACT_APP_API_BASE_URL=https://api.yourdomain.com/api/v1
REACT_APP_ENV=production
REACT_APP_ENVIRONMENT=production
REACT_APP_ENABLE_MOCK=false

# Nginx代理配置
NGINX_PORT=80
NGINX_SSL_PORT=443

# 生产环境优化配置
CHOKIDAR_USEPOLLING=false
GENERATE_SOURCEMAP=false
TSC_COMPILE_ON_ERROR=false
ESLINT_NO_DEV_ERRORS=false

# 安全密钥 (生产环境 - 请替换为强密码)
ENCRYPTION_KEY=your-super-secure-32-char-encryption-key

# Google Calendar API配置 (生产环境)
GOOGLE_CLIENT_ID=your_production_google_client_id
GOOGLE_CLIENT_SECRET=your_production_google_client_secret
GOOGLE_PROJECT_ID=your_production_google_project_id
GOOGLE_REDIRECT_URL=https://yourdomain.com/api/auth/google/callback
GOOGLE_CALENDAR_SCOPES=https://www.googleapis.com/auth/calendar

# 生产环境特定配置
DEBUG_MODE=false
ENABLE_DEV_TOOLS=false
HOT_RELOAD=false
MOCK_EXTERNAL_SERVICES=false
ENABLE_HTTPS=true
SSL_CERT_PATH=/etc/nginx/ssl/cert.pem
SSL_KEY_PATH=/etc/nginx/ssl/key.pem

# 性能和安全配置
MAX_REQUEST_SIZE=10mb
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=900000
SESSION_TIMEOUT=3600000
BACKUP_ENABLED=true
MONITORING_ENABLED=true