# 生产环境配置文件
# 注意: 此文件包含示例值，实际部署时需要替换为真实的生产环境配置

# 数据库配置
DB_HOST=postgres
DB_PORT=5432
DB_USER=prod_user
DB_PASSWORD=CHANGE_ME_PRODUCTION_PASSWORD
DB_NAME=ai_project_prod_db

# JWT密钥 (生产环境必须使用强密钥)
JWT_SECRET=CHANGE_ME_SUPER_SECURE_JWT_SECRET_FOR_PRODUCTION

# 应用配置
ENV=production
PORT=8080

# Redis配置
REDIS_URL=redis://redis:6379

# 腾讯云配置 (可选)
TENCENT_CLOUD_REGION=ap-beijing
TENCENT_CLOUD_SECRET_ID=YOUR_SECRET_ID
TENCENT_CLOUD_SECRET_KEY=YOUR_SECRET_KEY

# 日志配置
LOG_LEVEL=info
LOG_FORMAT=json

# 安全配置
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
RATE_LIMIT_REQUESTS_PER_MINUTE=100

# 文件上传配置
MAX_UPLOAD_SIZE=10MB
UPLOAD_PATH=/app/uploads

# 监控配置 (可选)
ENABLE_METRICS=true
METRICS_PORT=9090

# 邮件配置 (可选)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@yourdomain.com
SMTP_PASSWORD=CHANGE_ME_SMTP_PASSWORD

# 备份配置 (可选)
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *  # 每天凌晨2点备份
BACKUP_RETENTION_DAYS=30