# 轻量服务器简化配置文件
# 用于直接在服务器上构建和部署

# 数据库配置
DB_USER=ai_user
DB_PASSWORD=ai_password_2024_change_me
DB_NAME=ai_project_db

# JWT密钥 (生产环境必须更改)
JWT_SECRET=super_secure_jwt_secret_change_me_in_production

# 应用配置
ENV=production
PORT=8080

# Redis配置
REDIS_URL=redis://redis:6379

# 日志配置
LOG_LEVEL=info

# 安全配置
CORS_ALLOWED_ORIGINS=*

# 文件上传配置
MAX_UPLOAD_SIZE=10MB