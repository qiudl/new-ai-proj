{
  "project": {
    "name": "Web应用开发",
    "path": "/path/to/your/web-app",
    "taskSystem": {
      "url": "http://localhost:8081",
      "projectId": 1
    }
  },
  "environment": {
    "proxyScript": "~/proxy.sh local",
    "preCommands": [
      "echo '🌐 启动Web应用开发环境...'",
      "git status --short",
      "npm run dev --prefix frontend &",
      "echo '前端服务: http://localhost:3000'"
    ]
  },
  "dependencies": {
    "analyzer": "auto",
    "strategy": "smart"
  },
  "aiExperts": [
    {
      "id": "frontend_components",
      "name": "🎨 前端组件专家",
      "description": "负责前端组件开发、样式设计、交互逻辑",
      "tasks": ["1", "2"],
      "workingDir": "./src/components",
      "specialties": ["Vue3", "React", "组件设计", "CSS", "JavaScript"],
      "concurrent": 2,
      "dependencies": {
        "requires": [],
        "blocks": ["frontend_pages"]
      }
    },
    {
      "id": "frontend_pages",
      "name": "📄 页面开发专家", 
      "description": "负责页面级开发、路由配置、状态管理",
      "tasks": ["3", "4"],
      "workingDir": "./src/views",
      "specialties": ["Vue Router", "Vuex/Pinia", "页面架构", "用户体验"],
      "concurrent": 2,
      "dependencies": {
        "requires": ["frontend_components"],
        "blocks": ["integration_test"]
      }
    },
    {
      "id": "api_integration",
      "name": "🔌 API集成专家",
      "description": "负责API接口集成、数据处理、错误处理",
      "tasks": ["5", "6"],
      "workingDir": "./src/api",
      "specialties": ["HTTP客户端", "数据处理", "错误处理", "缓存策略"],
      "concurrent": 1,
      "dependencies": {
        "requires": [],
        "blocks": ["frontend_pages"]
      }
    },
    {
      "id": "integration_test",
      "name": "✅ 测试专家",
      "description": "负责组件测试、集成测试、E2E测试",
      "tasks": ["7"],
      "workingDir": "./tests",
      "specialties": ["Jest", "Vue Test Utils", "Cypress", "自动化测试"],
      "concurrent": 1,
      "dependencies": {
        "requires": ["frontend_pages", "api_integration"],
        "blocks": []
      }
    }
  ]
}