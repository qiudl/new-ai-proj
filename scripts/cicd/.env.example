# Production Environment Variables Template
# 复制此文件到服务器: /opt/ai-project-cicd/shared/env/.env

# ================================================
# Database Configuration
# ================================================
DB_HOST=postgres-master
DB_PORT=5432
DB_USER=prod_user
DB_PASSWORD=your_secure_password_here
DB_NAME=ai_project_db

# ================================================
# Server Configuration
# ================================================
PORT=8080
APP_ENV=production
LOG_LEVEL=info

# ================================================
# JWT Authentication
# ================================================
JWT_SECRET=your_jwt_secret_key_here_change_in_production
JWT_EXPIRATION=24h

# ================================================
# Feature Flags
# ================================================
FEATURE_SUPERADMIN_ENABLE=true
SUPER_ADMIN_USERNAMES=admin,guoym,weier,fuxing

# ================================================
# Redis Configuration (Optional)
# ================================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ================================================
# Frontend Configuration
# ================================================
REACT_APP_API_URL=https://proj.joylodging.com/api/v1
REACT_APP_ENV=production
GENERATE_SOURCEMAP=false

# ================================================
# Email Configuration (Optional)
# ================================================
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com

# ================================================
# Storage Configuration (Optional)
# ================================================
STORAGE_TYPE=local
STORAGE_PATH=/app/data/uploads

# ================================================
# Monitoring (Optional)
# ================================================
SENTRY_DSN=
PROMETHEUS_ENABLED=false
