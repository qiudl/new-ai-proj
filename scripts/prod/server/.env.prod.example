# 生产环境变量配置模板
# 复制到 /opt/ai-project/backend/.env.prod 并修改敏感信息

# ============================================
# 应用配置
# ============================================
APP_ENV=production
GIN_MODE=release
PORT=8080
LOG_LEVEL=info

# ============================================
# 数据库配置
# ============================================
DB_HOST=localhost
DB_PORT=5432
DB_USER=ai_prod_user
DB_PASSWORD=<CHANGE_THIS_PASSWORD>
DB_NAME=ai_project_prod
DB_SSL_MODE=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=300

# ============================================
# Redis配置
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=<CHANGE_THIS_PASSWORD>
REDIS_DB=0

# ============================================
# JWT认证配置
# ============================================
JWT_SECRET=<CHANGE_THIS_TO_A_LONG_RANDOM_STRING_AT_LEAST_32_CHARS>
JWT_EXPIRATION=24h

# ============================================
# 功能开关
# ============================================
FEATURE_SUPERADMIN_ENABLE=true
SUPER_ADMIN_USERNAMES=admin

# ============================================
# CORS配置
# ============================================
CORS_ORIGINS=https://ai.example.com,http://localhost:3000

# ============================================
# 文件上传配置
# ============================================
MAX_UPLOAD_SIZE=10485760
UPLOAD_PATH=/opt/ai-project/uploads

# ============================================
# 日志配置
# ============================================
LOG_PATH=/opt/ai-project/logs
LOG_MAX_SIZE=100
LOG_MAX_BACKUPS=5
LOG_MAX_AGE=30
