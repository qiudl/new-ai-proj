# AI项目隧道和数据库同步配置模板
# 复制此文件到 ~/.ai-proj-tunnel.env 并填入实际值

# ============================================================================
# SSH 连接配置
# ============================================================================
# SSH 密钥路径 (用于连接远程服务器)
DIRECT_SSH_KEY=$HOME/.ssh/ai_proj.pem

# 远程服务器配置
REMOTE_HOST=ubuntu@your-server-ip

# ============================================================================
# 远程数据库配置 (通过 SSH 隧道访问)
# ============================================================================
REMOTE_DB_HOST=localhost
REMOTE_DB_PORT=5433
REMOTE_DB_USER=ai_prod_user
REMOTE_DB_PASSWORD=your_remote_db_password
REMOTE_DB_NAME=ai_project_prod

# 用于 psql 连接
DB_PASSWORD=your_remote_db_password

# ============================================================================
# 本地数据库配置 (本机 PostgreSQL)
# ============================================================================
LOCAL_DB_HOST=localhost
LOCAL_DB_PORT=5432
LOCAL_DB_USER=ai_dev
LOCAL_DB_PASSWORD=your_local_db_password
LOCAL_DB_NAME=ai_project_local
