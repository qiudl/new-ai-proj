# AI项目数据库隧道配置文件示例
# 使用方法: cp .ai-proj-tunnel.env.example ~/.ai-proj-tunnel.env
# 然后编辑 ~/.ai-proj-tunnel.env 填入实际密码

# 数据库连接配置
export DB_USER="ai_prod_user"
export DB_PASSWORD="your_secure_password_here"
export DB_NAME="ai_project_prod"

# 注意：
# 1. 此文件应添加到 .gitignore，不要提交到代码库
# 2. 在生产环境中，使用环境变量或密钥管理服务
# 3. 不要在脚本中硬编码密码
