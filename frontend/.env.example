# Google API配置
# 从 https://console.developers.google.com 获取
REACT_APP_GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
REACT_APP_GOOGLE_API_KEY=your_google_api_key_here

# Google API作用域（可选，已在代码中定义）
# REACT_APP_GOOGLE_SCOPES=https://www.googleapis.com/auth/documents,https://www.googleapis.com/auth/drive.file

# 其他API配置
REACT_APP_API_BASE_URL=http://localhost:8080/api/v1
REACT_APP_WEBSOCKET_URL=ws://localhost:8080/ws

# 功能开关
REACT_APP_ENABLE_GOOGLE_DOCS=true
REACT_APP_ENABLE_COLLABORATION=true
REACT_APP_ENABLE_INTELLIGENT_SEARCH=true

# 调试模式
REACT_APP_DEBUG_MODE=false
REACT_APP_LOG_LEVEL=info