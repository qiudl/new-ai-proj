import React, { useState, useEffect, useMemo } from 'react';
import { Card, Statistic, Typography, Space, Row, Col, message, Progress, Button, Tooltip, Avatar, List, Tag } from 'antd';
import { 
  ClockCircleOutlined, 
  CheckCircleOutlined, 
  InboxOutlined, 
  TrophyOutlined,
  FireOutlined,
  ReloadOutlined,
  CalendarOutlined,
  ThunderboltOutlined,
  BarChartOutlined
} from '@ant-design/icons';
import TimerService from '../../services/timerService';
import { TimerStatsResponse } from '../../types/timer';
import './EnhancedTodayStats.css';

const { Text, Title } = Typography;

interface EnhancedTodayStatsProps {
  refreshTrigger?: number;
  showDetailedView?: boolean;
  enableAnimations?: boolean;
}

interface PerformanceMetrics {
  efficiency: number;
  productivity: number;
  focusStreak: number;
  dailyGoalProgress: number;
}

const EnhancedTodayStats: React.FC<EnhancedTodayStatsProps> = ({ 
  refreshTrigger, 
  showDetailedView = true,
  enableAnimations = true 
}) => {
  const [stats, setStats] = useState<TimerStatsResponse | null>(null);
  const [loading, setLoading] = useState(false);
  const [lastUpdated, setLastUpdated] = useState<Date | null>(null);

  // 计算性能指标
  const performanceMetrics = useMemo((): PerformanceMetrics => {
    if (!stats) {
      return { efficiency: 0, productivity: 0, focusStreak: 0, dailyGoalProgress: 0 };
    }

    const totalSeconds = stats.today_total_seconds || 0;
    const completedTasks = stats.completed_tasks_today || 0;
    const inProgressTasks = stats.in_progress_tasks || 0;
    const recentTasks = stats.recent_tasks || [];

    // 效率计算：基于完成任务数和工作时间
    const efficiency = Math.min(100, (completedTasks * 20) + Math.min(50, totalSeconds / 144)); // 4小时=50分

    // 生产力计算：基于任务完成率和时间分配
    const totalTasks = completedTasks + inProgressTasks;
    const taskCompletionRate = totalTasks > 0 ? (completedTasks / totalTasks) * 100 : 0;
    const productivity = Math.min(100, (taskCompletionRate * 0.7) + (Math.min(30, totalSeconds / 240)));

    // 专注连击：基于最近任务的时间分布
    const focusStreak = Math.min(100, recentTasks.length * 15 + Math.min(40, totalSeconds / 180));

    // 每日目标进度：假设8小时工作目标
    const dailyGoalHours = 8;
    const dailyGoalProgress = Math.min(100, (totalSeconds / (dailyGoalHours * 3600)) * 100);

    return {
      efficiency: Math.round(efficiency),
      productivity: Math.round(productivity),
      focusStreak: Math.round(focusStreak),
      dailyGoalProgress: Math.round(dailyGoalProgress)
    };
  }, [stats]);

  const loadStats = async () => {
    setLoading(true);
    try {
      const response = await TimerService.getTimerStats();
      setStats(response);
      setLastUpdated(new Date());
    } catch (error) {
      console.error('Failed to load today stats:', error);
      message.error('加载今日统计失败');
    } finally {
      setLoading(false);
    }
  };

  useEffect(() => {
    loadStats();
  }, [refreshTrigger]);

  // 格式化时间显示
  const formatTimeDisplay = (seconds: number): { hours: number; minutes: number; display: string } => {
    const hours = Math.floor(seconds / 3600);
    const minutes = Math.floor((seconds % 3600) / 60);
    return {
      hours,
      minutes,
      display: `${hours}h ${minutes}m`
    };
  };

  // 获取效率等级颜色
  const getEfficiencyColor = (value: number): string => {
    if (value >= 80) return '#52c41a';
    if (value >= 60) return '#faad14';
    if (value >= 40) return '#fa8c16';
    return '#f5222d';
  };

  // 获取今日状态描述
  const getTodayStatusText = (): string => {
    const { efficiency, productivity } = performanceMetrics;
    const avgScore = (efficiency + productivity) / 2;
    
    if (avgScore >= 80) return '状态极佳，保持节奏！';
    if (avgScore >= 60) return '表现良好，继续加油！';
    if (avgScore >= 40) return '还需努力，加把劲！';
    return '刚刚开始，未来可期！';
  };

  // 默认显示数据
  const displayStats = stats || {
    today_total_seconds: 0,
    today_formatted_time: '00:00:00',
    completed_tasks_today: 0,
    in_progress_tasks: 0,
    recent_tasks: [],
    task_time_breakdown: []
  };

  const timeData = formatTimeDisplay(displayStats.today_total_seconds);

  return (
    <div className={`enhanced-today-stats ${enableAnimations ? 'animated' : ''}`}>
      <Card
        className="enhanced-stats-card"
        title={
          <div className="card-header">
            <Space>
              <div className="header-icon">
                <ClockCircleOutlined className="main-icon" />
              </div>
              <div className="header-text">
                <Title level={4} style={{ margin: 0, color: '#262626' }}>
                  今日工作概览
                </Title>
                <Text type="secondary" style={{ fontSize: '12px' }}>
                  {lastUpdated ? `更新于 ${lastUpdated.toLocaleTimeString()}` : ''}
                </Text>
              </div>
            </Space>
          </div>
        }
        extra={
          <Button
            type="text"
            icon={<ReloadOutlined />}
            onClick={loadStats}
            loading={loading}
            size="small"
            className="refresh-btn"
          />
        }
        loading={loading}
      >
        {/* 主要统计指标 */}
        <div className="main-metrics">
          <Row gutter={[16, 16]}>
            {/* 今日工作时间 - 大型显示 */}
            <Col span={24}>
              <div className="primary-metric">
                <div className="time-display">
                  <div className="time-value">
                    <span className="hours">{timeData.hours}</span>
                    <span className="unit">小时</span>
                    <span className="minutes">{timeData.minutes}</span>
                    <span className="unit">分钟</span>
                  </div>
                  <div className="time-subtitle">
                    <CalendarOutlined /> 今日累计工作时间
                  </div>
                </div>
                
                {/* 每日目标进度条 */}
                <div className="goal-progress">
                  <Progress
                    percent={performanceMetrics.dailyGoalProgress}
                    strokeColor={{
                      '0%': '#108ee9',
                      '100%': '#87d068',
                    }}
                    trailColor="#f0f0f0"
                    strokeWidth={8}
                    showInfo={false}
                  />
                  <Text type="secondary" style={{ fontSize: '12px', marginTop: '4px' }}>
                    每日目标进度：{performanceMetrics.dailyGoalProgress}%
                  </Text>
                </div>
              </div>
            </Col>
          </Row>
        </div>

        {/* 次要统计指标 */}
        <div className="secondary-metrics" style={{ marginTop: '24px' }}>
          <Row gutter={16}>
            <Col span={8}>
              <div className="metric-card completed">
                <div className="metric-icon">
                  <CheckCircleOutlined />
                </div>
                <Statistic
                  title="已完成"
                  value={displayStats.completed_tasks_today}
                  suffix="个任务"
                  valueStyle={{ 
                    color: '#52c41a',
                    fontSize: '20px',
                    fontWeight: 'bold'
                  }}
                />
              </div>
            </Col>

            <Col span={8}>
              <div className="metric-card in-progress">
                <div className="metric-icon">
                  <InboxOutlined />
                </div>
                <Statistic
                  title="进行中"
                  value={displayStats.in_progress_tasks}
                  suffix="个任务"
                  valueStyle={{ 
                    color: '#fa8c16',
                    fontSize: '20px',
                    fontWeight: 'bold'
                  }}
                />
              </div>
            </Col>

            <Col span={8}>
              <div className="metric-card efficiency">
                <div className="metric-icon">
                  <TrophyOutlined />
                </div>
                <Statistic
                  title="效率指数"
                  value={performanceMetrics.efficiency}
                  suffix="%"
                  valueStyle={{ 
                    color: getEfficiencyColor(performanceMetrics.efficiency),
                    fontSize: '20px',
                    fontWeight: 'bold'
                  }}
                />
              </div>
            </Col>
          </Row>
        </div>

        {/* 详细视图 */}
        {showDetailedView && (
          <>
            {/* 性能指标仪表板 */}
            <div className="performance-dashboard" style={{ marginTop: '24px' }}>
              <Title level={5} style={{ marginBottom: '16px', color: '#595959' }}>
                <BarChartOutlined /> 今日表现分析
              </Title>
              
              <Row gutter={[12, 12]}>
                <Col span={12}>
                  <div className="mini-progress">
                    <div className="progress-header">
                      <Text strong>工作效率</Text>
                      <Text type="secondary">{performanceMetrics.efficiency}%</Text>
                    </div>
                    <Progress
                      percent={performanceMetrics.efficiency}
                      strokeColor={getEfficiencyColor(performanceMetrics.efficiency)}
                      size="small"
                      showInfo={false}
                    />
                  </div>
                </Col>

                <Col span={12}>
                  <div className="mini-progress">
                    <div className="progress-header">
                      <Text strong>生产力</Text>
                      <Text type="secondary">{performanceMetrics.productivity}%</Text>
                    </div>
                    <Progress
                      percent={performanceMetrics.productivity}
                      strokeColor="#722ed1"
                      size="small"
                      showInfo={false}
                    />
                  </div>
                </Col>

                <Col span={12}>
                  <div className="mini-progress">
                    <div className="progress-header">
                      <Text strong>专注度</Text>
                      <Text type="secondary">{performanceMetrics.focusStreak}%</Text>
                    </div>
                    <Progress
                      percent={performanceMetrics.focusStreak}
                      strokeColor="#13c2c2"
                      size="small"
                      showInfo={false}
                    />
                  </div>
                </Col>

                <Col span={12}>
                  <div className="mini-progress">
                    <div className="progress-header">
                      <Text strong style={{ display: 'flex', alignItems: 'center', gap: '4px' }}>
                        <FireOutlined style={{ color: '#fa541c' }} />
                        连击
                      </Text>
                      <Text type="secondary">{Math.floor(performanceMetrics.focusStreak / 10)}</Text>
                    </div>
                    <div style={{ display: 'flex', gap: '2px', marginTop: '4px' }}>
                      {Array.from({ length: 10 }, (_, i) => (
                        <div
                          key={i}
                          style={{
                            width: '8px',
                            height: '8px',
                            borderRadius: '2px',
                            backgroundColor: i < Math.floor(performanceMetrics.focusStreak / 10) 
                              ? '#fa541c' 
                              : '#f0f0f0'
                          }}
                        />
                      ))}
                    </div>
                  </div>
                </Col>
              </Row>
            </div>

            {/* 最近任务活动 */}
            {displayStats.recent_tasks && displayStats.recent_tasks.length > 0 && (
              <div className="recent-activity" style={{ marginTop: '24px' }}>
                <Title level={5} style={{ marginBottom: '12px', color: '#595959' }}>
                  <ThunderboltOutlined /> 最近活动
                </Title>
                
                <List
                  size="small"
                  dataSource={displayStats.recent_tasks.slice(0, 3)}
                  renderItem={(task, index) => (
                    <List.Item className="activity-item">
                      <div className="activity-content">
                        <div className="activity-main">
                          <Avatar 
                            size="small" 
                            style={{ 
                              backgroundColor: ['#1890ff', '#52c41a', '#fa8c16'][index],
                              fontSize: '10px'
                            }}
                          >
                            {index + 1}
                          </Avatar>
                          <div className="activity-text">
                            <Text ellipsis style={{ maxWidth: '140px', fontWeight: 500 }}>
                              {task.task_title || '未知任务'}
                            </Text>
                            <br />
                            <Text type="secondary" style={{ fontSize: '11px' }}>
                              {task.project_name || '未知项目'}
                            </Text>
                          </div>
                        </div>
                        <div className="activity-time">
                          <Tag color="blue" style={{ fontSize: '10px', margin: 0 }}>
                            {task.formatted_time || '00:00:00'}
                          </Tag>
                        </div>
                      </div>
                    </List.Item>
                  )}
                />
              </div>
            )}

            {/* 今日状态总结 */}
            <div className="daily-summary" style={{ marginTop: '20px' }}>
              <div className="summary-card">
                <div className="summary-content">
                  <div className="summary-icon">
                    {performanceMetrics.efficiency >= 80 ? (
                      <TrophyOutlined style={{ color: '#52c41a', fontSize: '16px' }} />
                    ) : performanceMetrics.efficiency >= 60 ? (
                      <FireOutlined style={{ color: '#faad14', fontSize: '16px' }} />
                    ) : (
                      <ThunderboltOutlined style={{ color: '#1890ff', fontSize: '16px' }} />
                    )}
                  </div>
                  <div className="summary-text">
                    <Text strong style={{ fontSize: '13px' }}>
                      {getTodayStatusText()}
                    </Text>
                  </div>
                </div>
              </div>
            </div>
          </>
        )}

        {/* 空状态 */}
        {(!displayStats.today_total_seconds && !displayStats.completed_tasks_today) && (
          <div className="empty-state" style={{ 
            textAlign: 'center', 
            marginTop: '24px',
            padding: '32px 16px',
            background: 'linear-gradient(135deg, #f6f9fc 0%, #e9f4f7 100%)',
            borderRadius: '12px',
            border: '1px dashed #d9d9d9'
          }}>
            <ClockCircleOutlined style={{ fontSize: '48px', color: '#d9d9d9', marginBottom: '16px' }} />
            <Title level={4} style={{ color: '#8c8c8c', marginBottom: '8px' }}>
              新的一天开始了！
            </Title>
            <Text type="secondary" style={{ fontSize: '14px' }}>
              开始您的第一个任务，记录今天的工作时光
            </Text>
          </div>
        )}
      </Card>
    </div>
  );
};

export default EnhancedTodayStats;