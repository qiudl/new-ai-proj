import React, { useState, useEffect, useCallback, useMemo } from 'react';
import { 
  Card, 
  Statistic, 
  Row, 
  Col, 
  Button, 
  DatePicker, 
  Space, 
  message, 
  Spin, 
  Typography, 
  Table, 
  Tabs, 
  Tooltip,
  Select,
  Divider,
  Tag,
  Progress,
  Empty
} from 'antd';
import { 
  DownloadOutlined, 
  BarChartOutlined, 
  ClockCircleOutlined, 
  TrophyOutlined,
  LineChartOutlined,
  PieChartOutlined,
  CalendarOutlined,
  FilterOutlined,
  ExportOutlined,
  ReloadOutlined,
  RiseOutlined,
  FallOutlined
} from '@ant-design/icons';
import TimerService from '../../services/timerService';
import { TimerStatsResponse } from '../../types/timer';
import dayjs, { Dayjs } from 'dayjs';
import './EnhancedTimerStats.css';

const { RangePicker } = DatePicker;
const { Title, Text } = Typography;
const { TabPane } = Tabs;
const { Option } = Select;

interface EnhancedTimerStatsProps {
  refreshTrigger?: number;
  defaultView?: 'overview' | 'detailed' | 'trends';
  showExportOptions?: boolean;
}

interface DailyStats {
  date: string;
  totalTime: number;
  formattedTime: string;
  taskCount: number;
  tasks: string[];
  efficiency: number;
  productivity: number;
}

interface TrendAnalysis {
  weekOverWeek: number;
  dailyAverage: number;
  peakHours: string[];
  productivityTrend: 'increasing' | 'decreasing' | 'stable';
  recommendations: string[];
}

const EnhancedTimerStats: React.FC<EnhancedTimerStatsProps> = ({ 
  refreshTrigger, 
  defaultView = 'overview',
  showExportOptions = true
}) => {
  const [stats, setStats] = useState<TimerStatsResponse | null>(null);
  const [loading, setLoading] = useState(false);
  const [activeTab, setActiveTab] = useState(defaultView);
  const [dateRange, setDateRange] = useState<[Dayjs, Dayjs]>([
    dayjs().subtract(7, 'days'),
    dayjs()
  ]);
  const [dailyStats, setDailyStats] = useState<DailyStats[]>([]);
  const [weeklyReport, setWeeklyReport] = useState<any>(null);
  const [viewMode, setViewMode] = useState<'week' | 'month' | 'quarter'>('week');

  // 趋势分析计算
  const trendAnalysis = useMemo((): TrendAnalysis => {
    if (!dailyStats.length) {
      return {
        weekOverWeek: 0,
        dailyAverage: 0,
        peakHours: [],
        productivityTrend: 'stable',
        recommendations: ['开始记录时间以获得分析数据']
      };
    }

    const totalTime = dailyStats.reduce((sum, day) => sum + day.totalTime, 0);
    const dailyAverage = totalTime / dailyStats.length;
    
    // 计算周环比变化
    const firstHalf = dailyStats.slice(0, Math.floor(dailyStats.length / 2));
    const secondHalf = dailyStats.slice(Math.floor(dailyStats.length / 2));
    
    const firstHalfAvg = firstHalf.reduce((sum, day) => sum + day.totalTime, 0) / firstHalf.length;
    const secondHalfAvg = secondHalf.reduce((sum, day) => sum + day.totalTime, 0) / secondHalf.length;
    
    const weekOverWeek = firstHalfAvg > 0 ? ((secondHalfAvg - firstHalfAvg) / firstHalfAvg) * 100 : 0;

    // 分析生产力趋势
    const efficiencyTrend = dailyStats.map(day => day.efficiency);
    const trendSlope = efficiencyTrend.length > 1 ? 
      (efficiencyTrend[efficiencyTrend.length - 1] - efficiencyTrend[0]) / efficiencyTrend.length : 0;
    
    const productivityTrend = trendSlope > 5 ? 'increasing' : trendSlope < -5 ? 'decreasing' : 'stable';

    // 生成推荐
    const recommendations: string[] = [];
    if (dailyAverage < 4 * 3600) {
      recommendations.push('建议增加每日专注时间至4小时以上');
    }
    if (weekOverWeek < -10) {
      recommendations.push('工作时间呈下降趋势，考虑调整工作计划');
    }
    if (productivityTrend === 'decreasing') {
      recommendations.push('效率呈下降趋势，建议优化工作方法');
    }
    if (recommendations.length === 0) {
      recommendations.push('保持良好的工作节奏！');
    }

    return {
      weekOverWeek: Math.round(weekOverWeek * 10) / 10,
      dailyAverage: Math.round(dailyAverage),
      peakHours: ['9:00-11:00', '14:00-16:00'], // 模拟数据
      productivityTrend,
      recommendations
    };
  }, [dailyStats]);

  // 加载统计数据
  const loadStats = useCallback(async () => {
    setLoading(true);
    try {
      const [startDate, endDate] = dateRange;
      const weeklyReport = await TimerService.getWeeklyReport(
        startDate.format('YYYY-MM-DD'),
        endDate.format('YYYY-MM-DD')
      );
      
      setWeeklyReport(weeklyReport);
      
      // 设置基础统计
      setStats({
        today_total_seconds: weeklyReport.weekly_stats?.total_time_seconds || 0,
        today_formatted_time: weeklyReport.weekly_stats?.total_formatted_time || '00:00:00',
        completed_tasks_today: weeklyReport.weekly_stats?.total_tasks || 0,
        in_progress_tasks: 0,
        recent_tasks: [],
        task_time_breakdown: weeklyReport.task_time_entries || []
      });
      
      // 生成每日统计数据
      generateDailyStatsFromAPI(weeklyReport);
    } catch (error) {
      console.error('Failed to load timer stats:', error);
      message.error('加载计时统计失败');
    } finally {
      setLoading(false);
    }
  }, [dateRange]);

  // 从API数据生成每日统计
  const generateDailyStatsFromAPI = (weeklyReport: any) => {
    const days: DailyStats[] = [];
    const [startDate, endDate] = dateRange;
    
    const apiDailyStats = weeklyReport.daily_stats || [];
    const dailyDataMap = new Map();
    
    apiDailyStats.forEach((dayData: any) => {
      dailyDataMap.set(dayData.date, dayData);
    });
    
    for (let i = 0; i <= endDate.diff(startDate, 'day'); i++) {
      const currentDate = startDate.add(i, 'day');
      const dateString = currentDate.format('YYYY-MM-DD');
      const apiDayData = dailyDataMap.get(dateString);
      
      const totalTime = apiDayData?.total_time_seconds || 0;
      const taskCount = apiDayData?.task_count || 0;
      
      // 计算效率和生产力指标
      const efficiency = Math.min(100, Math.max(0, (totalTime / 28800) * 100)); // 基于8小时工作日
      const productivity = Math.min(100, Math.max(0, (taskCount * 20) + (totalTime / 360))); // 任务数量和时间综合
      
      const dayData: DailyStats = {
        date: dateString,
        totalTime,
        formattedTime: apiDayData?.formatted_time || TimerService.formatDuration(totalTime),
        taskCount,
        tasks: apiDayData?.task_names || [],
        efficiency: Math.round(efficiency),
        productivity: Math.round(productivity)
      };
      
      days.push(dayData);
    }
    
    setDailyStats(days);
  };

  // 导出数据
  const exportToCSV = () => {
    if (!stats || dailyStats.length === 0) {
      message.warning('没有可导出的数据');
      return;
    }

    const csvHeaders = ['日期', '总时长', '任务数量', '效率%', '生产力%', '任务列表'];
    const csvData = dailyStats.map(day => [
      day.date,
      day.formattedTime,
      day.taskCount.toString(),
      day.efficiency.toString(),
      day.productivity.toString(),
      day.tasks.join('; ')
    ]);

    const csvContent = [
      csvHeaders.join(','),
      ...csvData.map(row => row.map(cell => `"${cell}"`).join(','))
    ].join('\n');

    const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
    const link = document.createElement('a');
    const url = URL.createObjectURL(blob);
    
    link.setAttribute('href', url);
    link.setAttribute('download', `timer_stats_${dateRange[0].format('YYYY-MM-DD')}_${dateRange[1].format('YYYY-MM-DD')}.csv`);
    link.style.visibility = 'hidden';
    
    document.body.appendChild(link);
    link.click();
    document.body.removeChild(link);
    
    message.success('统计数据已导出');
  };

  // 处理日期范围变化
  const handleDateRangeChange = (dates: [Dayjs | null, Dayjs | null] | null) => {
    if (dates && dates[0] && dates[1]) {
      setDateRange([dates[0], dates[1]]);
    }
  };

  // 快速日期选择
  const setQuickDateRange = (range: 'week' | 'month' | 'quarter') => {
    const end = dayjs();
    let start: Dayjs;
    
    switch (range) {
      case 'week':
        start = end.subtract(7, 'days');
        break;
      case 'month':
        start = end.subtract(1, 'month');
        break;
      case 'quarter':
        start = end.subtract(3, 'months');
        break;
      default:
        start = end.subtract(7, 'days');
    }
    
    setDateRange([start, end]);
    setViewMode(range);
  };

  useEffect(() => {
    loadStats();
  }, [loadStats, refreshTrigger]);

  // 表格列定义
  const detailedStatsColumns = [
    {
      title: '日期',
      dataIndex: 'date',
      key: 'date',
      render: (date: string) => (
        <div>
          <Text strong>{dayjs(date).format('MM/DD')}</Text>
          <br />
          <Text type="secondary" style={{ fontSize: '11px' }}>
            {dayjs(date).format('ddd')}
          </Text>
        </div>
      ),
      width: 80,
    },
    {
      title: '工作时长',
      dataIndex: 'formattedTime',
      key: 'formattedTime',
      render: (time: string, record: DailyStats) => (
        <div>
          <Text strong style={{ fontFamily: 'monospace' }}>{time}</Text>
          <div style={{ marginTop: '2px' }}>
            <Progress
              percent={Math.min(100, (record.totalTime / 28800) * 100)}
              size="small"
              strokeColor="#1890ff"
              showInfo={false}
            />
          </div>
        </div>
      ),
      sorter: (a: DailyStats, b: DailyStats) => a.totalTime - b.totalTime,
    },
    {
      title: '任务数',
      dataIndex: 'taskCount',
      key: 'taskCount',
      render: (count: number) => (
        <Tag color={count > 5 ? 'green' : count > 2 ? 'orange' : 'blue'}>
          {count} 个
        </Tag>
      ),
      sorter: (a: DailyStats, b: DailyStats) => a.taskCount - b.taskCount,
      width: 80,
    },
    {
      title: '效率',
      dataIndex: 'efficiency',
      key: 'efficiency',
      render: (efficiency: number) => (
        <div style={{ textAlign: 'center' }}>
          <Progress
            type="circle"
            percent={efficiency}
            size={40}
            strokeColor={
              efficiency >= 80 ? '#52c41a' : 
              efficiency >= 60 ? '#faad14' : 
              efficiency >= 40 ? '#fa8c16' : '#f5222d'
            }
          />
        </div>
      ),
      sorter: (a: DailyStats, b: DailyStats) => a.efficiency - b.efficiency,
      width: 80,
    },
    {
      title: '主要任务',
      dataIndex: 'tasks',
      key: 'tasks',
      render: (tasks: string[]) => (
        <div>
          {tasks.slice(0, 2).map((task, index) => (
            <div key={index} style={{ marginBottom: '2px' }}>
              <Text ellipsis style={{ maxWidth: '120px', fontSize: '12px' }}>
                {task}
              </Text>
            </div>
          ))}
          {tasks.length > 2 && (
            <Text type="secondary" style={{ fontSize: '11px' }}>
              +{tasks.length - 2} 更多
            </Text>
          )}
        </div>
      ),
    },
  ];

  const totalTime = dailyStats.reduce((sum, day) => sum + day.totalTime, 0);
  const avgDaily = dailyStats.length > 0 ? totalTime / dailyStats.length : 0;
  const totalTasks = dailyStats.reduce((sum, day) => sum + day.taskCount, 0);
  const avgEfficiency = dailyStats.length > 0 ? 
    dailyStats.reduce((sum, day) => sum + day.efficiency, 0) / dailyStats.length : 0;

  return (
    <div className="enhanced-timer-stats">
      <Card
        className="enhanced-timer-stats-card"
        title={
          <div className="stats-header">
            <Space>
              <LineChartOutlined className="header-icon" />
              <Title level={4} style={{ margin: 0 }}>时间统计分析</Title>
            </Space>
          </div>
        }
        extra={
          <Space>
            <Select
              value={viewMode}
              onChange={setQuickDateRange}
              size="small"
              style={{ width: 80 }}
            >
              <Option value="week">最近7天</Option>
              <Option value="month">最近1月</Option>
              <Option value="quarter">最近3月</Option>
            </Select>
            <RangePicker
              value={dateRange}
              onChange={handleDateRangeChange}
              format="MM-DD"
              size="small"
              allowClear={false}
            />
            {showExportOptions && (
              <Button
                type="primary"
                icon={<ExportOutlined />}
                onClick={exportToCSV}
                disabled={loading || !stats}
                size="small"
              >
                导出
              </Button>
            )}
            <Button
              icon={<ReloadOutlined />}
              onClick={loadStats}
              loading={loading}
              size="small"
            />
          </Space>
        }
      >
        <Spin spinning={loading}>
          <Tabs activeKey={activeTab} onChange={(key) => setActiveTab(key as 'overview' | 'detailed' | 'trends')} className="stats-tabs">
            <TabPane tab={
              <span>
                <BarChartOutlined />
                概览
              </span>
            } key="overview">
              {/* 关键指标概览 */}
              <Row gutter={[16, 16]} className="key-metrics">
                <Col xs={24} sm={12} md={6}>
                  <div className="metric-card primary">
                    <div className="metric-value">
                      <ClockCircleOutlined className="metric-icon" />
                      <Statistic
                        title="总时长"
                        value={TimerService.formatDuration(totalTime)}
                        valueStyle={{ color: '#1890ff', fontSize: '24px' }}
                      />
                    </div>
                  </div>
                </Col>
                
                <Col xs={24} sm={12} md={6}>
                  <div className="metric-card secondary">
                    <div className="metric-value">
                      <CalendarOutlined className="metric-icon" />
                      <Statistic
                        title="日均时长"
                        value={TimerService.formatDuration(Math.floor(avgDaily))}
                        valueStyle={{ color: '#52c41a', fontSize: '20px' }}
                      />
                    </div>
                  </div>
                </Col>
                
                <Col xs={24} sm={12} md={6}>
                  <div className="metric-card secondary">
                    <div className="metric-value">
                      <TrophyOutlined className="metric-icon" />
                      <Statistic
                        title="总任务数"
                        value={totalTasks}
                        valueStyle={{ color: '#fa8c16', fontSize: '20px' }}
                      />
                    </div>
                  </div>
                </Col>
                
                <Col xs={24} sm={12} md={6}>
                  <div className="metric-card secondary">
                    <div className="metric-value">
                      <RiseOutlined className="metric-icon" />
                      <Statistic
                        title="平均效率"
                        value={Math.round(avgEfficiency)}
                        suffix="%"
                        valueStyle={{ 
                          color: avgEfficiency >= 70 ? '#52c41a' : avgEfficiency >= 50 ? '#faad14' : '#f5222d',
                          fontSize: '20px'
                        }}
                      />
                    </div>
                  </div>
                </Col>
              </Row>

              {/* 趋势分析 */}
              <div className="trend-analysis" style={{ marginTop: '24px' }}>
                <Title level={5}>
                  <LineChartOutlined /> 趋势分析
                </Title>
                <Row gutter={16}>
                  <Col xs={24} md={12}>
                    <div className="trend-card">
                      <div className="trend-item">
                        <Text type="secondary">周环比变化</Text>
                        <div className="trend-value">
                          {trendAnalysis.weekOverWeek > 0 ? (
                            <span style={{ color: '#52c41a' }}>
                              <RiseOutlined /> +{trendAnalysis.weekOverWeek}%
                            </span>
                          ) : trendAnalysis.weekOverWeek < 0 ? (
                            <span style={{ color: '#f5222d' }}>
                              <FallOutlined /> {trendAnalysis.weekOverWeek}%
                            </span>
                          ) : (
                            <span style={{ color: '#8c8c8c' }}>持平</span>
                          )}
                        </div>
                      </div>
                      
                      <div className="trend-item">
                        <Text type="secondary">生产力趋势</Text>
                        <div className="trend-value">
                          <Tag color={
                            trendAnalysis.productivityTrend === 'increasing' ? 'green' :
                            trendAnalysis.productivityTrend === 'decreasing' ? 'red' : 'blue'
                          }>
                            {trendAnalysis.productivityTrend === 'increasing' ? '上升' :
                             trendAnalysis.productivityTrend === 'decreasing' ? '下降' : '稳定'}
                          </Tag>
                        </div>
                      </div>
                    </div>
                  </Col>
                  
                  <Col xs={24} md={12}>
                    <div className="recommendations">
                      <Text strong>建议</Text>
                      <ul style={{ marginTop: '8px', paddingLeft: '16px' }}>
                        {trendAnalysis.recommendations.map((rec, index) => (
                          <li key={index}>
                            <Text style={{ fontSize: '13px' }}>{rec}</Text>
                          </li>
                        ))}
                      </ul>
                    </div>
                  </Col>
                </Row>
              </div>
            </TabPane>

            <TabPane tab={
              <span>
                <PieChartOutlined />
                详细数据
              </span>
            } key="detailed">
              <div className="detailed-stats">
                <Table
                  dataSource={dailyStats}
                  columns={detailedStatsColumns}
                  rowKey="date"
                  size="small"
                  pagination={{
                    pageSize: 10,
                    showSizeChanger: false,
                    showQuickJumper: true,
                    showTotal: (total) => `共 ${total} 天数据`,
                  }}
                  scroll={{ x: true }}
                  className="stats-table"
                />
              </div>
            </TabPane>

            <TabPane tab={
              <span>
                <FilterOutlined />
                工作模式
              </span>
            } key="patterns">
              <div className="work-patterns">
                {dailyStats.length > 0 ? (
                  <Row gutter={[16, 16]}>
                    <Col xs={24} md={12}>
                      <div className="pattern-card">
                        <Title level={5}>工作习惯分析</Title>
                        <div className="pattern-metrics">
                          <div className="pattern-item">
                            <Text>活跃天数</Text>
                            <Progress
                              percent={Math.round((dailyStats.filter(day => day.totalTime > 0).length / dailyStats.length) * 100)}
                              strokeColor="#1890ff"
                            />
                          </div>
                          <div className="pattern-item">
                            <Text>高效天数（效率&gt;70%）</Text>
                            <Progress
                              percent={Math.round((dailyStats.filter(day => day.efficiency > 70).length / dailyStats.length) * 100)}
                              strokeColor="#52c41a"
                            />
                          </div>
                          <div className="pattern-item">
                            <Text>高产天数（&gt;3任务）</Text>
                            <Progress
                              percent={Math.round((dailyStats.filter(day => day.taskCount > 3).length / dailyStats.length) * 100)}
                              strokeColor="#fa8c16"
                            />
                          </div>
                        </div>
                      </div>
                    </Col>
                    
                    <Col xs={24} md={12}>
                      <div className="pattern-card">
                        <Title level={5}>时间分布</Title>
                        <div className="time-distribution">
                          <div className="distribution-item">
                            <Text>短时工作（&lt;2h）</Text>
                            <Text strong>
                              {dailyStats.filter(day => day.totalTime > 0 && day.totalTime < 7200).length} 天
                            </Text>
                          </div>
                          <div className="distribution-item">
                            <Text>标准工作（2-6h）</Text>
                            <Text strong>
                              {dailyStats.filter(day => day.totalTime >= 7200 && day.totalTime < 21600).length} 天
                            </Text>
                          </div>
                          <div className="distribution-item">
                            <Text>长时工作（&gt;6h）</Text>
                            <Text strong>
                              {dailyStats.filter(day => day.totalTime >= 21600).length} 天
                            </Text>
                          </div>
                        </div>
                      </div>
                    </Col>
                  </Row>
                ) : (
                  <Empty 
                    description="暂无数据分析"
                    image={Empty.PRESENTED_IMAGE_SIMPLE}
                  />
                )}
              </div>
            </TabPane>
          </Tabs>
        </Spin>
      </Card>
    </div>
  );
};

export default EnhancedTimerStats;