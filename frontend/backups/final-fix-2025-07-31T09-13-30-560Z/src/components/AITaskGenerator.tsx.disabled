import React, { useState, useEffect } from 'react';
import {
  Card,
  Form,
  Input,
  Select,
  Button,
  Space,
  Alert,
  Typography,
  Spin,
  Row,
  Col,
  Switch,
  InputNumber,
  Divider,
  Tag,
  Progress,
  message,
  Modal,
  List,
  Tooltip,
  Badge
} from 'antd';
import {
  RobotOutlined,
  ThunderboltOutlined,
  SettingOutlined,
  CheckCircleOutlined,
  ExclamationCircleOutlined,
  ClockCircleOutlined,
  DollarCircleOutlined,
  BulbOutlined,
  OptimizationOutlined,
  ReloadOutlined,
  SendOutlined
} from '@ant-design/icons';
import { AIProvider } from '../types/ai';
import { GeneratedTask, AITaskGenerationRequest, AITaskGenerationResponse } from '../types/aiTaskGenerator';
import aiTaskGeneratorService from '../services/aiTaskGeneratorService';
import TaskSelector from './TaskSelector';
import GeneratedTasksList from './GeneratedTasksList';
import TokenUsageDisplay from './TokenUsageDisplay';

const { Title, Text, Paragraph } = Typography;
const { TextArea } = Input;
const { Option } = Select;

interface TaskGenerationOptions {
  maxTasks: number;
  enableDuplicateCheck: boolean;
  enableDependencyAnalysis: boolean;
  enablePriorityAssignment: boolean;
  enableTimeEstimation: boolean;
  enableSkillTagging: boolean;
}

interface OptimizationOptions {
  deduplicateTasks: boolean;
  optimizeDependencies: boolean;
  balancePriorities: boolean;
  refineEstimates: boolean;
  enhanceTags: boolean;
}

/**
 * AI任务生成器组件
 * 提供智能任务生成、验证和优化功能
 */
const AITaskGenerator: React.FC = () => {
  const [form] = Form.useForm();
  const [loading, setLoading] = useState(false);
  const [validating, setValidating] = useState(false);
  const [optimizing, setOptimizing] = useState(false);
  const [generatedTasks, setGeneratedTasks] = useState<GeneratedTask[]>([]);
  const [lastResponse, setLastResponse] = useState<AITaskGenerationResponse | null>(null);
  const [selectedProjectId, setSelectedProjectId] = useState<number | null>(null);
  const [selectedParentTask, setSelectedParentTask] = useState<any>(null);
  const [showAdvancedOptions, setShowAdvancedOptions] = useState(false);
  const [validationResults, setValidationResults] = useState<any>(null);
  const [optimizationResults, setOptimizationResults] = useState<any>(null);

  const [generationOptions, setGenerationOptions] = useState<TaskGenerationOptions>({
    maxTasks: 10,
    enableDuplicateCheck: true,
    enableDependencyAnalysis: true,
    enablePriorityAssignment: true,
    enableTimeEstimation: true,
    enableSkillTagging: false
  });

  const [optimizationOptions, setOptimizationOptions] = useState<OptimizationOptions>({
    deduplicateTasks: true,
    optimizeDependencies: true,
    balancePriorities: true,
    refineEstimates: true,
    enhanceTags: false
  });

  const aiProviders = [
    { value: 'openai', label: 'OpenAI GPT', icon: '🤖' },
    { value: 'claude', label: 'Claude', icon: '🧠' },
    { value: 'deepseek', label: 'DeepSeek', icon: '🔍' }
  ];

  const parseModes = [
    { value: 'structured', label: '结构化解析', description: '适合明确的需求描述' },
    { value: 'free_text', label: '自由文本', description: '适合模糊的描述' },
    { value: 'mixed', label: '混合模式', description: '综合多种解析方式' }
  ];

  // 生成任务
  const handleGenerateTasks = async (values: any) => {
    try {
      setLoading(true);
      setValidationResults(null);
      setOptimizationResults(null);

      const request: AITaskGenerationRequest = {
        provider: values.provider as AIProvider,
        inputText: values.inputText,
        parseMode: values.parseMode || 'structured',
        projectId: selectedProjectId,
        parentTaskId: selectedParentTask?.id,
        options: {
          maxTasks: generationOptions.maxTasks,
          enableDuplicateCheck: generationOptions.enableDuplicateCheck,
          enableDependencyAnalysis: generationOptions.enableDependencyAnalysis,
          enablePriorityAssignment: generationOptions.enablePriorityAssignment,
          enableTimeEstimation: generationOptions.enableTimeEstimation,
          enableSkillTagging: generationOptions.enableSkillTagging
        }
      };

      const response = await aiTaskGeneratorService.generateTasks(request);
      
      if (response.success) {
        setGeneratedTasks(response.generatedTasks);
        setLastResponse(response);
        message.success(`成功生成 ${response.totalTasks} 个任务`);
      } else {
        message.error(response.message || '任务生成失败');
      }
    } catch (error: any) {
      message.error('任务生成失败: ' + (error.message || '未知错误'));
      console.error('Task generation failed:', error);
    } finally {
      setLoading(false);
    }
  };

  // 验证任务
  const handleValidateTasks = async () => {
    if (!generatedTasks.length) {
      message.warning('请先生成任务');
      return;
    }

    try {
      setValidating(true);
      const provider = form.getFieldValue('provider') as AIProvider;
      
      const response = await aiTaskGeneratorService.validateTasks({
        provider,
        generatedTasks,
        projectContext: selectedProjectId ? {
          projectId: selectedProjectId,
          projectName: '', // 实际使用时需要获取项目名称
          projectDesc: '',
          existingTasks: []
        } : undefined
      });

      setValidationResults(response);
      
      if (response.validationPassed) {
        message.success('任务验证通过');
      } else {
        message.warning(`发现 ${response.issues?.length || 0} 个问题`);
      }
    } catch (error: any) {
      message.error('任务验证失败: ' + (error.message || '未知错误'));
      console.error('Task validation failed:', error);
    } finally {
      setValidating(false);
    }
  };

  // 优化任务
  const handleOptimizeTasks = async () => {
    if (!generatedTasks.length) {
      message.warning('请先生成任务');
      return;
    }

    try {
      setOptimizing(true);
      const provider = form.getFieldValue('provider') as AIProvider;
      
      const response = await aiTaskGeneratorService.optimizeTasks({
        provider,
        generatedTasks,
        optimizationOptions
      });

      if (response.success) {
        setGeneratedTasks(response.optimizedTasks);
        setOptimizationResults(response);
        message.success('任务优化完成');
      } else {
        message.error('任务优化失败');
      }
    } catch (error: any) {
      message.error('任务优化失败: ' + (error.message || '未知错误'));
      console.error('Task optimization failed:', error);
    } finally {
      setOptimizing(false);
    }
  };

  // 重新生成
  const handleRegenerate = () => {
    form.submit();
  };

  return (
    <div>
      <Row gutter={[24, 24]}>
        {/* 左侧：任务生成配置 */}
        <Col xs={24} lg={12}>
          <Card
            title={
              <Space>
                <RobotOutlined />
                任务生成配置
              </Space>
            }
            extra={
              <Button
                type="link"
                icon={<SettingOutlined />}
                onClick={() => setShowAdvancedOptions(!showAdvancedOptions)}
              >
                {showAdvancedOptions ? '隐藏' : '显示'}高级选项
              </Button>
            }
          >
            <Form
              form={form}
              layout="vertical"
              onFinish={handleGenerateTasks}
              initialValues={{
                provider: 'openai',
                parseMode: 'structured'
              }}
            >
              {/* AI服务提供商选择 */}
              <Form.Item
                name="provider"
                label="AI服务提供商"
                rules={[{ required: true, message: '请选择AI服务提供商' }]}
              >
                <Select placeholder="选择AI服务">
                  {aiProviders.map(provider => (
                    <Option key={provider.value} value={provider.value}>
                      <Space>
                        <span>{provider.icon}</span>
                        {provider.label}
                      </Space>
                    </Option>
                  ))}
                </Select>
              </Form.Item>

              {/* 任务描述输入 */}
              <Form.Item
                name="inputText"
                label="任务描述"
                rules={[
                  { required: true, message: '请输入任务描述' },
                  { min: 10, message: '任务描述至少需要10个字符' },
                  { max: 10000, message: '任务描述不能超过10000个字符' }
                ]}
              >
                <TextArea
                  rows={6}
                  placeholder="请详细描述您想要创建的任务或项目...\\n\\n例如：创建一个用户管理系统，包括用户注册、登录、权限管理等功能"
                  showCount
                  maxLength={10000}
                />
              </Form.Item>

              {/* 解析模式 */}
              <Form.Item name="parseMode" label="解析模式">
                <Select>
                  {parseModes.map(mode => (
                    <Option key={mode.value} value={mode.value}>
                      <div>
                        <div>{mode.label}</div>
                        <Text type="secondary" style={{ fontSize: '12px' }}>
                          {mode.description}
                        </Text>
                      </div>
                    </Option>
                  ))}
                </Select>
              </Form.Item>

              {/* 项目和父任务选择 */}
              <Row gutter={[16, 16]}>
                <Col span={12}>
                  <Form.Item label="目标项目">
                    <TaskSelector
                      type="project"
                      value={selectedProjectId}
                      onChange={(projectId) => setSelectedProjectId(projectId)}
                      placeholder="选择项目（可选）"
                    />
                  </Form.Item>
                </Col>
                <Col span={12}>
                  <Form.Item label="父任务">
                    <TaskSelector
                      type="task"
                      projectId={selectedProjectId}
                      value={selectedParentTask}
                      onChange={(task) => setSelectedParentTask(task)}
                      placeholder="选择父任务（可选）"
                    />
                  </Form.Item>
                </Col>
              </Row>

              {/* 高级选项 */}
              {showAdvancedOptions && (
                <Card size="small" title="生成选项" style={{ marginBottom: '16px' }}>
                  <Row gutter={[16, 16]}>
                    <Col span={24}>
                      <Form.Item label="最大任务数量">
                        <InputNumber
                          min={1}
                          max={50}
                          value={generationOptions.maxTasks}
                          onChange={(value) => setGenerationOptions(prev => ({
                            ...prev,
                            maxTasks: value || 10
                          }))}
                          style={{ width: '100%' }}
                        />
                      </Form.Item>
                    </Col>
                    <Col span={12}>
                      <Space direction="vertical">
                        <Switch
                          checked={generationOptions.enableDuplicateCheck}
                          onChange={(checked) => setGenerationOptions(prev => ({
                            ...prev,
                            enableDuplicateCheck: checked
                          }))}
                        />
                        <Text>重复检查</Text>
                      </Space>
                    </Col>
                    <Col span={12}>
                      <Space direction="vertical">
                        <Switch
                          checked={generationOptions.enableDependencyAnalysis}
                          onChange={(checked) => setGenerationOptions(prev => ({
                            ...prev,
                            enableDependencyAnalysis: checked
                          }))}
                        />
                        <Text>依赖分析</Text>
                      </Space>
                    </Col>
                    <Col span={12}>
                      <Space direction="vertical">
                        <Switch
                          checked={generationOptions.enablePriorityAssignment}
                          onChange={(checked) => setGenerationOptions(prev => ({
                            ...prev,
                            enablePriorityAssignment: checked
                          }))}
                        />
                        <Text>优先级分配</Text>
                      </Space>
                    </Col>
                    <Col span={12}>
                      <Space direction="vertical">
                        <Switch
                          checked={generationOptions.enableTimeEstimation}
                          onChange={(checked) => setGenerationOptions(prev => ({
                            ...prev,
                            enableTimeEstimation: checked
                          }))}
                        />
                        <Text>时间估算</Text>
                      </Space>
                    </Col>
                    <Col span={12}>
                      <Space direction="vertical">
                        <Switch
                          checked={generationOptions.enableSkillTagging}
                          onChange={(checked) => setGenerationOptions(prev => ({
                            ...prev,
                            enableSkillTagging: checked
                          }))}
                        />
                        <Text>技能标签</Text>
                      </Space>
                    </Col>
                  </Row>
                </Card>
              )}

              {/* 生成按钮 */}
              <Form.Item>
                <Button
                  type="primary"
                  htmlType="submit"
                  icon={<SendOutlined />}
                  loading={loading}
                  size="large"
                  block
                >
                  {loading ? '正在生成任务...' : '生成任务'}
                </Button>
              </Form.Item>
            </Form>
          </Card>
        </Col>

        {/* 右侧：生成结果和操作 */}
        <Col xs={24} lg={12}>
          {/* 生成结果统计 */}
          {lastResponse && (
            <Card
              size="small"
              style={{ marginBottom: '16px' }}
              title={
                <Space>
                  <Badge status="success" />
                  生成结果
                </Space>
              }
            >
              <Row gutter={[16, 16]}>
                <Col span={8}>
                  <Statistic
                    title="任务数量"
                    value={lastResponse.totalTasks}
                    prefix={<CheckCircleOutlined />}
                  />
                </Col>
                <Col span={8}>
                  <Statistic
                    title="处理时间"
                    value={lastResponse.processingTime}
                    suffix="ms"
                    prefix={<ClockCircleOutlined />}
                  />
                </Col>
                <Col span={8}>
                  <Statistic
                    title="质量评分"
                    value={(lastResponse.qualityMetrics?.overallScore || 0) * 100}
                    suffix="%"
                    prefix={<BulbOutlined />}
                    precision={1}
                  />
                </Col>
              </Row>

              {/* Token使用情况 */}
              {lastResponse.tokenUsage && (
                <div style={{ marginTop: '16px' }}>
                  <TokenUsageDisplay tokenUsage={lastResponse.tokenUsage} />
                </div>
              )}
            </Card>
          )}

          {/* 任务操作按钮 */}
          {generatedTasks.length > 0 && (
            <Card size="small" style={{ marginBottom: '16px' }}>
              <Space wrap>
                <Button
                  icon={<CheckCircleOutlined />}
                  onClick={handleValidateTasks}
                  loading={validating}
                >
                  验证任务
                </Button>
                <Button
                  icon={<OptimizationOutlined />}
                  onClick={handleOptimizeTasks}
                  loading={optimizing}
                >
                  优化任务
                </Button>
                <Button
                  icon={<ReloadOutlined />}
                  onClick={handleRegenerate}
                  disabled={loading}
                >
                  重新生成
                </Button>
              </Space>
            </Card>
          )}

          {/* 验证结果 */}
          {validationResults && (
            <Alert
              type={validationResults.validationPassed ? 'success' : 'warning'}
              message={validationResults.validationPassed ? '验证通过' : '发现问题'}
              description={
                <div>
                  {validationResults.issues && validationResults.issues.length > 0 && (
                    <div>
                      <Text strong>问题：</Text>
                      <ul>
                        {validationResults.issues.map((issue: string, index: number) => (
                          <li key={index}>{issue}</li>
                        ))}
                      </ul>
                    </div>
                  )}
                  {validationResults.suggestions && validationResults.suggestions.length > 0 && (
                    <div>
                      <Text strong>建议：</Text>
                      <ul>
                        {validationResults.suggestions.map((suggestion: string, index: number) => (
                          <li key={index}>{suggestion}</li>
                        ))}
                      </ul>
                    </div>
                  )}
                </div>
              }
              style={{ marginBottom: '16px' }}
            />
          )}

          {/* 优化结果 */}
          {optimizationResults && (
            <Alert
              type="info"
              message="优化完成"
              description={
                <div>
                  <Text>应用了以下优化策略：</Text>
                  <ul>
                    {optimizationResults.optimizationsApplied?.map((opt: string, index: number) => (
                      <li key={index}>{opt}</li>
                    ))}
                  </ul>
                </div>
              }
              style={{ marginBottom: '16px' }}
            />
          )}

          {/* 生成的任务列表 */}
          {generatedTasks.length > 0 && (
            <Card
              title={
                <Space>
                  <CheckCircleOutlined />
                  生成的任务 ({generatedTasks.length})
                </Space>
              }
            >
              <GeneratedTasksList
                tasks={generatedTasks}
                onTasksChange={setGeneratedTasks}
                projectId={selectedProjectId}
                parentTaskId={selectedParentTask?.id}
              />
            </Card>
          )}

          {/* 空状态 */}
          {!loading && generatedTasks.length === 0 && (
            <Card>
              <div style={{ textAlign: 'center', padding: '60px 20px' }}>
                <RobotOutlined style={{ fontSize: '64px', color: '#d9d9d9' }} />
                <Title level={4} type="secondary">
                  等待任务生成
                </Title>
                <Paragraph type="secondary">
                  请在左侧填写任务描述，然后点击"生成任务"按钮
                </Paragraph>
              </div>
            </Card>
          )}
        </Col>
      </Row>
    </div>
  );
};

export default AITaskGenerator;