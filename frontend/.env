GENERATE_SOURCEMAP=false
PUBLIC_URL=/
# API URLs are set by .env.development or .env.production
# REACT_APP_API_URL - set by environment-specific files
# REACT_APP_API_BASE_URL - set by environment-specific files
CHOKIDAR_USEPOLLING=true
NO_PROXY=localhost,127.0.0.1
DISABLE_ESLINT_PLUGIN=true
TSC_COMPILE_ON_ERROR=true
ESLINT_NO_DEV_ERRORS=true
SKIP_PREFLIGHT_CHECK=true

# 环境标志配置 - 本地开发环境
REACT_APP_ENV=development
REACT_APP_ENVIRONMENT=development  
# 明确设置为本地开发环境
REACT_APP_LOCAL_DEV=true

# MCP端口配置 (测试环境)
REACT_APP_MCP_PORT=3100

# Webpack优化配置
FAST_REFRESH=true

# WebSocket配置 - 禁用HMR WebSocket避免连接错误
# WDS_SOCKET_PORT=3002
# WDS_SOCKET_HOST=localhost
# 禁用WebSocket连接，使用轮询模式
WDS_SOCKET_PORT=0
