# 前端开发环境性能优化配置
# 禁用不必要的功能以减少资源消耗

# TypeScript 检查优化
TSC_COMPILE_ON_ERROR=true
DISABLE_ESLINT_PLUGIN=true
SKIP_PREFLIGHT_CHECK=true

# 禁用 TypeScript 类型检查以提高性能
REACT_APP_TYPESCRIPT_CHECK=false
FORK_TS_CHECKER_WEBPACK_PLUGIN_MEMENTO=false

# 减少内存使用
NODE_OPTIONS=--max-old-space-size=1024 --optimize-for-size

# 禁用 source maps 以减少内存占用
GENERATE_SOURCEMAP=false

# webpack 优化
WEBPACK_CACHE=false
FAST_REFRESH=false

# 开发服务器优化
HOST=0.0.0.0
PORT=3000

# 禁用不必要的警告
CI=true
DISABLE_NEW_JSX_TRANSFORM=false