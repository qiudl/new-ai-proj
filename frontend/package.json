    "identity-obj-proxy": "^3.0.0",
    "jest-transform-stub": "^2.0.0",
    "prettier": "^2.8.8",
    "webpack-bundle-analyzer": "^4.10.2"
  },
  "overrides": {
    "typescript": "^5.3.3"
  }
