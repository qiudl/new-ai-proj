  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "build:cloudflare": "GENERATE_SOURCEMAP=false npm run build && npm run optimize:build",
    "optimize:build": "npm run compress:build && npm run copy:cf-files",
    "compress:build": "find build -name '*.js' -o -name '*.css' | xargs gzip -k",
    "copy:cf-files": "cp -f public/_redirects build/ && cp -f public/_headers build/",
    "deploy:cf": "npm run build:cloudflare && npx wrangler pages deploy build --project-name=ai-project-frontend",
    "preview:cf": "npm run build:cloudflare && npx wrangler pages deploy build --project-name=ai-project-frontend --env=preview",
    "test": "react-scripts test",
    "start:legacy": "react-scripts start",
    "build:legacy": "react-scripts build",
    "eject": "react-scripts eject",
    "lint": "eslint src --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint src --ext .js,.jsx,.ts,.tsx --fix",
    "format": "prettier --write src/**/*.{js,jsx,ts,tsx,json,css,md}",
    "type-check": "tsc --noEmit",
    "type-check:watch": "tsc --noEmit --watch",
    "type-check:dev": "tsc --project tsconfig.dev.json --noEmit",
    "type-check:strict": "tsc --noEmit --strict --noUnusedLocals --noUnusedParameters",
    "analyze": "npm run build && npx webpack-bundle-analyzer build/static/js/*.js",
    "ts:version": "npx tsc --version",
    "ts:info": "npx tsc --showConfig",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:impersonation": "playwright test e2e/impersonation.spec.ts",
    "test:e2e:security": "playwright test e2e/security.spec.ts",
    "test:e2e:performance": "playwright test e2e/performance.spec.ts",
    "test:e2e:smoke": "playwright test --grep='登录|基本功能|首页加载'",
    "test:e2e:mobile": "playwright test --project='Mobile Chrome' --project='Mobile Safari'",
    "test:e2e:report": "playwright show-report",
    "test:performance": "./scripts/run-performance-tests.sh all",
    "test:performance:lighthouse": "./scripts/run-performance-tests.sh lighthouse",
    "test:performance:benchmark": "./scripts/run-performance-tests.sh benchmark",
    "test:performance:load": "./scripts/run-performance-tests.sh load",
    "test:performance:memory": "./scripts/run-performance-tests.sh memory"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@babel/preset-env": "^7.28.0",
    "@babel/preset-react": "^7.27.1",
    "@babel/preset-typescript": "^7.27.1",
    "@faker-js/faker": "^10.0.0",
    "@types/cors": "^2.8.19",
    "@types/d3": "^7.4.3",
    "@types/express": "^4.17.23",
    "@types/file-saver": "^2.0.7",
    "@types/react-grid-layout": "^1.3.5",
    "@types/react-resizable": "^3.0.8",
    "@types/react-router-dom": "^5.3.3",
    "@types/react-transition-group": "^4.4.12",
    "@types/uuid": "^10.0.0",
    "babel-jest": "^30.0.5",
    "concurrently": "^9.2.1",
    "cors": "^2.8.5",
    "eslint": "^8.42.0",
    "eslint-config-prettier": "^8.8.0",
    "eslint-plugin-prettier": "^4.2.1",
    "eslint-webpack-plugin": "^5.0.2",
    "express": "^5.1.0",
    "http-proxy": "^1.18.1",
    "identity-obj-proxy": "^3.0.0",
    "jest-transform-stub": "^2.0.0",
    "json-server": "^1.0.0-beta.3",
    "prettier": "^2.8.8",
    "ts-node": "^10.9.2",
    "uuid": "^13.0.0",
    "webpack-bundle-analyzer": "^4.10.2",
    "wrangler": "^3.78.0"
  },
  "overrides": {
    "typescript": "^5.3.3"
  }
}
