# 生产环境配置
NODE_ENV=production
REACT_APP_ENV=production
REACT_APP_API_BASE_URL=https://proj.joylodging.com/api/v1
REACT_APP_API_URL=https://proj.joylodging.com/api/v1

# 明确声明非本地开发环境
REACT_APP_LOCAL_DEV=false

# 禁用Source Map以减小构建体积和提高安全性
GENERATE_SOURCEMAP=false

# 关闭ESLint warnings在生产构建中
ESLINT_NO_DEV_ERRORS=true
TSC_COMPILE_ON_ERROR=true
