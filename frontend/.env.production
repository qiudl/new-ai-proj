# Cloudflare Pages Production Environment
NODE_ENV=production
GENERATE_SOURCEMAP=false

# API 基础URL - 腾讯云服务器实际地址
REACT_APP_API_BASE_URL=http://152.136.104.251:8080/api/v1
REACT_APP_API_URL=http://152.136.104.251:8080/api/v1

# 应用配置
REACT_APP_APP_NAME=AI项目管理系统
REACT_APP_VERSION=1.0.0

# 功能开关
REACT_APP_ENABLE_ANALYTICS=true
REACT_APP_ENABLE_SW=true

# Cloudflare Pages 特定配置
BUILD_PATH=build
PUBLIC_URL=/

# 性能优化
INLINE_RUNTIME_CHUNK=false
IMAGE_INLINE_SIZE_LIMIT=0