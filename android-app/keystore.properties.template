# Keystore configuration for release builds
# DO NOT commit this file to version control!
# This is a template - create keystore.properties with your actual values

# Keystore file location (relative or absolute path)
storeFile=./release.keystore

# Keystore password
storePassword=YOUR_KEYSTORE_PASSWORD

# Key alias
keyAlias=aiproj-release

# Key password
keyPassword=YOUR_KEY_PASSWORD

# To generate a keystore, run:
# keytool -genkey -v -keystore release.keystore -alias aiproj-release -keyalg RSA -keysize 2048 -validity 10000
