# AI项目管理系统 - 生产环境配置
# 腾讯云服务器 152.136.104.251

# 环境标识
ENV=production
NODE_ENV=production
APP_ENV=production

# 域名配置
DOMAIN_NAME=152.136.104.251
# DOMAIN_NAME=yourdomain.com  # 如果有域名，替换上面的IP

# 数据库配置（生产环境强密码）
DB_HOST=postgres-prod
DB_PORT=5432
DB_USER=ai_prod_user
DB_PASSWORD=SecureAI2024!@#$%^
DB_NAME=ai_project_prod
DB_SSL_MODE=require
DB_SOURCE=postgresql://ai_prod_user:SecureAI2024!@#$%^@postgres-prod:5432/ai_project_prod?sslmode=require

# JWT安全配置
JWT_SECRET=ProductionJWTSecret2024!@#$%^&*()ABCDEF
JWT_EXPIRATION=24h

# 服务配置
BACKEND_PORT=8080
FRONTEND_PORT=80
GIN_MODE=release
LOG_LEVEL=info

# CORS配置
CORS_ORIGIN=https://152.136.104.251

# SSL配置
SSL_CERT_PATH=/etc/nginx/ssl/cert.pem
SSL_KEY_PATH=/etc/nginx/ssl/key.pem

# Redis配置
REDIS_URL=redis://redis-prod:6379

# MCP服务器配置
API_BASE_URL=http://backend-prod:8080/api/v1
TASK_API_BASE=http://backend-prod:8080/api/v1
MCP_ENABLE_PERMISSIONS=true
MCP_STRICT_PERMISSIONS=true
MCP_DEBUG_PERMISSIONS=false

# 安全配置
ENCRYPTION_KEY=ProductionEncryptionKey2024!@#$%^&*()
SESSION_SECRET=ProductionSessionSecret2024!@#$%^&*()

# 备份配置
BACKUP_SCHEDULE=0 2 * * *  # 每天凌晨2点备份
BACKUP_RETENTION_DAYS=30
BACKUP_DIR=/opt/backups

# 监控配置
ENABLE_MONITORING=true
LOG_RETENTION_DAYS=90
METRICS_ENABLED=true

# 性能配置
MAX_CONNECTIONS=100
CONNECTION_TIMEOUT=30s
RATE_LIMIT_REQUESTS=1000
RATE_LIMIT_WINDOW=1h

# 文件上传配置
MAX_UPLOAD_SIZE=50MB
UPLOAD_DIR=/app/uploads

# 邮件配置（如需要）
SMTP_HOST=smtp.qq.com
SMTP_PORT=587
SMTP_USER=your_email@qq.com
SMTP_PASSWORD=your_smtp_password
SMTP_FROM=noreply@yourdomain.com

# 企业功能配置
FEATURE_SUPERADMIN_ENABLE=true
SUPER_ADMIN_USERNAMES=admin,guoym,weier,fuxing
SUPER_ADMIN_IDS=1,2,34,43,112

# Google集成（如需要）
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_PROJECT_ID=your_google_project_id_here
GOOGLE_REDIRECT_URL=https://152.136.104.251/auth/google/callback
GOOGLE_CALENDAR_SCOPES=https://www.googleapis.com/auth/calendar

# 第三方服务（如需要）
SENTRY_DSN=your_sentry_dsn_here
ANALYTICS_ID=your_analytics_id_here

# 数据库连接池配置
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=5m

# 缓存配置
CACHE_TTL=1h
CACHE_MAX_SIZE=100MB

# 清除所有代理设置
HTTP_PROXY=""
HTTPS_PROXY=""
http_proxy=""
https_proxy=""
ALL_PROXY=""
all_proxy=""