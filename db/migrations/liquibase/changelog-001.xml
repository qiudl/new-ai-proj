<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="
    http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">

  <changeSet id="tasks-add-columns-and-indexes" author="agent">
    <addColumn tableName="tasks">
      <column name="snooze_until" type="timestamptz"/>
      <column name="on_hold_reason" type="text"/>
      <column name="blocked_reason" type="text"/>
      <column name="parent_id" type="bigint"/>
      <column name="depth" type="int" defaultValueNumeric="0"/>
      <column name="has_children" type="boolean" defaultValueBoolean="false"/>
      <column name="order_in_parent" type="int" defaultValueNumeric="0"/>
      <column name="path" type="text"/>
      <column name="rollup_cache" type="jsonb" defaultValue="{}"/>
    </addColumn>

    <createIndex tableName="tasks" indexName="idx_tasks_status">
      <column name="status"/>
    </createIndex>
    <createIndex tableName="tasks" indexName="idx_tasks_parent_order">
      <column name="parent_id"/>
      <column name="order_in_parent"/>
    </createIndex>
    <createIndex tableName="tasks" indexName="idx_tasks_updated_at">
      <column name="updated_at"/>
    </createIndex>
    <createIndex tableName="tasks" indexName="idx_tasks_status_due">
      <column name="status"/>
      <column name="due_date"/>
    </createIndex>

    <createIndex tableName="tasks" indexName="idx_tasks_due_active">
      <column name="due_date"/>
      <where>status NOT IN ('done','cancelled','archived') AND due_date IS NOT NULL</where>
    </createIndex>

    <createIndex tableName="tasks" indexName="idx_tasks_snooze">
      <column name="snooze_until"/>
      <where>snooze_until IS NOT NULL</where>
    </createIndex>
  </changeSet>
</databaseChangeLog>

