# AI项目管理平台 - 腾讯云生产环境配置
# 服务器: 152.136.104.251
# 重要：此文件包含敏感信息，请妥善保管

# ===================
# 数据库配置
# ===================
PROD_DB_NAME=ai_project_prod
PROD_DB_USER=prod_user
# 请设置强密码
PROD_DB_PASSWORD=CHANGE_ME_TO_SECURE_PASSWORD

# 数据库连接URL
PROD_DATABASE_URL=postgres://prod_user:CHANGE_ME_TO_SECURE_PASSWORD@db:5432/ai_project_prod?sslmode=disable

# ===================
# 安全配置
# ===================
# JWT密钥 - 请使用至少32位的随机字符串
PROD_JWT_SECRET=CHANGE_ME_TO_32_CHAR_RANDOM_STRING

# Redis密码
PROD_REDIS_PASSWORD=CHANGE_ME_TO_REDIS_PASSWORD

# ===================
# Google OAuth 配置
# ===================
# 需要在 Google Cloud Console 配置
PROD_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
PROD_GOOGLE_CLIENT_SECRET=your-google-client-secret

# ===================
# 域名配置
# ===================
PROD_DOMAIN=ai-project.com
PROD_API_DOMAIN=api.ai-project.com

# ===================
# SSL证书配置
# ===================
SSL_CERT_PATH=/etc/nginx/ssl/fullchain.pem
SSL_KEY_PATH=/etc/nginx/ssl/privkey.pem

# ===================
# 邮件配置（可选）
# ===================
SMTP_HOST=smtp.tencent.com
SMTP_PORT=465
SMTP_USER=your-email@ai-project.com
SMTP_PASSWORD=your-smtp-password

# ===================
# 监控和日志
# ===================
LOG_RETENTION_DAYS=30
BACKUP_RETENTION_DAYS=7

# ===================
# 性能配置
# ===================
MAX_REQUEST_SIZE=50MB
RATE_LIMIT_REQUESTS=1000
RATE_LIMIT_WINDOW=15m