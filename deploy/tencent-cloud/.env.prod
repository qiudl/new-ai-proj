# 腾讯云生产环境配置文件
# ⚠️  注意：此文件包含敏感信息，请确保不会提交到版本控制系统

# ===========================================
# 应用基础配置
# ===========================================
APP_ENV=production
APP_VERSION=1.0.0
APP_SECRET=your-super-secret-app-key-change-this-in-production
DOMAIN_NAME=yourdomain.com

# ===========================================
# 数据库配置
# ===========================================
POSTGRES_DB=ai_project_prod
POSTGRES_USER=ai_prod_user
POSTGRES_PASSWORD=your-super-strong-postgres-password-change-this

# ===========================================
# Redis配置
# ===========================================
REDIS_PASSWORD=your-super-strong-redis-password-change-this

# ===========================================
# JWT认证配置
# ===========================================
JWT_SECRET=your-super-secret-jwt-key-at-least-32-characters-long

# ===========================================
# 前端应用配置
# ===========================================
REACT_APP_API_BASE_URL=https://yourdomain.com/api/v1
REACT_APP_APP_NAME=AI项目管理系统
REACT_APP_VERSION=1.0.0

# ===========================================
# CORS和安全配置
# ===========================================
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
TRUSTED_PROXIES=127.0.0.1

# ===========================================
# SSL证书配置
# ===========================================
SSL_EMAIL=your-email@domain.com
SSL_DOMAINS=yourdomain.com,www.yourdomain.com

# ===========================================
# 监控和日志配置
# ===========================================
LOG_LEVEL=info
SENTRY_DSN=  # 可选：Sentry错误监控
ANALYTICS_ID=  # 可选：Google Analytics

# ===========================================
# 文件上传配置
# ===========================================
MAX_UPLOAD_SIZE=10485760  # 10MB
ALLOWED_FILE_TYPES=jpg,jpeg,png,gif,pdf,doc,docx

# ===========================================
# 邮件服务配置（可选）
# ===========================================
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@yourdomain.com
SMTP_PASS=your-smtp-password
SMTP_FROM=AI项目管理系统 <noreply@yourdomain.com>

# ===========================================
# 腾讯云特定配置（可选）
# ===========================================
# 腾讯云COS存储配置
TENCENT_COS_SECRET_ID=
TENCENT_COS_SECRET_KEY=
TENCENT_COS_REGION=ap-beijing
TENCENT_COS_BUCKET=

# 腾讯云SMS短信配置
TENCENT_SMS_SECRET_ID=
TENCENT_SMS_SECRET_KEY=
TENCENT_SMS_APP_ID=
TENCENT_SMS_SIGN=

# ===========================================
# 备份配置
# ===========================================
BACKUP_SCHEDULE=0 2 * * *  # 每天凌晨2点备份
BACKUP_RETENTION_DAYS=30
BACKUP_LOCATION=/opt/ai-project/backups

# ===========================================
# 性能和缓存配置
# ===========================================
REDIS_CACHE_TTL=3600  # 1小时
SESSION_TIMEOUT=86400  # 24小时
API_RATE_LIMIT=1000  # 每小时1000次请求

# ===========================================
# 开发调试配置（生产环境应为false）
# ===========================================
DEBUG=false
ENABLE_PROFILER=false
ENABLE_SWAGGER=false