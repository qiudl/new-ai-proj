# AI项目管理系统 - Go后端生产环境Dockerfile
# 多阶段构建：构建阶段 + 生产阶段

# 第一阶段：构建阶段
FROM golang:1.23-alpine AS builder

# 设置工作目录
WORKDIR /app

# 安装必要的系统依赖
RUN apk add --no-cache \
    git \
    ca-certificates \
    tzdata \
    gcc \
    g++ \
    libc-dev \
    && rm -rf /var/cache/apk/*

# 设置 Go 环境变量
ENV GO111MODULE=on \
    CGO_ENABLED=1 \
    GOOS=linux \
    GOARCH=amd64

# 复制 go.mod 和 go.sum
COPY backend/go.mod backend/go.sum ./

# 下载依赖
RUN go mod download && go mod verify

# 复制后端源代码
COPY backend/ .

# 构建应用
RUN go build -a -installsuffix cgo \
    -ldflags '-w -s -extldflags "-static"' \
    -o ai-project-backend ./main.go

# 第二阶段：生产阶段
FROM alpine:latest AS production

# 安装必要工具
RUN apk add --no-cache \
    ca-certificates \
    tzdata \
    curl \
    && rm -rf /var/cache/apk/*

# 创建非root用户
RUN addgroup -g 1001 -S aiproject \
    && adduser -S aiproject -u 1001 -G aiproject

# 创建必要目录
RUN mkdir -p /app/logs /app/uploads /app/config \
    && chown -R aiproject:aiproject /app

# 从构建阶段复制二进制文件
COPY --from=builder --chown=aiproject:aiproject /app/ai-project-backend /app/

# 复制配置文件和静态资源
COPY --from=builder --chown=aiproject:aiproject /app/config /app/config
COPY --from=builder --chown=aiproject:aiproject /app/migrations /app/migrations
COPY --from=builder --chown=aiproject:aiproject /app/templates /app/templates

# 设置环境变量
ENV TZ=Asia/Shanghai \
    APP_ENV=production \
    APP_PORT=8000 \
    GIN_MODE=release

# 切换到非root用户
USER aiproject

# 健康检查
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:8000/api/v1/health || exit 1

# 暴露端口
EXPOSE 8000

# 设置工作目录
WORKDIR /app

# 运行应用
CMD ["./ai-project-backend"]