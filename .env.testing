# 测试环境配置 (Testing Environment)
# 用于集成测试和功能验证的配置

# 环境标识
ENV=testing
NODE_ENV=test

# 数据库配置 - 测试数据库
DB_HOST=localhost
DB_PORT=5433
DB_USER=test_user
DB_PASSWORD=test_password
DB_NAME=main_db
DB_SOURCE=postgresql://test_user:test_password@db:5433/test_db?sslmode=disable

# 后端服务配置
BACKEND_PORT=8080
JWT_SECRET=test-secret-key-for-testing-only
JWT_EXPIRATION=24h
GIN_MODE=test
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:3000,http://localhost:81

# 前端配置
FRONTEND_PORT=3000
REACT_APP_API_URL=http://localhost:8080
REACT_APP_API_BASE_URL=http://localhost:8080/api/v1
REACT_APP_ENV=testing
REACT_APP_ENVIRONMENT=testing
REACT_APP_ENABLE_MOCK=true

# Nginx代理配置
NGINX_PORT=81

# 测试工具配置
CHOKIDAR_USEPOLLING=false
GENERATE_SOURCEMAP=false
TSC_COMPILE_ON_ERROR=false
ESLINT_NO_DEV_ERRORS=false

# 安全密钥 (测试环境)
ENCRYPTION_KEY=test1234567890123456789012345678901234567890

# Google Calendar API配置 (测试环境)
GOOGLE_CLIENT_ID=your_test_google_client_id_here
GOOGLE_CLIENT_SECRET=your_test_google_client_secret_here
GOOGLE_PROJECT_ID=your_test_google_project_id_here
GOOGLE_REDIRECT_URL=http://localhost:8080/api/auth/google/callback
GOOGLE_CALENDAR_SCOPES=https://www.googleapis.com/auth/calendar

# 测试环境特定配置
DEBUG_MODE=false
ENABLE_DEV_TOOLS=false
HOT_RELOAD=false
MOCK_EXTERNAL_SERVICES=true
TEST_DATA_SEED=true
RESET_DB_ON_START=true