# 生产环境配置示例
# 复制此文件为 .env.production 并填写实际值

# 数据库配置
DB_USER=ai_project_user
DB_PASSWORD=your_secure_password_here
DB_NAME=ai_project_db

# JWT配置
JWT_SECRET=your_jwt_secret_key_here_min_32_chars

# 域名配置
DOMAIN_NAME=proj.joylodging.com

# MCP API Key
MCP_API_KEY=mcpsk_prod_your_api_key_here

# 可选：其他配置
# CORS_ORIGIN=https://proj.joylodging.com
# LOG_LEVEL=info
# GIN_MODE=release
