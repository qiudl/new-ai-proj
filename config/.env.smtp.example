# SMTP邮件配置示例
# 复制此文件为.env.smtp并填写实际配置

# SMTP服务器地址
SMTP_SERVER="smtp.exmail.qq.com"  # 腾讯企业邮箱
# SMTP_SERVER="smtp.qiye.aliyun.com"  # 阿里企业邮箱
# SMTP_SERVER="smtp.gmail.com"  # Gmail

# SMTP端口
# 465: SSL加密
# 587: TLS加密
SMTP_PORT="465"

# 发件人邮箱
SMTP_USER="ops@zhiyuncai.com"

# 邮箱密码或授权码
# 注意: 很多邮箱服务需要使用"授权码"而不是登录密码
SMTP_PASSWORD="your-password-or-authorization-code-here"

# 发件人名称
FROM_NAME="AI项目监控系统"
