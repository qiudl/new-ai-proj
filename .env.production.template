# 生产环境配置模板
# 复制此文件为 .env.production 并填入实际值

# ===========================================
# 数据库配置
# ===========================================
DB_USER=prod_user
DB_PASSWORD=your_secure_password_here
DB_NAME=prod_db
DB_HOST=db
DB_PORT=5432

# ===========================================
# 应用配置
# ===========================================
JWT_SECRET=your_very_secure_jwt_secret_here_minimum_32_characters
JWT_EXPIRATION=168h
GIN_MODE=release
LOG_LEVEL=info

# ===========================================
# 域名和SSL配置
# ===========================================
DOMAIN=your-domain.com
SSL_EMAIL=your-email@domain.com

# ===========================================
# 容器镜像配置
# ===========================================
BACKEND_IMAGE=ghcr.io/your-username/new-ai-proj/backend:latest
FRONTEND_IMAGE=ghcr.io/your-username/new-ai-proj/frontend:latest

# ===========================================
# 第三方服务配置
# ===========================================
# 腾讯云配置
TENCENT_CLOUD_SECRET_ID=your_secret_id
TENCENT_CLOUD_SECRET_KEY=your_secret_key

# 邮件服务配置（可选）
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your_app_password

# 对象存储配置（可选）
COS_BUCKET=your-bucket-name
COS_REGION=ap-beijing

# ===========================================
# 监控和通知配置
# ===========================================
# 钉钉机器人（可选）
DINGTALK_WEBHOOK=https://oapi.dingtalk.com/robot/send?access_token=your_token

# 企业微信机器人（可选）
WECHAT_WEBHOOK=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=your_key

# ===========================================
# 备份配置
# ===========================================
BACKUP_RETENTION_DAYS=30
BACKUP_SCHEDULE="0 2 * * *"

# ===========================================
# 安全配置
# ===========================================
# 允许的跨域源
CORS_ORIGINS=https://your-domain.com,https://www.your-domain.com

# 速率限制
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=900

# ===========================================
# 性能配置
# ===========================================
# 数据库连接池
DB_MAX_CONNECTIONS=20
DB_MAX_IDLE_CONNECTIONS=5

# Redis配置（如果使用）
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password