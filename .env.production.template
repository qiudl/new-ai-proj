# ========================================
# 统一计时器系统 - 生产环境配置模板
# ========================================
# 
# 使用说明:
# 1. 复制此文件为 .env.production
# 2. 根据实际环境修改各项配置值
# 3. 确保敏感信息（密码、密钥）的安全性
#

# ========================================
# 数据库配置
# ========================================

# PostgreSQL 数据库配置
DB_HOST=postgres
DB_PORT=5432
DB_USER=ai_project_user
DB_PASSWORD=CHANGE_THIS_STRONG_PASSWORD_123!
DB_NAME=ai_project_production
DB_SSL_MODE=prefer

# 数据库连接池配置
DB_MAX_CONNECTIONS=25
DB_MIN_CONNECTIONS=5
DB_MAX_IDLE_TIME=300s

# ========================================
# 应用安全配置
# ========================================

# JWT 配置 (生产环境必须更改!)
JWT_SECRET=CHANGE_THIS_VERY_SECURE_JWT_SECRET_KEY_FOR_PRODUCTION_USE_ONLY
JWT_EXPIRATION=168h

# 密码加密配置
BCRYPT_COST=12

# ========================================
# 后端服务配置
# ========================================

# Go 应用配置
GIN_MODE=release
LOG_LEVEL=info
SERVER_HOST=0.0.0.0
PORT=8080

# 性能配置
GOMAXPROCS=4
GOMEMLIMIT=1GiB

# ========================================
# 统一计时器配置
# ========================================

# 计时器核心配置
TIMER_MAX_CONCURRENT_SESSIONS=50
TIMER_AUTO_STOP_TIMEOUT=8h
TIMER_PAUSE_MAX_DURATION=24h
TIMER_POLLING_INTERVAL=30s

# 计时器数据保留策略
TIMER_LOG_RETENTION_DAYS=365
TIMER_SESSION_CLEANUP_INTERVAL=1h

# 智能推断配置
TIMER_AI_INFERENCE_ENABLED=true
TIMER_AI_CONFIDENCE_THRESHOLD=0.7
TIMER_AI_LEARNING_ENABLED=true

# ========================================
# 前端配置
# ========================================

# React 应用配置
REACT_APP_API_URL=/api/v1
REACT_APP_ENV=production
REACT_APP_VERSION=1.0.0

# 统一计时器前端配置
REACT_APP_TIMER_POLLING_INTERVAL=30000
REACT_APP_TIMER_LOCAL_SYNC_INTERVAL=1000
REACT_APP_TIMER_OFFLINE_MODE=true
REACT_APP_TIMER_NOTIFICATION_ENABLED=true

# PWA 配置
REACT_APP_PWA_ENABLED=true
REACT_APP_OFFLINE_CACHE_ENABLED=true

# ========================================
# Nginx 配置
# ========================================

# Nginx 性能配置
NGINX_WORKER_PROCESSES=auto
NGINX_WORKER_CONNECTIONS=1024
NGINX_CLIENT_MAX_BODY_SIZE=64m

# 安全配置
NGINX_RATE_LIMIT_REQUESTS=100
NGINX_RATE_LIMIT_WINDOW=60s

# ========================================
# SSL/TLS 配置
# ========================================

# SSL 证书路径
SSL_CERT_PATH=/etc/ssl/certs/your_domain.crt
SSL_KEY_PATH=/etc/ssl/private/your_domain.key
SSL_DHPARAM_PATH=/etc/ssl/certs/dhparam.pem

# SSL 安全配置
SSL_PROTOCOLS=TLSv1.2 TLSv1.3
SSL_CIPHERS=ECDHE-RSA-AES256-GCM-SHA512:DHE-RSA-AES256-GCM-SHA512

# ========================================
# Redis 缓存配置
# ========================================

# Redis 配置
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_THIS_REDIS_PASSWORD
REDIS_DB=0

# Redis 性能配置
REDIS_MAX_MEMORY=256mb
REDIS_MAX_MEMORY_POLICY=allkeys-lru
REDIS_PERSISTENCE=yes

# 统一计时器缓存配置
TIMER_CACHE_TTL=1800
TIMER_CACHE_PREFIX=unified_timer
TIMER_CACHE_ENABLED=true

# ========================================
# 监控和日志配置
# ========================================

# 日志配置
LOG_FORMAT=json
LOG_MAX_SIZE=10m
LOG_MAX_FILES=5
LOG_ROTATE_DAYS=30

# 健康检查配置
HEALTH_CHECK_INTERVAL=30s
HEALTH_CHECK_TIMEOUT=10s
HEALTH_CHECK_RETRIES=3

# 指标收集配置
METRICS_ENABLED=true
METRICS_ENDPOINT=/metrics
METRICS_RETENTION=7d

# ========================================
# 域名和网络配置
# ========================================

# 应用域名
APP_DOMAIN=yourdomain.com
APP_PROTOCOL=https

# CORS 配置
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
CORS_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_HEADERS=Content-Type,Authorization,X-Requested-With

# ========================================
# 备份配置
# ========================================

# 数据库备份配置
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_STORAGE_PATH=/app/backups

# ========================================
# 部署配置
# ========================================

# Docker 配置
COMPOSE_PROJECT_NAME=ai_project_prod
COMPOSE_FILE=docker-compose.prod.yml

# 重启策略
RESTART_POLICY=unless-stopped

# 资源限制
MEMORY_LIMIT_BACKEND=1g
MEMORY_LIMIT_FRONTEND=512m
MEMORY_LIMIT_DB=2g
MEMORY_LIMIT_REDIS=256m

# ========================================
# 安全配置检查清单
# ========================================
#
# ✅ 确认事项:
# [ ] JWT_SECRET 已更改为强密码
# [ ] DB_PASSWORD 已设置为强密码  
# [ ] REDIS_PASSWORD 已设置
# [ ] SSL 证书已配置
# [ ] CORS_ORIGINS 已设置正确域名
# [ ] 所有敏感信息未提交到版本控制
# [ ] 防火墙规则已配置
# [ ] 备份策略已实施
# [ ] 监控和日志已配置
#
# ========================================

# 注意事项:
# 1. 所有以 CHANGE_THIS 开头的值必须在生产环境中更改
# 2. 密码和密钥应该足够复杂且唯一
# 3. 定期轮换密码和密钥
# 4. 不要将敏感信息提交到版本控制系统
# 5. 使用 Docker secrets 或环境变量管理工具
# 6. 定期审查和更新安全配置