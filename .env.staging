# AI项目管理系统 - Staging环境配置
# 用于开发测试和预发布验证

# 环境标识
ENV=staging
NODE_ENV=staging
APP_ENV=staging

# 域名配置 (staging子域名或端口)
STAGING_DOMAIN_NAME=staging.152.136.104.251
# 或者使用端口: STAGING_DOMAIN_NAME=152.136.104.251:8080

# 数据库配置（staging环境独立数据库）
DB_HOST=postgres-staging
DB_PORT=5432
DB_USER=ai_staging_user
DB_PASSWORD=StagingAI2024!@#$
DB_NAME=ai_project_staging
DB_SSL_MODE=disable
DB_SOURCE=postgresql://ai_staging_user:StagingAI2024!@#$@postgres-staging:5432/ai_project_staging?sslmode=disable

# JWT配置（staging专用密钥）
JWT_SECRET=StagingJWTSecret2024!@#$%^&*()
JWT_EXPIRATION=24h

# 服务配置
BACKEND_PORT=8080
FRONTEND_PORT=80
GIN_MODE=debug  # staging环境启用debug模式
LOG_LEVEL=debug

# CORS配置
CORS_ORIGIN=https://staging.152.136.104.251

# SSL配置（可选，用于staging测试）
SSL_CERT_PATH=/etc/nginx/ssl/staging-cert.pem
SSL_KEY_PATH=/etc/nginx/ssl/staging-key.pem

# Redis配置
REDIS_URL=redis://redis-staging:6379

# MCP服务器配置
API_BASE_URL=http://backend-staging:8080/api/v1
TASK_API_BASE=http://backend-staging:8080/api/v1
MCP_ENABLE_PERMISSIONS=true
MCP_STRICT_PERMISSIONS=false  # staging环境稍微宽松
MCP_DEBUG_PERMISSIONS=true    # staging环境启用debug

# 安全配置
ENCRYPTION_KEY=StagingEncryptionKey2024!@#$%^&*()
SESSION_SECRET=StagingSessionSecret2024!@#$%^&*()

# 备份配置
BACKUP_SCHEDULE=0 3 * * *  # 每天凌晨3点备份
BACKUP_RETENTION_DAYS=7    # staging环境保留7天
BACKUP_DIR=/opt/backups/staging

# 监控配置
ENABLE_MONITORING=true
LOG_RETENTION_DAYS=30  # staging环境日志保留30天
METRICS_ENABLED=true

# 性能配置（staging环境适度放宽）
MAX_CONNECTIONS=50
CONNECTION_TIMEOUT=30s
RATE_LIMIT_REQUESTS=2000  # staging环境更宽松的限制
RATE_LIMIT_WINDOW=1h

# 文件上传配置
MAX_UPLOAD_SIZE=100MB  # staging环境允许更大文件
UPLOAD_DIR=/app/uploads

# 邮件配置（测试环境）
SMTP_HOST=smtp.qq.com
SMTP_PORT=587
SMTP_USER=staging_test@qq.com
SMTP_PASSWORD=staging_smtp_password
SMTP_FROM=staging-noreply@yourdomain.com

# 企业功能配置
FEATURE_SUPERADMIN_ENABLE=true
SUPER_ADMIN_USERNAMES=admin,staging_admin
SUPER_ADMIN_IDS=1,2

# 测试相关配置
ENABLE_TEST_DATA=true
TEST_USER_ENABLED=true
MOCK_EXTERNAL_APIS=true

# 开发工具配置
ENABLE_HOT_RELOAD=false
ENABLE_SOURCE_MAPS=true
ENABLE_PROFILING=true

# Google集成（测试环境）
GOOGLE_CLIENT_ID=staging_google_client_id
GOOGLE_CLIENT_SECRET=staging_google_client_secret
GOOGLE_PROJECT_ID=staging_google_project_id
GOOGLE_REDIRECT_URL=https://staging.152.136.104.251/auth/google/callback

# 第三方服务（测试环境）
SENTRY_DSN=staging_sentry_dsn
ANALYTICS_ID=staging_analytics_id

# 数据库连接池配置
DB_MAX_OPEN_CONNS=15
DB_MAX_IDLE_CONNS=3
DB_CONN_MAX_LIFETIME=5m

# 缓存配置
CACHE_TTL=30m  # staging环境较短的缓存时间
CACHE_MAX_SIZE=50MB

# 特殊功能开关
FEATURE_EXPERIMENTAL=true    # staging环境启用实验性功能
FEATURE_DEBUG_API=true       # 启用debug API
FEATURE_ADMIN_TOOLS=true     # 启用管理工具

# 清除所有代理设置
HTTP_PROXY=""
HTTPS_PROXY=""
http_proxy=""
https_proxy=""
ALL_PROXY=""
all_proxy=""