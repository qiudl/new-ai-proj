pipeline {
  agent {
    docker {
      // 使用 Docker Agent（遵循你的偏好）
      image 'node:22-alpine'
      // Jenkins Docker Agent 会自动挂载工作空间，通常无需额外 args
    }
  }
  options {
    timestamps()
    ansiColor('xterm')
  }
  parameters {
    string(name: 'WS_BRIDGE', defaultValue: 'http://host.docker.internal:3035', description: 'WS Bridge 基础地址（桥接模式 /update 接口）')
    string(name: 'WS_UPDATE_TOKEN', defaultValue: '', description: '可选：/update 的 Bearer Token（留空则不带鉴权头）')
  }
  environment {
    WS_BRIDGE = "${params.WS_BRIDGE}"
    WS_UPDATE_TOKEN = "${params.WS_UPDATE_TOKEN}"
  }
  stages {
    stage('Init') {
      steps {
        sh '''#!/bin/sh
        set -e
        apk add --no-cache curl bash >/dev/null
        bash scripts/report_update.sh 535 5 PIPELINE_INIT "Pipeline started"
        '''
      }
    }

    stage('Backend Build') {
      steps {
        sh '''#!/bin/sh
        set -e
        bash scripts/report_update.sh 535-backend 25 BUILDING "Go backend 构建触发"
        # 你的真实构建命令放在这里，例如：
        # go build ./...
        bash scripts/report_update.sh 535-backend 45 BUILDING "编译完成，准备单测"
        '''
      }
    }

    stage('Frontend Build') {
      steps {
        sh '''#!/bin/sh
        set -e
        bash scripts/report_update.sh 535-frontend 20 REAL_UI_BUILD "前端依赖安装"
        # npm ci && npm run build
        bash scripts/report_update.sh 535-frontend 40 REAL_UI_BUILD "打包完成"
        '''
      }
    }

    stage('DevOps Pipeline') {
      steps {
        sh '''#!/bin/sh
        set -e
        bash scripts/report_update.sh 535-devops 15 REAL_PIPELINE "Jenkins (Docker Agent) 准备中"
        # 这里可以触发 CI/CD、制品推送等
        bash scripts/report_update.sh 535-devops 35 REAL_PIPELINE "流水线步进中"
        '''
      }
    }

    stage('Unit Tests') {
      steps {
        sh '''#!/bin/sh
        set -e
        bash scripts/report_update.sh 535-qa 30 RUN_TESTS "启动测试"
        # go test ./... 或前端测试
        bash scripts/report_update.sh 535-qa 55 RUN_TESTS "测试运行中"
        bash scripts/report_update.sh 535-qa 80 RUN_TESTS "测试通过"
        '''
      }
    }

    stage('Migrations (Report only)') {
      steps {
        sh '''#!/bin/sh
        set -e
        # 注意：若你的 Agent 能访问 docker（挂载了 /var/run/docker.sock），可改用 scripts/db_migrate_postgres.sh 执行真实迁移
        # bash scripts/db_migrate_postgres.sh
        bash scripts/report_update.sh 535-dba 60 MIGRATING "准备执行迁移（Docker Postgres）"
        bash scripts/report_update.sh 535-dba 85 MIGRATING "迁移执行中"
        '''
      }
    }
  }
  post {
    always {
      sh '''#!/bin/sh
      set -e
      bash scripts/report_update.sh 535 100 COMPLETED "流水线已结束"
      '''
    }
  }
}

