# MCP Task Bridge - Development Dockerfile
# Use Node 20 to satisfy modern engines (e.g. eventsource-parser >=20)
FROM node:20-alpine AS base

# Create non-root user
RUN addgroup -g 1001 -S nodegroup && adduser -u 1001 -S nodeuser -G nodegroup

WORKDIR /app

# Copy package manifests first for dependency install
COPY package*.json ./

# Install dependencies (no lockfile strictness for dev)
RUN npm install --no-audit --no-fund && npm cache clean --force

# Copy source (for initial image; in compose we will mount volume)
COPY . .

# Ensure permissions
RUN chown -R nodeuser:nodegroup /app

USER nodeuser

ENV NODE_ENV=development

# Default command: tsx watch (package.json)
CMD ["npm", "run", "dev"]

