# MCP Task Bridge - Production Configuration (SSE Mode)

# API基础地址 - Docker内部使用服务名
TASK_API_BASE=http://new-ai-proj-backend:8080/api/v1

# SSE服务端口
MCP_PORT=3000

# 环境
NODE_ENV=production

# MCP权限系统配置
MCP_ENABLE_PERMISSIONS=false
MCP_STRICT_PERMISSIONS=false
MCP_DEBUG_PERMISSIONS=false

# 开发登录用户（通过dev_quick_login自动刷新token）
DEV_LOGIN_USERNAME=admin
