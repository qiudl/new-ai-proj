# MCP权限管理配置示例
# 复制此文件为 .env 并根据需要修改配置

# === 基础配置 ===
# API基础地址
TASK_API_BASE=http://localhost:8080/api/v1

# API认证令牌（必填）
TASK_API_TOKEN=your-jwt-token-here

# === MCP权限系统配置 ===

# 是否启用权限检查
# true: 启用权限检查（推荐生产环境）
# false: 禁用权限检查（开发测试环境）
MCP_ENABLE_PERMISSIONS=true

# 是否启用权限缓存
# true: 启用缓存（提升性能）
# false: 禁用缓存（每次都重新检查）
MCP_CACHE_PERMISSIONS=true

# 权限缓存时间（秒）
# 推荐值：300（5分钟）
# 范围：60-3600
MCP_PERMISSION_CACHE_TTL=300

# 严格模式
# true: 权限检查失败时拒绝访问（生产环境推荐）
# false: 权限检查失败时允许访问（向后兼容，开发环境推荐）
MCP_STRICT_PERMISSIONS=false

# 调试模式
# true: 输出详细的权限检查日志
# false: 关闭调试日志（生产环境推荐）
MCP_DEBUG_PERMISSIONS=true

# === 环境配置建议 ===

# 开发环境配置:
# MCP_ENABLE_PERMISSIONS=false
# MCP_STRICT_PERMISSIONS=false  
# MCP_DEBUG_PERMISSIONS=true

# 测试环境配置:
# MCP_ENABLE_PERMISSIONS=true
# MCP_STRICT_PERMISSIONS=false
# MCP_DEBUG_PERMISSIONS=true

# 生产环境配置:
# MCP_ENABLE_PERMISSIONS=true
# MCP_STRICT_PERMISSIONS=true
# MCP_DEBUG_PERMISSIONS=false

# === 权限说明 ===
# 权限系统支持以下权限类别:
# 
# 任务管理权限:
# - task.create: 创建任务
# - task.read: 查看任务详情  
# - task.update: 更新任务
# - task.delete: 删除任务
# - task.list.read: 查看任务列表
#
# 项目管理权限:
# - project.create: 创建项目
# - project.list.read: 查看项目列表
#
# 文档管理权限:
# - document.create: 创建文档
# - document.read: 查看文档
# - document.delete: 删除文档
#
# 工作笔记权限:
# - worknote.create: 创建工作笔记
# - worknote.read: 查看工作笔记
# - worknote.update: 更新工作笔记
# - worknote.list.read: 查看工作笔记列表
#
# 时间管理权限:
# - timer.create: 开始计时
# - timer.read: 查看计时状态
# - timer.update: 停止计时
#
# 报告权限:
# - report.read: 查看报告
#
# 认证权限:
# - auth.dev_login: 开发环境快速登录
