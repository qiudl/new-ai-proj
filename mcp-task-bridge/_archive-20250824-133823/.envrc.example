# Multi-AI Development Environment Variables
# Copy this to .envrc and configure your settings
# Run 'direnv allow' after creating .envrc

# AI Configuration
export AI_BACKEND="openai"                    # openai|anthropic|ollama|litellm
export AI_MODEL="gpt-4o-mini"                # Model name for your backend
export AI_TEMPERATURE="0.7"                  # Temperature (0.0-1.0)
export AI_MAX_TOKENS="2048"                  # Max tokens per response

# API Keys (set these to your actual keys)
# SECURITY NOTE: These are placeholders - replace with actual values
export OPENAI_API_KEY="{{OPENAI_API_KEY}}"           # Your OpenAI API key
export ANTHROPIC_API_KEY="{{ANTHROPIC_API_KEY}}"     # Your Anthropic API key

# Session Configuration
export TMUX_SESSION="ai-dev"                 # Default tmux session name
export LOG_DIR="logs"                        # Log directory (relative to project)

# Optional: PostgreSQL Configuration (if using persistence)
export ENABLE_POSTGRES="false"               # Set to "true" to enable
export PGHOST="localhost"                    # PostgreSQL host
export PGPORT="5432"                         # PostgreSQL port
export PGUSER="ai"                           # PostgreSQL username
export PGPASSWORD="{{PGPASSWORD}}"           # PostgreSQL password
export PGDATABASE="ai_multi"                 # PostgreSQL database name

# Optional: LiteLLM Configuration (if using litellm backend)
export LITELLM_API_BASE="http://localhost:4000"  # LiteLLM server URL
export LITELLM_API_KEY="{{LITELLM_API_KEY}}"     # LiteLLM API key (if required)

# Optional: Ollama Configuration (if using ollama backend)
export OLLAMA_HOST="http://localhost:11434"  # Ollama server URL

# Project-specific settings
export PROJECT_ROOT="$(pwd)"                 # Project root directory
export PYTHON_PATH="${PROJECT_ROOT}:${PYTHON_PATH:-}"

# Development settings
export DEBUG="false"                         # Enable debug mode
export VERBOSE="false"                       # Enable verbose logging

# Custom groups configuration file
export TMUX_GROUPS_FILE="${PROJECT_ROOT}/.tmux-groups"

# MCP Task Bridge settings
export MCP_BRIDGE_URL="http://localhost:3001"    # MCP bridge server URL
export TASK_PROJECT_ID="1"                       # Default project ID for tasks

# Optional: Jenkins integration (if using CI/CD)
export JENKINS_URL="{{JENKINS_URL}}"             # Jenkins server URL
export JENKINS_TOKEN="{{JENKINS_TOKEN}}"         # Jenkins API token
export JENKINS_USER="{{JENKINS_USER}}"           # Jenkins username

echo "✅ Multi-AI development environment loaded"
echo "🔧 Backend: $AI_BACKEND | Model: $AI_MODEL | Session: $TMUX_SESSION"
