# Task API configuration (example)
# Copy to .env and set actual values or export in your shell before running scripts.

TASK_API_BASE=http://localhost:8080/api/v1
# Provide a JWT or token with sufficient permissions. Do not commit real secrets.
TASK_API_TOKEN={{YOUR_TASK_API_TOKEN}}
# Optional dev quick login username (when backend APP_ENV=development)
DEV_LOGIN_USERNAME=admin
