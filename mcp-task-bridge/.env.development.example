# Database Configuration
DATABASE_URL=postgresql://taskuser:taskpass@localhost:5432/taskdb
TEST_DATABASE_URL=postgresql://taskuser:taskpass@localhost:5433/taskdb_test

# Feature Flags
FEATURE_FLAG_TASK_VERSIONING=true

# Versioning Configuration
MAX_VERSIONS_PER_TASK=100
VERSION_HISTORY_PAGE_SIZE=20

# API Configuration
API_PORT=3000
API_HOST=localhost

# Jenkins Configuration (Docker-based agent)
JENKINS_DOCKER_IMAGE=jenkins/jenkins:lts
JENKINS_AGENT_IMAGE=jenkins/inbound-agent
