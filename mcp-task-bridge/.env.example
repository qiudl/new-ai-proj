# MCP Task Bridge 配置示例
# Copy this file to .env and update with your actual values

# API基础地址 - 指向本地运行的后端服务
TASK_API_BASE=http://localhost:8080/api/v1

# 开发登录用户（Claude Code专用）
# 设置此变量可以让MCP Bridge使用指定用户身份而不是默认的admin
DEV_LOGIN_USERNAME=your_username_here

# API认证令牌（如果需要的话）
# 注意：Token会自动持久化到 ~/.mcp-task-bridge/token-storage.enc
TASK_API_TOKEN=your_jwt_token_here

# Token持久化和加密配置
# 是否启用Token加密存储（默认：true）
MCP_TOKEN_ENCRYPTION=true

# Token加密密钥（可选，不设置会自动生成并保存到 ~/.mcp-task-bridge/.encryption-key）
# 格式：64个十六进制字符（32字节）
# MCP_TOKEN_ENCRYPTION_KEY=your_64_hex_char_encryption_key_here

# Token监控配置
# 是否启用Token刷新日志（默认：true）
MCP_TOKEN_MONITOR_LOGGING=true

# 是否启用Token刷新指标统计（默认：true）
MCP_TOKEN_MONITOR_METRICS=true

# 环境
NODE_ENV=development
