# MCP Task Bridge 配置示例
# Copy this file to .env and update with your actual values

# API基础地址 - 指向本地运行的后端服务
TASK_API_BASE=http://localhost:8080/api/v1

# 开发登录用户（Claude Code专用）
# 设置此变量可以让MCP Bridge使用指定用户身份而不是默认的admin
DEV_LOGIN_USERNAME=your_username_here

# API认证令牌（如果需要的话）
TASK_API_TOKEN=your_jwt_token_here

# 环境
NODE_ENV=development
